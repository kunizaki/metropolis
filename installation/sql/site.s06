('1995', 'A8177', 'Jd. Aquarius- Apto de 153 m2 com 3 quartos(3 suites), ampla sacada, lavabo, coz.plan, 3 vgs garagem', 'xa8177', '1', '1', '', '<p><span style=\"font-size: 13.68px;\">O apto no Parque Residencial Aquarius possui 153 m2 com:</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- 3 suítes espaçosas, 2 com armários planejados</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- cozinha planejada de alta qualidade</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- área de Serviço com armários planejados</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- sacada ampla também com armários planejados</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- sol o dia todo: (Quartos/Cozinha - Nascente e Sala/Suíte - Poente)</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- 3 vagas cobertas no subsolo.</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- sala fitness</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- playground</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- salão de festas</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- piscina</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- churrasqueira</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- aceita financiamento</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- sem permutas</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/A8177 1.jpg\",\"alt_text\":\"A8177 1.jpg\"},\"gallery10\":{\"photo\":\"images/gallery/A8177 10.jpg\",\"alt_text\":\"A8177 10.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/A8177 2.jpg\",\"alt_text\":\"A8177 2.jpg\"},\"gallery4\":{\"photo\":\"images/gallery/A8177 4.jpg\",\"alt_text\":\"A8177 4.jpg\"},\"gallery16\":{\"photo\":\"images/gallery/A8177 16.jpg\",\"alt_text\":\"A8177 16.jpg\"},\"gallery15\":{\"photo\":\"images/gallery/A8177 15.jpg\",\"alt_text\":\"A8177 15.jpg\"},\"gallery14\":{\"photo\":\"images/gallery/A8177 14.jpg\",\"alt_text\":\"A8177 14.jpg\"},\"gallery18\":{\"photo\":\"images/gallery/A8177