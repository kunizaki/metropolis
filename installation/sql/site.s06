('2056', 'A8218', 'Jd. Paulista- Apto 82 m2 / 3 quartos(STE)+ armários, coz.plan, varanda gourmet, 2 vgs, lazer', 'xa8218', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">O apto no Jd. Paulista/Vila Cardoso tem 82 m2 com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 3 quartos sendo 1 suite, todos com armários</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- cozinha planejada</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sala com varanda gourmet</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 banheiros com box/gabinete</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- duas vagas de garagem</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- academia</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- playground</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- salão de festas</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- piscina</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- churrasqueira</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- elevador</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- janelas com fechamento de vidro e tela protetora</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- documentação ok</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- habite-se ok</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- aceita financiamento  Bancário ou da Cef</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- não aceita permuta</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Condomínio: R$500,00</span></p>\r\n<p><span style=\"font-size: 12.16px;\">IPTU: R$1100,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A8218 6.jpg\",\"alt_text\":\"A8218 6.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/A8218 1.jpg\",\"alt_text\":\"A8218 1.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/A8218 2.jpg\",\"alt_text\":\"A8218 2.jpg\"},\"gallery14\":{\"photo\":\"images\\/gallery\\/A8218 10.jpg\",\"alt_text\":\"A8218 10.jpg\"},\"gallery4\":{\