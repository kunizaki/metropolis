('1962', 'A8165', 'Centro/Patamares- 65 m2 com 2 quartos+armários, coz.plan, banh de serviço, 1 vg garagem', 'xa8165', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">O apto no Cond Patamares tem 65 m2 com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 quartos com armários</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- banheiro social reformado com box</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- cozinha planejada com gabinete</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- banheiro de serviço</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 1 vaga coberta de garagem</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- salão de festas</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- churrasqueira</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- academia</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- elevador<br /><br />Condomínio R$500,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/A8165 1.jpg\",\"alt_text\":\"A8165 1.jpg\"},\"gallery13\":{\"photo\":\"images/gallery/A8165 13.jpg\",\"alt_text\":\"A8165 13.jpg\"},\"gallery10\":{\"photo\":\"images/gallery/A8165 10.jpg\",\"alt_text\":\"A8165 10.jpg\"},\"gallery12\":{\"photo\":\"images/gallery/A8165 12.jpg\",\"alt_text\":\"A8165 12.jpg\"},\"gallery8\":{\"photo\":\"images/gallery/A8165 8.jpg\",\"alt_text\":\"A8165 8.jpg\"},\"gallery7\":{\"photo\":\"images/gallery/A8165 7.jpg\",\"alt_text\":\"A8165 7.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/A8165 2.jpg\",\"alt_text\":\"A8165 2.jpg\"},\"gallery3\":{\"photo\":\"images/gallery/A8165 3.jpg\",\"alt_text\":\"A8165 3.jpg\"},\"gallery4\":{\"photo\":\"images/gallery/A8165 4.jpg\",\"alt_text\":\"A8165 4.jpg\"},\"gallery6\":{\"photo\":\"images/gallery/A8165 6.jpg\",\"alt_text\":\"A8165 6.jpg\"},\"gallery9\":{\"photo\":\"images/gallery/A8165 9.jpg\",\"alt_text\":\"A8165 9.jpg\"},\"gallery11\":{\"photo\":\"images/gallery/A8165 11.jpg\",\"alt_text\":\"A8165 11.jpg\"},\"gallery5\":{\"