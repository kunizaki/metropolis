('1987', 'C3676', 'Cond. Aruanã/ Floresta-Sobrado 273 m2 com 4 quartos(4 suites), piscina, churrasqueira, 4 vgs garagem', 'ca3676', '7', '1', '', '<p><span style=\"font-size: 13.68px;\">Descrição do Sobrado novo no Condomínio Aruanã:</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- 280m terreno 273m construído de casa</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- piscina com equipamentos Sodramar</span></p>\r\n<p><span style=\"font-size: 13.68px;\">-iluminação em Led c/ controle remoto</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- casa em L 4 suítes sendo 1 master com closet</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- 6 banheiros</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- despensa</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- hobby Box</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- sala para 2 ambientes</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- cozinha com ilha</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- janelas automáticas todos os quartos Esquadrias diferenciadas no seu tamanho</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- área gourmet com ponto de gás</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- infra ar condicionado em todos os quartos</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- pé direito dos Quartos mais 3 metros</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- pé direito da sala 3,30 metros com área técnica em separado para as máquinas de ar condicionado</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- infra de Áudio, vídeo e internet nos quarto, sala e área gourmet</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- preparação Fotovoltaico Infra para Estação de Carregamento para carro elétrico na Garagem</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- infra Aquecimento para piscina</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- garagem bem generosa até 4 carros<br /><br />Condominio R$380,00       IPTU R$2.000,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/C3676 1.jpg\",\"alt_text\":\"C3676 1.jpg\"},\"gallery15\":{\"photo\":\"images\\/gallery\\/C3676 15.jpg\",\"alt_text\":\"C3676 15.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/C3676 2.jpg\",\"alt_text\":\"C3676 2.jpg\"},\"gallery16\":{\"photo\":\"images\\/gallery\\/C3676 16.jpg\",\"alt_text\":\"C3676 16.jpg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/C3676 13.jpg\",\"alt_text\":\"C3676 13.jpg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/C3676 12.jpg\",\"alt_text\":\"C3676 12.jpg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/C3676 9.jpg\",\"alt_text\":\"C3676 9.jpg\"},\"gallery14\":{\"photo\":\"images\\/gallery\\/C3676 14.jpg\",\"alt_text\":\"C3676 14.jpg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/C3676 11.jpg\",\"alt_text\":\"C3676 11.jpg\"},\"gallery17\":{\"photo\":\"images\\/gallery\\/C3676 17.jpg\",\"alt_text\":\"C3676 17.jpg\"},\"gallery18\":{\"photo\":\"images\\/gallery\\/C3676 18.jpg\",\"alt_text\":\"C3676 18.jpg\"},\"gallery20\":{\"photo\":\"images\\/gallery\\/C3676 20.jpg\",\"alt_text\":\"C3676 20.jpg\"},\"gallery19\":{\"photo\":\"images\\/gallery\\/C3676 19.jpg\",\"alt_text\":\"C3676 19.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/C3676 5.jpg\",\"alt_text\":\"C3676 5.jpg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/C3676 10.jpg\",\"alt_text\":\"C3676 10.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/C3676 8.jpg\",\"alt_text\":\"C3676 8.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/C3676 6.jpg\",\"alt_text\":\"C3676 6.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/C3676 7.jpg\",\"alt_text\":\"C3676 7.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/C3676 4.jpg\",\"alt_text\":\"C3676 4.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/C3676 3.jpg\",\"alt_text\":\"C3676 3.jpg\"}}', 'sell', '', '2000000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Loteamento Floresta', '-23.222612,-45.829493', '12226-358',