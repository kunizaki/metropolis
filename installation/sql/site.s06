('2028', 'C3704', 'Cond. Res. Mantiqueira- Casa Nova Ac 250m2 e At 1.036 m2 com 3 quartos(suite) com armários embutidos, 3 vgs', 'xc3704', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">- Condominio Residencial Mantiqueira</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Casa térrea nova de tres quartos (1 suite) com armários embutidos</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sala/cozinha e quartos preparados para ar condicionado</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Area total construida 250m2 ( 120m2 com laje e 130 m2 varandas e garagem)</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Área do lote de 1.036m2</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Piso em porcelanato</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Não tem escadas (incluindo o acesso a casa).</span></p>\r\n<p><span style=\"font-size: 12.16px;\">IPTU: R$3000,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/C3704 1.jpg\",\"alt_text\":\"C3704 1.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/C3704 2.jpg\",\"alt_text\":\"C3704 2.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/C3704 35.jpg\",\"alt_text\":\"C3704 35.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/C3704 7.jpg\",\"alt_text\":\"C3704 7.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/C3704 6.jpg\",\"alt_text\":\"C3704 6.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/C3704 4.jpg\",\"alt_text\":\"C3704 4.jpg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/C3704 11.jpg\",\"alt_text\":\"C3704 11.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/C3704 3.jpg\",\"alt_text\":\"C3704 3.jpg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/C3704 9.jpg\",\"alt_text\":\"C3704 9.jpg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/C3704 10.jpg\",\"alt_text\":\"C3704 10.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/C3704 5.jpg\",\"alt_text\":\"C3704 5.jpg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/C3704 8.jpg\",\"alt_tex