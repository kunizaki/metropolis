('2061', 'A8220', 'Pq Industrial- Apto NOVO de 63 m2 com 2 quartos(suite), sacada, 1 vg garagem', 'xa8220', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">O Apto novo no Parque Industrial tem 63 m2 com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Entrega das chaves em maio/25</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Garagem uma vaga no subsolo</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Torre única com 11 andares</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Quatro apartamentos por andar</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Área de 63,09m2</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 02 dormitórios sendo 01 suíte</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Infraestrutura para ar condicionado na sala e na suíte</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Varanda gourmet com churrasqueira à carvão</span></p>\r\n<p><span style=\"font-size: 12.16px;\">-  Salão de festas</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Salão de jogos</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Academia</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Coworking, ideal para quem procura praticidade no home office</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sol da manhã</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Localização privilegiada próximo ao anel viário, MC Donalds, padaria Flor de Ipê</span></p>\r\n<p> </p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/A8220.jpg\",\"alt_text\":\"A8220.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/A8220A.jpg\",\"alt_text\":\"A8220A.jpg\"}}', 'sell', '', '520000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José Dos Campos/SP', 'Parque Industrial', '0,0', '12235-580', '63', '2', '2', '1', '', '0', '[\"8\",\"16\",\"20\",\"21\",\"22\",\"27\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2025-04-15 00:00:00', '783', '2025-04-15 1