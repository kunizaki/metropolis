('2041', 'C3687', 'Jd. dos Bandeirantes- casa nova de 60 m2 com 2 quartos(suite), portão automático, 2 vgs garagem', 'xc3687', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">A casa Nova no Jardim dos Bandeirantes possui 60 m2 com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- dois quartos, sendo uma suite,</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- cozinha e sala de jantar integradas,</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sala de estar separada,</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- ampla área lazer nos fundos, com vista, </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- garagem para dois carros, </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- portão eletrônico, </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- rua sem saída, </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- bairro tranquilo, </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- próximo a área verde, </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- ótima localização na zona Sul de São José dos Campos.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- bairro próximo a Mercado, Escolas, Padaria, região em constante crescimento e valorização!</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- casa novíssima, nunca habitada!</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- aceita carro como parte do pagamento, (Sob Avaliação);</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- aceita financiamento imobiliário, aceita uso de FGTS;</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- área Construída 60m2;</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- área do Terreno 149,5m2;</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/C3687 15.jpg\",\"alt_text\":\"C3687 15.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/C3687 13.jpg\",\"alt_text\":\"C3687 13.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/C3687 14.jpg\",\"alt_text\":\"C3687 14.jpg\"},\"galle