('2092', 'A8238', 'Bosque dos Eucaliptos- Apto 48 m2 com 2 quartos, armários, coz.planejada, 1 vg garagem e lazer compl', 'xa8238', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">O apto no Bosque dos Eucaliptos tem 48 m2 com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 quartos com armários</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sala</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- cozinha planejada</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 1 banheiro com box</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- academia</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- espaço gourmet</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- área de recreação infantil</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- salão de festas</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- piscina</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- quadra poliesportiva</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- churrasqueira</span></p>\r\n<p>Condomínio: R$300,00</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/A8238 9.jpg\",\"alt_text\":\"A8238 9.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/A8238 1.jpg\",\"alt_text\":\"A8238 1.jpg\"},\"gallery3\":{\"photo\":\"images/gallery/A8238 4.jpg\",\"alt_text\":\"A8238 4.jpg\"},\"gallery4\":{\"photo\":\"images/gallery/A8238 2.jpg\",\"alt_text\":\"A8238 2.jpg\"},\"gallery5\":{\"photo\":\"images/gallery/A8238 3.jpg\",\"alt_text\":\"A8238 3.jpg\"},\"gallery8\":{\"photo\":\"images/gallery/A8238 7.jpg\",\"alt_text\":\"A8238 7.jpg\"},\"gallery6\":{\"photo\":\"images/gallery/A8238 5.jpg\",\"alt_text\":\"A8238 5.jpg\"},\"gallery7\":{\"photo\":\"images/gallery/A8238 6.jpg\",\"alt_text\":\"A8238 6.jpg\"},\"gallery9\":{\"photo\":\"images/gallery/A8238 8.jpg\",\"alt_text\":\"A8238 8.jpg\"},\"gallery12\":{\"photo\":\"images/gallery/A8238 11.jpg\",\"alt_text\":\"A8238 11.jpg\"},\"gallery10\":{\"photo\":\"images/gallery/A8238 9.jpg\",\"alt_text\":\"A