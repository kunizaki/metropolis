('2156', 'A8273', 'Jardim Oriente- Apto à venda, 61 m2, 2 quartos (1st), 2 banh, 2 vgs grg, sala, coz, vrnd goumt', 'xa8273', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">O apartamento está localizado no bairro Jardim Oriente com 61 m2 com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 quartos sendo 1 suite</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 banheiros</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 vagas de garagem</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- cozinha</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sala com 2 ambientes</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sol da manhã </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- varanda gourmet</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Condomínio:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- academia</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- playground</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- salão de festas</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- churrasqueira</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- elevador</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- hobby box</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Localizado próximo a comércios, escolas, shoppings, supermercados, lojas de conveniência, além de ter fácil acesso às principais vias de acesso da cidade.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Condomínio: R$500,00</span></p>\r\n<p><span style=\"font-size: 12.16px;\">IPTU: R$1000,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/A8273 0.jpg\",\"alt_text\":\"A8273 0.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/A8273 1.jpeg\",\"alt_text\":\"A8273 1.jpeg\"},\"gallery3\":{\"photo\":\"images/gallery/A8273 2.jpeg\",\"alt_text\":\"A8273 2.jpeg\"},\"gallery4\":{\"photo\":\"images/gallery/A8273 3.jpeg\",\"alt_text\":\"A8273 3.jpeg\"},\"gallery5\":{\"photo\":\"images/gallery/A8273 4.jpeg\",\"a