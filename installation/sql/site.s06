('2026', 'A8205', 'Jd. Satélite- apto 63 m2 com 2 quartos(ste)+armários, sacada gourmet, coz.plan, 1 vg, próx. Valesul', 'xa8205', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">O Apto no Jardim Satélite possui 63 m2 com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 Dormitórios sendo um com suíte</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sala</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- cozinha</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- dois Banheiros</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- ⁠varanda Gourmet com vista da cidade. </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- área de serviços</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- vaga de garagem com Homebox </span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">Diferenciais Exclusivos:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sacada gourmet</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- ⁠andar alto </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- ponto de Ar condicionado  </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- chuveiros com aquecimento a gás</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- hobby Box na garagem </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- gozinha completa com planejado, integrada com varanda gourmet </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- ⁠quarto com closet planejado </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- ⁠cozinha com forno em cook top instalado </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- ⁠banheiros com planejado instalado </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- janela tipo persiana com iluminação</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- dois Elevadores</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- piso cerâmica nas áreas úmidas</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sol da tarde</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- torre única</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- ⁠vista panorâmica </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- mais de 1.000m2 de área de lazer</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- piscina adulto e infantil</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- salão de jogos</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- salão de festas</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- academia</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- playground</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- brinquedoteca</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- churrasqueira</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- forno para pizza</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- ⁠hidromassagem </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sauna</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sauna úmida</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sala de descanso</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- ⁠portaria 24 horas</span></p>\r\n<p>Condomínio: R$514,00</p>\r\n<p>IPTU: R$550,00</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/A8205 1.jpg\",\"alt_text\":\"A8205 1.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/A8205 2.jpg\",\"alt_text\":\"A8205 2.jpg\"},\"gallery18\":{\"photo\":\"images/gallery/A8205 12.jpg\",\"alt_text\":\"A8205 12.jpg\"},\"gallery19\":{\"photo\":\"images/gallery/A8205 13.jpg\",\"alt_text\":\"A8205 13.jpg\"},\"gallery8\":{\"photo\":\"images/gallery/A8205 30.jpg\",\"alt_text\":\"A8205 30.jpg\"},\"gallery6\":{\"photo\":\"images/gallery/A8205 28.jpg\",\"alt_text\":\"A8205 28.jpg\"},\"gallery7\":{\"photo\":\"images/gallery/A8205 29.jpg\",\"alt_text\":\"A8205 29.jpg\"},\"gallery3\":{\"photo\":\"images/gallery/A8205 25.jpg\",\"alt_text\":\"A8205 25.jpg\"},\"gallery13\":{\"photo\":\"images/gallery/A8205 7.jpg\",\"alt_text\":\"A8205 7.jpg\"},\"gallery9\":