('2020', 'C3686', 'Altos da Vila Paiva-casa de 99 m2 com 2 quartos(suite), coz.planejada, 2 vgs garagem', 'xc3686', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">Casa no Altos da Vila Paiva, de 99m2 com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 quartos sendo uma suite</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- cozinha planejada</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- garagem coberta para 2 carros</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- piso antiderrapante e portão automático em metalon</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sala 2 ambientes com porcelanato retificado</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- painel de TV e balcão de granito preto</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- cozinha americana com armários aéreos</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- pia em inox</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- bancada em granito preto</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- porta de correr em alumínio branco com vidro fumê</span></p>\r\n<p><span style=\"font-size: 12.16px;\">. suíte com acabamento moderno</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- banheiro com box em vidro fumê</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- cuba em granito amarelo ornamental e vaso branco</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- banheiro social com design elegante e os mesmos acabamentos de qualidade</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- área de serviço coberta, com tanque de louça, piso antiderrapante e azulejo branco</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- corredor lateral com porta de madeira para maior privacidade</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/930575368264387.jpg\",\"alt_text\":\"930575368264387.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/921556727202678.jpg\",\"alt_text\":\"921556727202678.jpg\"},\"gallery3\":{\"