('2057', 'C3714', 'Eugenio de Melo- Cond. Terra Nova- Casa 70 m2 com 3 quartos(ste), arms, coz.plan, churra, 2 vgs', 'xc3714', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">- Casa linda e aconchegante recentemente reformada</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 140m2 de terreno </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 70m2 de área construída</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- moveis planejados em todos os cômodos </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- pedras em Granito Preto São Gabriel </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 3 dormitorios (sendo 1 suite com closet e ar condicionado </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- dormitório 2 com bancada para ser usada como escritório e ar condicionado </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sala 2 ambientes com ar-condicionado, bar e aquário </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- escritório </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- banheiro Social </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- cozinha com pia ampla, coifa inox e fogão embutido inox Brastemp Active! </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- área de serviço coberta e isolada da casa </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- linda área gourmet de 35m2 com churrasqueira, balcão em granito e pergolado </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- garagem para 2 carros </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- rua sem saída com baixo fluxo de veículos </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- em frente a área verde </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 15 vagas para visitantes em frente a casa </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- mini mercado auto serviço </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- piscina adulto e infantil </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- salão de festas </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- quiosques com churrasqueiras </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- playground </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- campo de futebol </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- quadra de areia </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- portaria e segurança 24h</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Condomínio: R$350,00</span></p>\r\n<p><span style=\"font-size: 12.16px;\">IPTU:465,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/C3814 1.jpg\",\"alt_text\":\"C3814 1.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/C3814 18.jpg\",\"alt_text\":\"C3814 18.jpg\"},\"gallery3\":{\"photo\":\"images/gallery/C3814 7.jpg\",\"alt_text\":\"C3814 7.jpg\"},\"gallery7\":{\"photo\":\"images/gallery/C3814 9.jpg\",\"alt_text\":\"C3814 9.jpg\"},\"gallery5\":{\"photo\":\"images/gallery/C3814 20.jpg\",\"alt_text\":\"C3814 20.jpg\"},\"gallery17\":{\"photo\":\"images/gallery/C3814 3.jpg\",\"alt_text\":\"C3814 3.jpg\"},\"gallery15\":{\"photo\":\"images/gallery/C3814 17.jpg\",\"alt_text\":\"C3814 17.jpg\"},\"gallery19\":{\"photo\":\"images/gallery/C3814 5.jpg\",\"alt_text\":\"C3814 5.jpg\"},\"gallery9\":{\"photo\":\"images/gallery/C3814 11.jpg\",\"alt_text\":\"C3814 11.jpg\"},\"gallery16\":{\"photo\":\"images/gallery/C3814 2.jpg\",\"alt_text\":\"C3814 2.jpg\"},\"gallery8\":{\"photo\":\"images/gallery/C3814 10.jpg\",\"alt_text\":\"C3814 10.jpg\"},\"gallery20\":{\"photo\":\"images/gallery/C3814 6.jpg\",\"alt_text\":\"C3814 6.jpg\"},\"gallery11\":{\"photo\":\"images/gallery/C3814 13.jpg\",\"alt_text\":\"C3814 13.jpg\"},\"gallery10\":{\"photo\":\"images/gallery/C3814 12.jpg\",\"alt_text\":\"C3814 12.jpg\"},\"gallery13\":{\"photo\":\"images/gallery/C3814 15.jpg\",\"alt_text\":\"C3814 15.jpg\"},\"gallery6\":{\"photo\":\"images/gallery/C3814 8.jpg\",\"alt_text\":\"C3814 8.jpg\"},\"gallery12\":{\"photo\":\"images/gallery/C3814 14.jpg\",\"a