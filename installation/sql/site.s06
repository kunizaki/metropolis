('1932', 'A8147', 'Bosque Eucaliptos- Apto 110 m2 com 3 quartos(suite), arms, coz.plan, sacada, banh.serv, 2 vgs garage', 'xa8147', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">O apto está localizado no Bosque dos Eucaliptos:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 110m² Área construída</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 3 Dormitórios sendo 1 suíte</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Garagem coberta para 2 carros</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 banheiros com box/gabinete</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sala ampla com sacada e ótima vista para as árvores </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Ar condicionado</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Área de serviços</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Documentação 100%</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Andar baixo</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Vista para os eucaliptos </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Ótimo estado de conservação </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Quartinho de ferramentas </span></p>\r\n<p><span style=\"font-size: 12.16px;\">-  Piso em Porcelanato </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sol da tarde<br /><br />Condomínio R$783,00     IPTU R$1025,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/A8147 1.JPG\",\"alt_text\":\"A8147 1.JPG\"},\"gallery14\":{\"photo\":\"images/gallery/A8147 14.JPG\",\"alt_text\":\"A8147 14.JPG\"},\"gallery13\":{\"photo\":\"images/gallery/A8147 13.JPG\",\"alt_text\":\"A8147 13.JPG\"},\"gallery2\":{\"photo\":\"images/gallery/A8147 2.JPG\",\"alt_text\":\"A8147 2.JPG\"},\"gallery12\":{\"photo\":\"images/gallery/A8147 12.JPG\",\"alt_text\":\"A8147 12.JPG\"},\"gallery10\":{\"photo\":\"images/gallery/A8147 10.JPG\",\"alt_text\":\"A8147 10.JPG\"},\"gallery9\":{\"photo\":\"images/gallery/A8147 9.JP