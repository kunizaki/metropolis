('2069', 'C3717', 'Jd. Paraíso- Casa de 72 m2 com 2 quartos(suite), 2 vagas de garagem', 'xc3717', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">A casa no Jardim Paraíso tem 72 m2 de área útil com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 quartos sendo 1 suite</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- banheiros com box</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sala</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 vagas cobertas de garagem</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- estrutura para sobrado</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/C3717a.jpg\",\"alt_text\":\"C3717a.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/C3717.jpg\",\"alt_text\":\"C3717.jpg\"}}', 'sell', '', '532000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José Dos Campos/SP', 'Jardim Paraíso', '0,0', '12235-500', '72', '2', '2', '2', '', '0', '[\"27\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2025-04-22 00:00:00', '783', '2025-04-22 15:40:12', '0', NULL),
('2071', 'A8229', 'Terra Brasilis/ Solar das Pitangueiras- Apto 46 m2 com 2 quartos+armários, coz.plan, 1 vg garagem', 'xa8229', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">O Apto no Loteamento Terra Brasilis, Solar das Pitangueiras tem 46 m2 com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 dormitórios, com móveis planejados</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sala 2 ambientes</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- cozinha com planejados e cooktop</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- área de serviço com planejados</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- apartamento no último andar, oferecendo uma maior privacidade</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- elevador</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- piscina</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- salão de festa</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- academia</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- churrasqueira</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- playground</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- bicicletário</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- vagas de visitantes</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- vagas para moto</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- portaria 24h</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- bairro: comércios, escolas, UBA, postos de saúde, transportes</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- acesso fácil a via Cambuí e Tamoios</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- bairro se encontra em expansão.</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> 2 quartos e 1 banheiro</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Possui parquinho com diferentes brinquedos, salão para festas e eventos, academia.<br />Condomínio: R$430,00<br />IPTU: R$616,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":