('1980', 'a7289', 'V. Adyana- Apto Reformado, 42 m2, 1 quarto+armários, coz.planejada, sacada, 1 vg garagem', 'xa7289', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">Apartamento Reformado na Vila Adyana de AU de 42m2, com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 1 Dormitório e armário embutido</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sala com sacada e sol da manhã</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Cozinha planejada</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Banheiro com box/gabinete</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 1 vaga de garagem</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Portaria 24h</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Piscina adulto/infantil</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Churrasqueira</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Salão de Festas</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Salão de festas</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Academia</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sauna</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Ótima localização, perto de restaurantes e vários outros comércios. </span></p>\r\n<p><span style=\"font-size: 12.16px;\">Entre dois parques, o Santos Dumont e o Vicentina Aranha.<br /><br />Condomínio R$750,00 <br />IPTU R$530,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/A2386 0.jpg\",\"alt_text\":\"A2386 0.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/A7289 1.jpg\",\"alt_text\":\"A7289 1.jpg\"},\"gallery7\":{\"photo\":\"images/gallery/A7289 6.jpg\",\"alt_text\":\"A7289 6.jpg\"},\"gallery11\":{\"photo\":\"images/gallery/A7289 10.jpg\",\"alt_text\":\"A7289 10.jpg\"},\"gallery9\":{\"photo\":\"images/gallery/A7289 8.jpg\",\"alt_text\":\"A7289 8.jpg\"},\"gallery10\":{\"photo\":\"images/gallery/A7289 9.jpg\",\"alt_text\":\"A7289 9.jpg\"},\"gallery5\":{\"photo\":\"images/gallery/A7289 4.jpg\",