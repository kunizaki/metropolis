('2072', 'A8230', 'Vila Industrial/ Cond. Maranata- Apto 63 m2 com 2 quartos(ste), armários, coz.plan, sacada, 1 vg', 'xa8230', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">O apto na Vila Industrial tem 63 m2 com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 dormitórios sendo uma suíte com armários planejados</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sacada envidraçada com cortinas</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- cozinha e área de serviço com armários planejados</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- piso em porcelanato</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- uma vaga coberta</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- vaga para visitantes</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- portaria 24h</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- aceita pet</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- condomínio club, com lazer completo</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- elevadores</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- analisa propostas vende tb com porteira fechada</span></p>', '', NULL, NULL, '{\"gallery24\":{\"photo\":\"images\\/gallery\\/A8230 19.jpg\",\"alt_text\":\"A8230 19.jpg\"},\"gallery25\":{\"photo\":\"images\\/gallery\\/A8230 18.jpg\",\"alt_text\":\"A8230 18.jpg\"},\"gallery26\":{\"photo\":\"images\\/gallery\\/A8230 22.jpg\",\"alt_text\":\"A8230 22.jpg\"},\"gallery30\":{\"photo\":\"images\\/gallery\\/A8230 17.jpg\",\"alt_text\":\"A8230 17.jpg\"},\"gallery28\":{\"photo\":\"images\\/gallery\\/A8230 21.jpg\",\"alt_text\":\"A8230 21.jpg\"},\"gallery29\":{\"photo\":\"images\\/gallery\\/A8230 20.jpg\",\"alt_text\":\"A8230 20.jpg\"},\"gallery37\":{\"photo\":\"images\\/gallery\\/A8230 3.jpg\",\"alt_text\":\"A8230 3.jpg\"},\"gallery33\":{\"photo\":\"images\\/gallery\\/A8230 1.jpg\",\"alt_text\":\"A8230 1.jpg\"},\"gallery32\":{\"photo\":\"images\\/gallery\\/A8230 16.jpg\",\"alt_text\":\"A8230 16.jpg\"},\"ga