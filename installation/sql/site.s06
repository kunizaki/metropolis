('2093', 'C3725', 'Jd. das Indústrias- Sobrado 165 m2 com 3 quartos(suite), armários, coz.plan, lavado, banh.serv, 2 vg', 'xc3725', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">Jd. das Indústrias- Sobrado de 165m2 com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Três quartos sendo uma suíte</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Suíte Casal repleta de armários planejados novos e cortina blackout - </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Banheiro com armários de espelho deslizante e box com vidro jateado. - Varanda com vista da rua</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Quarto com armários planejados novos</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Mesa de trabalho com painel de Led e Cortina rolo blackout</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Varanda com vista da área de lazer nos fundos/churrasqueira</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Terceiro quarto utilizado como escritório/sala de TV</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Banheiro social com armários planejados novos e box com vidro jateado</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sala muito ampla com sanca em gesso e leds de iluminação indireta</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Escada em mármore preto</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Cozinha espaçosa repleta de armários planejados</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- bancada em mármore preto</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Forno, cooktop e depurador Brastemp</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sala de jantar integrada a cozinha, com Cristaleira e espaço para mesa de jantar com 6 lugares confortavelmente</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Lavabo espaçoso com pia de mármore Travertino</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Lavanderia estilo americano, com bancada em mármore preto e armários planejados</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Área de lazer com churrasqueira e fogão a lenha de tijolo a vista, além de pia apoio e lavabo</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Garagem coberta com portão eletrônico e espaço para 2 carros.</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/C3725 3.jpg\",\"alt_text\":\"C3725 3.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/C3725 5.jpg\",\"alt_text\":\"C3725 5.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/C3725 2.jpg\",\"alt_text\":\"C3725 2.jpg\"}}', 'sell', '', '910000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José Dos Campos/SP', 'Jardim das Indústrias', '0,0', '12240-780', '165', '3', '4', '2', '', '0', '[\"27\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2025-05-13 00:00:00', '783', '2025-06-25 22:44:40', '0', NULL),
('2095', 'A8241', 'Jd. Aquarius- Apto 194 m2 com 3 quartos(3 suites), arms, coz.plan, sacada gourmet, 2 vgs, lazer comp', 'xa8241', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">O apto no Jd. Aquarius tem 194 m2 com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 3 quartos sendo 3 suites, todos com armários</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- ampla sala com sacada gourmet</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- lavabo</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- cozinha planejada</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sol da manhã</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- banheiro de serviço</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- academia</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- espaço gourmet</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- playground</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- dois salões de festas</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- piscina</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- quadra poliesportiva</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- churrasqueira</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- elevador</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- avalia terreno no Terras Alpha como parte de pagto</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Condomínio: R$1200,00</span></p>\r\n<p><span style=\"font-size: 12.16px;\">IPTU: R$2800,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A8241 2.jpg\",\"alt_text\":\"A8241 2.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/A8241 1.jpg\",\"alt_text\":\"A8241 1.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/A8241 19.jpg\",\"alt_text\":\"A8241 19.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/A8241 23.jpg\",\"alt_text\":\"A8241 23.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/A8241 20.jpg\",\"alt_text\":\"A8241 20.jpg\"},\"gallery8\":{\"photo\":\"image