('1969', 'A8168', 'Jd. Augusta-Apto 92 m2 com 3 quartos(suite), arms, coz.plan, 2 vgs garagem', 'xa8168', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">O Apto localizado no Jd Augusta tem 92 m2 com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 3 dormitórios/1suíte com armários</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- cozinha planejada</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 banheiros bem distribuídos</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 vagas de garagem cobertas</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- espaço p/ você e sua família viverem com tranquilidade e estilo</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Piscina para relaxar e se refrescar nos dias quentes</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Academia equipada para manter uma rotina saudável</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Espaço infantil que garante a diversão segura das crianças</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Localização em bairro tranquilo, garantindo segurança e sossego</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Próximo ao Batalhão da Polícia Militar, para maior tranquilidade</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Ao lado do Shopping Center Vale</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- A apenas 10 minutos do centro da cidade, do aeroporto<br /><br />Condomínio R$810,00     IPTU R$1450,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/A8168 1.jpg\",\"alt_text\":\"A8168 1.jpg\"},\"gallery13\":{\"photo\":\"images/gallery/A8168 13.jpg\",\"alt_text\":\"A8168 13.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/A8168 2.jpg\",\"alt_text\":\"A8168 2.jpg\"},\"gallery12\":{\"photo\":\"images/gallery/A8168 12.jpg\",\"alt_text\":\"A8168 12.jpg\"},\"gallery10\":{\"photo\":\"images/gallery/A8168 10.jpg\",\"alt_text\":\"A8168 10.jpg\"},\"gallery7\":{\"photo\":\"images/gallery/A8168 7.jpg\",\"alt_text\":\"A8168 7.jpg\"},\"gallery8\":{\"photo\":\"images/gallery/A8168 8.jpg\",\"alt_text\":\"A8168 8.jpg\"},\"gallery9\":{\"photo\":\"images/gallery/A8168 9.jpg\",\"alt_text\":\"A8168 9.jpg\"},\"gallery6\":{\"photo\":\"images/gallery/A8168 6.jpg\",\"alt_text\":\"A8168 6.jpg\"},\"gallery3\":{\"photo\":\"images/gallery/A8168 3.jpg\",\"alt_text\":\"A8168 3.jpg\"},\"gallery5\":{\"photo\":\"images/gallery/A8168 5.jpg\",\"alt_text\":\"A8168 5.jpg\"},\"gallery4\":{\"photo\":\"images/gallery/A8168 4.jpg\",\"alt_text\":\"A8168 4.jpg\"},\"gallery11\":{\"photo\":\"images/gallery/A8168 11.jpg\",\"alt_text\":\"A8168 11.jpg\"},\"gallery14\":{\"photo\":\"images/gallery/A8168 14.jpg\",\"alt_text\":\"A8168 14.jpg\"}}', 'sell', '', '650000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Jardim Augusta', '-23.198358,-45.878476', '12216-780', '92', '3', '2', '2', '', '0', '[\"8\",\"12\",\"18\",\"21\",\"22\",\"23\",\"27\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2025-01-10 00:00:00', '783', '2025-01-14 16:51:33', '0', NULL),
('1971', 'M1525', 'CEIC- Centro Empresarial e Industrial de Caçapava- Galpão de AU900m2 e AT 1.000m2', 'xm1525', '3', '1', '', '<p><span style=\"font-size: 12.16px;\">Galpão Industrial/Logistico-Condominio CEIC-Centro Industrial de Caçapava </span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">Características do Imóvel </span></p>\r\n<p><span style=\"font-size: 12.16px;\">*Area do Terreno 1.000 m2</span></p>\r\n<p><span style=\"font-size: 12.16px;\">•Área construída-900 m2 area total -Sendo 700 area fabril/estoque)</span></p>\r\n<p><span style=\"font-size: 12.16px;\">•Sistema sustentável de reutilização de agua das chuvas(redução de ate 80% conta de agua)</span></p>\r\n<p><span style=\"font-size: 12.16px;\">*Entrada alta tensão de energia.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">*Piso de alta resistência 8 ton/m2</span></p>\r\n<p><span style=\"font-size: 12.16px;\">•Otimização de  consumo de energia (iluminação em led, acompanhada iluminação natural e preparação para energia solar)</span></p>\r\n<p><span style=\"font-size: 12.16px;\">•Pé direito 9 mt</span></p>\r\n<p><span style=\"font-size: 12.16px;\">• Portas para carga a descarga na frente e na lateral do galpão)</span></p>\r\n<p><span style=\"font-size: 12.16px;\">*Doca coberta para carga e descarga (comportando acesso inclusive a carretas)</span></p>\r\n<p><span style=\"font-size: 12.16px;\">*Vestiário masculino e feminino</span></p>\r\n<p><span style=\"font-size: 12.16px;\">*Refeitorio</span></p>\r\n<p><span style=\"font-size: 12.16px;\">*Area de escritorio com copa e banheiros privativos </span></p>\r\n<p><span style=\"font-size: 12.16px;\">•Escritorio com visão panorâmica para area fábril/estoque </span></p>\r\n<p><span style=\"font-size: 12.16px;\">*05 vagas de estacionamento </span></p>\r\n<p><span style=\"font-size: 12.16px;\">*Preparação para sistema de CFTV</span></p>\r\n<p><span style=\"font-size: 12.16px;\">*Estrutura Interna Hidrantes</span></p>\r\n<p><span style=\"font-size: 12.16px;\">*Seguranca 24 horas(localizado em condomínio fechado)</span></p>\r\n<p><span style=\"font-size: 12.16px;\">*Acesso e manobra fácil , para carretas e caminhões de grande porte.(Largura da rua 12 metros (pavimento asfáltico)</span></p>\r\n<p><span style=\"font-size: 12.16px;\">•Condomínio totalmente fechado.(referência em segurança na região)</span></p>\r\n<p><span style=\"font-size: 12.16px;\">•Rede eletrica de alta tensão em todo o empreendimento.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">•Galpão Novo, ficará pronto em março 2025.</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">Características da Localização:</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> - 55 min do Aeroporto de Guarulhos-SP;</span></p>\r\n<p><span style=\"font-size: 12.16px;\">-7 minutos do centro de Caçapava</span></p>\r\n<p><span style=\"font-size: 12.16px;\">-15 minutos do centro de Sao Jose Dos Campos</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Localização extremamente privilegiada ;(Divisa entre São José dos Campos e Caçapava)</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Localizado entre 2 eixos entre rodovias, Rod Vito Ardito (Estadual) e Rod Presidente Dutra (Federal); com alças de acesso aos sentidos RJ e SP;</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Fácil Acesso: Apenas 300m da Rodovia Presidente Dutra, que passa em frente ao empreendimento. E somente 4 km do acesso a Rodovia Governador Carvalho Pinto</span></p>', '', NULL, NULL, '{\"gallery5\":{\"photo\":\"images/gallery/M1525 1.jpeg\",\"alt_text\":\"M1525 1.jpeg\"},\"gallery8\":{\"photo\":\"images/gallery/M1525 4.jpeg\",\"alt_text\":\"M1525 4.jpeg\"},\"gallery7\":{\"photo\":\"images/gallery/M1525 3.jpeg\",\"alt_text\":\"M1525 3.jpeg\"},\"gallery6\":{\"photo\":\"images/gallery/M1525 2.jpeg\",\"alt_text\":\"M1525 2.jpeg\"},\"gallery10\":{\"photo\":\"images/gallery/M1525 5.jpeg\",\"alt_text\":\"M1525 5.jpeg\"},\"gallery9\":{\"photo\":\"images/gallery/M1525 4.jpeg\",\"alt_text\":\"M1525 4.jpeg\"},\"gallery11\":{\"photo\":\"images/gallery/M1525 6.jpeg\",\"alt_text\":\"M1525 6.jpeg\"},\"gallery13\":{\"photo\":\"images/gallery/M1525 8.jpeg\",\"alt_text\":\"M1525 8.jpeg\"},\"gallery14\":{\"photo\":\"images/gallery/M1525 9.jpeg\",\"alt_text\":\"M1525 9.jpeg\"},\"gallery16\":{\"photo\":\"images/gallery/M1525 11.jpeg\",\"alt_text\":\"M1525 11.jpeg\"},\"gallery15\":{\"photo\":\"images/gallery/M1525 10.jpeg\",\"alt_text\":\"M1525 10.jpeg\"},\"gallery17\":{\"photo\":\"images/gallery/M1525 12.jpeg\",\"alt_text\":\"M1525 12.jpeg\"},\"gallery12\":{\"photo\":\"images/gallery/M1525 7.jpeg\",\"alt_text\":\"M1525 7.jpeg\"}}', 'rent-sell', '', '3100000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'Caçapava', 'Jardim Campo Grande', '-23.081369,-45.674086', '12282-535', '900', '0', '0', '0', '', '0', '[\"8\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2025-01-17 00:00:00', '783', '2026-05-27 16:00:16', '0', NULL),
('1978', 'C3675', 'V. Betânia- Sobrado 170 m2 com 5 quartos(2 suites), sacada, armários, 2 vgs garagem', 'xc3675', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">O sobrado no bairro Vila Betânia possui 170 m2 com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Terreno: 250m2 / AC: 162m2</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 5 quartos sendo 2 suítes ( 1 serviço )</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 5 banheiros</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 1 lavabo</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 1 sala jantar</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 1 sala estar</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 1 escritório</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sala TV</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- ar-condicionado</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- cozinha com despensa</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 1 lavanderia</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- garagem coberta para 2 carros</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- área gourmet com Churrasqueira</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sistema de aquecimento gás encanado</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- somente venda, sem permuta</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/C3675 0.jpg\",\"alt_text\":\"C3675 0.jpg\"},\"gallery5\":{\"photo\":\"images/gallery/C3675 4.jpg\",\"alt_text\":\"C3675 4.jpg\"},\"gallery6\":{\"photo\":\"images/gallery/C3675 5.jpg\",\"alt_text\":\"C3675 5.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/C3675 1.jpg\",\"alt_text\":\"C3675 1.jpg\"},\"gallery14\":{\"photo\":\"images/gallery/C3675 13.jpg\",\"alt_text\":\"C3675 13.jpg\"},\"gallery11\":{\"photo\":\"images/gallery/C3675 10.jpg\",\"alt_text\":\"C3675 10.jpg\"},\"gallery4\":{\"photo\":\"images/gallery/C3675 3.jpg\",\"alt_text\":\"C3675 3.jpg\"},\"gallery9\":