('2083', 'C3719', 'Res. Mantiqueira- Casa de 175 m2 com 3 quartos(ste), arms, coz.plan, 2 vgs gar', 'xc3719', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">A casa térrea no Condomínio Residencial Mantiqueira possui 175 m2 com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 3 quartos sendo 1 suite</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- cozinha planejada</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- ampla sala</span></p>\r\n<p><span style=\"font-size: 12.16px;\">-banheiros com box/gabinete</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 vagas de garagem</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- quintal com churrasqueira, pia</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- quartinho e 01 banheiro de serviço</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- acabamento de primeira qualidade</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- forros e lambris de madeira</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- iluminação planejada</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- piso vinílico na sala de TV e nos quartos e piso de porcelanato na sala</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- tela mosqueteira em todas as janelas</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- aquecimento da água através de boiler</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- placas solares, para todos os chuveiros e todas as torneiras</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- documentação em ordem para financiamento bancário</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- avalia imóvel de menor valor como parte de pagamento</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- condomínio com vários itens de lazer e valor baixo</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">Lazer no condomínio:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Lago de pesca</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Campo de futebol</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Quadra poliesportiva</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Parquinho</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Playground</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Quiosque à beira do lago</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Pista de caminhada.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Espaço para os pets</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Segurança 24h</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/C3719 1.jpg\",\"alt_text\":\"C3719 1.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/C3719 3.jpg\",\"alt_text\":\"C3719 3.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/C3719 2.jpg\",\"alt_text\":\"C3719 2.jpg\"},\"gallery16\":{\"photo\":\"images\\/gallery\\/C3719 15.jpg\",\"alt_text\":\"C3719 15.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/C3719 7.jpg\",\"alt_text\":\"C3719 7.jpg\"},\"gallery15\":{\"photo\":\"images\\/gallery\\/C3719 14.jpg\",\"alt_text\":\"C3719 14.jpg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/C3719 10.jpg\",\"alt_text\":\"C3719 10.jpg\"},\"gallery14\":{\"photo\":\"images\\/gallery\\/C3719 13.jpg\",\"alt_text\":\"C3719 13.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/C3719 4.jpg\",\"alt_text\":\"C3719 4.jpg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/C3719 11.jpg\",\"alt_text\":\"C3719 11.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/C3719 22.jpg\",\"alt_text\":\"C3719 22.jpg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/C3719 9.jpg\",\"alt_text\":\"C3719 9.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/C3719 6.jpg\",\"alt_text\":\"C3719 6.jpg\"},\"gallery18\":{\"photo\":\"images\\/gallery\\/C3719 17.jpg\",\"alt_text\":\"C3719 17.jpg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/C3719 12.jpg\",\"alt_text\":\"C3719 12.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/C3719 5.jpg