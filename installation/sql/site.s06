('2091', 'A8239', 'Urbanova/Cond. The Gold- Apto 56 m2 com 2 quartos(suite),sacada, 2 vgs garagem, lazer', 'xa8239', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">O apto no Urbanova, Condomínio Residencial The Gold tem:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 56 metros quadrados</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 quartos sendo 1 suite</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sala com sacada gourmet</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 vagas de garagem</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- área de fitness</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- parquinho com diferentes brinquedos</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- salão para festas e eventos</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- espaço gourmet</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- piscina</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- quadra poliesportiva</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- churrasqueira</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- home office</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- cinema</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- academia</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- elevador</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- vaga para visitantes</span></p>\r\n<p><span style=\"font-size: 12.16px;\">IPTU: R$1450,00</span></p>', '', NULL, NULL, '{\"gallery3\":{\"photo\":\"images/gallery/A8239 0.jpg\",\"alt_text\":\"A8239 0.jpg\"},\"gallery4\":{\"photo\":\"images/gallery/A8239 1.jpg\",\"alt_text\":\"A8239 1.jpg\"},\"gallery5\":{\"photo\":\"images/gallery/A8239 13.jpg\",\"alt_text\":\"A8239 13.jpg\"},\"gallery7\":{\"photo\":\"images/gallery/A8239 29.jpeg\",\"alt_text\":\"A8239 29.jpeg\"},\"gallery6\":{\"photo\":\"images/gallery/A8239 28.jpeg\",\"alt_text\":\"A8239 28.jpeg\"},\"gallery14\":{\"photo\":\"images/gallery/A8239 20.jpg\",\"alt_text\":\"A8