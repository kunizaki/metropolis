('2097', 'C3728', 'Floresta/Cond. Rudá - Sobrado de 250 m2 com 3 quartos(2 stes), escritório, lavabo, 2 vgs garagem', 'xc3728', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">O sobrado no Loteamento Floresta, Condomínio Rudá tem 250 m2 com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Área terreno : 260 metros quadrados </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Área construída : 252,00 metros quadrados </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Vaga coberta para 2 carros</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Escritório</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Lavabo</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Cozinha</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sala TV e Sala Jantar integradas</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Área de serviço</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Ampla varanda integrada com Área Gourmet</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Banheiro para atender área gourmet</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Espaço nos fundos caso queira construir piscina</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 3 Suítes sendo a do casal com Closet</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sacada em 2 Suítes</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Preparação para Aquecimento Solar em todos pontos de chuveiro e torneira</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Preparação para Ar Condicionado nas 3 Suítes e na Sala</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Preparação hidráulica e Elétrica caso queira construir piscina</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Preparação de Tomada para Carro Elétrico na Garagem</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Casa com acabamentos de qualidade e bom gosto</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Avalia permuta por apartamento ou terreno em condomínio . </span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">Área de lazer com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Piscina</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Quadra poliesportiva</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Playground</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sala de festas</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Churrasqueira</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Portaria 24h</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Condomínio: R$468,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/C3728 3.jpg\",\"alt_text\":\"C3728 3.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/C3728 2.jpg\",\"alt_text\":\"C3728 2.jpg\"},\"gallery3\":{\"photo\":\"images/gallery/C3728 4.jpg\",\"alt_text\":\"C3728 4.jpg\"},\"gallery4\":{\"photo\":\"images/gallery/C3728 1.jpg\",\"alt_text\":\"C3728 1.jpg\"},\"gallery5\":{\"photo\":\"images/gallery/C3728 12.jpg\",\"alt_text\":\"C3728 12.jpg\"},\"gallery10\":{\"photo\":\"images/gallery/C3728 7.jpg\",\"alt_text\":\"C3728 7.jpg\"},\"gallery11\":{\"photo\":\"images/gallery/C3728 8.jpg\",\"alt_text\":\"C3728 8.jpg\"},\"gallery6\":{\"photo\":\"images/gallery/C3728 13.jpg\",\"alt_text\":\"C3728 13.jpg\"},\"gallery7\":{\"photo\":\"images/gallery/C3728 14.jpg\",\"alt_text\":\"C3728 14.jpg\"},\"gallery14\":{\"photo\":\"images/gallery/C3728 11.jpg\",\"alt_text\":\"C3728 11.jpg\"},\"gallery8\":{\"photo\":\"images/gallery/C3728 5.jpg\",\"alt_text\":\"C3728 5.jpg\"},\"gallery13\":{\"photo\":\"images/gallery/C3728 10.jpg\",\"alt_text\":\"C3728 10.jpg\"},\"gallery12\":{\"photo\":\"images/gallery/C3728 9.jpg\",\"alt_text\":\"C3728 9.jpg\"},\"gallery9\":{\"photo\":\"images/gallery/C3728 6.jpg\",\"alt_text\":\"C3728 6.jpg\"}}', 'sell', '', '1750000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José Dos Campos/SP', 'Loteamento Floresta', '0,0', '12226-371', '250', 