('2096', 'C3727', 'Jd. Uirá/Cond. Bell Park- Sobrado de 250 m2 - 3 quartos(suite), coz.planejada, 2 vgs garagem', 'xc3727', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">O Sobrado no Jardim Uirá / Condomínio Bel Park tem 250 m2 com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 3 quartos sendo 1 suite no piso superior</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sacada voltada para a rua</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 1 dormitório também no piso superior com sacada lateral</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 1 dormitório no piso inferior</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sala dois ambientes</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- escada em caracol com acabamento em mármore travertino</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- corrimão em aço inox</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- cozinha ampla com móveis planejados</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- parte externa churrasqueira e lavabo</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- lavanderia e mais um cômodo acima da churrasqueira</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- garagem ampla para dois carros</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Condomínio: R$350,00</span></p>\r\n<p><span style=\"font-size: 12.16px;\">IPTU: R$540,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/C3727 12.jpg\",\"alt_text\":\"C3727 12.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/C3727 2.jpg\",\"alt_text\":\"C3727 2.jpg\"},\"gallery3\":{\"photo\":\"images/gallery/C3727 1.jpg\",\"alt_text\":\"C3727 1.jpg\"},\"gallery10\":{\"photo\":\"images/gallery/C3727 6.jpg\",\"alt_text\":\"C3727 6.jpg\"},\"gallery11\":{\"photo\":\"images/gallery/C3727 7.jpg\",\"alt_text\":\"C3727 7.jpg\"},\"gallery8\":{\"photo\":\"images/gallery/C3727 4.jpg\",\"alt_text\":\"C3727 4.jpg\"},\"gallery6\":{\"photo\":\"images/gallery/C3727 11.jpg\",\"alt_t