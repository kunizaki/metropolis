('2068', 'C3716', 'Urbanova/Floradas Serra Ac/At-288m2/300m2 com 3 quartos(ste), arms, coz.plan, 4 vgs gar', 'xc3716', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">Sobrado no Floradas da Serra - Urbanova</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Área construída: 288 m²</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Área do terreno: 300 m²</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 3 dormitórios (sendo 1 suíte com armário planejado)</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sala de estar aconchegante</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sala de jantar integrada</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Cozinha americana moderna</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 3 banheiros + lavabo</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Área de serviço funcional</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 vagas de garagem cobertas e mais 2 descobertas (total 4)</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Lareira em três ambientes</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Churrasqueira e forno integrados para momentos em família</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Brinquedoteca integrada à área de lazer</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Escritório ideal para home office</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Banheiro e chuveiro na parte externa</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Varandas com vista para área verde</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Portaria 24h para total segurança</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Pisos em porcelanato que unem beleza e praticidade</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Fachada imponente e arborizada</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Área gourmet com churrasqueira</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Pergolado com espaço para relaxar</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Varandas espaçosas e iluminadas<br />Condomínio: R$405,00</span></p>\r\n<p><span style=\"font-size: 12.16px;\">IPTU: R$2000,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/C3716 5.jpg\",\"alt_text\":\"C3716 5.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/C3716 19.jpg\",\"alt_text\":\"C3716 19.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/C3716 20.jpg\",\"alt_text\":\"C3716 20.jpg\"},\"gallery20\":{\"photo\":\"images\\/gallery\\/C3716 4.jpg\",\"alt_text\":\"C3716 4.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/C3716 16.jpg\",\"alt_text\":\"C3716 16.jpg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/C3716 8.jpg\",\"alt_text\":\"C3716 8.jpg\"},\"gallery14\":{\"photo\":\"images\\/gallery\\/C3716 9.jpg\",\"alt_text\":\"C3716 9.jpg\"},\"gallery17\":{\"photo\":\"images\\/gallery\\/C3716 1.jpg\",\"alt_text\":\"C3716 1.jpg\"},\"gallery15\":{\"photo\":\"images\\/gallery\\/C3716 10.jpg\",\"alt_text\":\"C3716 10.jpg\"},\"gallery19\":{\"photo\":\"images\\/gallery\\/C3716 3.jpg\",\"alt_text\":\"C3716 3.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/C3716 15.jpg\",\"alt_text\":\"C3716 15.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/C3716 13.jpg\",\"alt_text\":\"C3716 13.jpg\"},\"gallery16\":{\"photo\":\"images\\/gallery\\/C3716 11.jpg\",\"alt_text\":\"C3716 11.jpg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/C3716 6.jpg\",\"alt_text\":\"C3716 6.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/C3716 14.jpg\",\"alt_text\":\"C3716 14.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/C3716 12.jpg\",\"alt_text\":\"C3716 12.jpg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/C3716 7.jpg\",\"alt_text\":\"C3716 7.jpg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/C3716 17.jpg\",\"alt_text\":\"C3716 17.jpg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/C3716 18.jpg\",\"alt_text\":\"C3716 18.jpg\"},\"gallery18\":{\"photo\":\"images\\/gallery\\/C3716 2.jp