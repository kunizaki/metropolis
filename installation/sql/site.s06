('1986', 'A8174', 'Jd. Rodolfo- Apto 65 m2 com 2 quartos(suite), sala+sacada+churrasqueira, coz.plan, 1 vg garagem', 'xa8174', '1', '1', '', '<p><span style=\"font-size: 13.68px;\">O apto no Jardim Rodolfo possui 65 metros quadrados com:</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- 2 quartos sendo 1 suite</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- sala com sacada e churrasqueira</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- cozinha planejada</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- banheiros com box/gabinete</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- 1 vaga de garagem<br /><br />Condominio R$300,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/A8174 1.jpg\",\"alt_text\":\"A8174 1.jpg\"},\"gallery18\":{\"photo\":\"images/gallery/A8174 18.jpg\",\"alt_text\":\"A8174 18.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/A8174 2.jpg\",\"alt_text\":\"A8174 2.jpg\"},\"gallery17\":{\"photo\":\"images/gallery/A8174 17.jpg\",\"alt_text\":\"A8174 17.jpg\"},\"gallery12\":{\"photo\":\"images/gallery/A8174 12.jpg\",\"alt_text\":\"A8174 12.jpg\"},\"gallery16\":{\"photo\":\"images/gallery/A8174 16.jpg\",\"alt_text\":\"A8174 16.jpg\"},\"gallery4\":{\"photo\":\"images/gallery/A8174 4.jpg\",\"alt_text\":\"A8174 4.jpg\"},\"gallery7\":{\"photo\":\"images/gallery/A8174 7.jpg\",\"alt_text\":\"A8174 7.jpg\"},\"gallery13\":{\"photo\":\"images/gallery/A8174 13.jpg\",\"alt_text\":\"A8174 13.jpg\"},\"gallery5\":{\"photo\":\"images/gallery/A8174 5.jpg\",\"alt_text\":\"A8174 5.jpg\"},\"gallery9\":{\"photo\":\"images/gallery/A8174 9.jpg\",\"alt_text\":\"A8174 9.jpg\"},\"gallery6\":{\"photo\":\"images/gallery/A8174 6.jpg\",\"alt_text\":\"A8174 6.jpg\"},\"gallery20\":{\"photo\":\"images/gallery/A8174 20.jpg\",\"alt_text\":\"A8174 20.jpg\"},\"gallery23\":{\"photo\":\"images/gallery/A8174 23.jpg\",\"alt_text\":\"A8174 23.jpg\"},\"gallery3\":{\"photo\":\"images/gallery/A8174 3.jpg\",\"alt_text\":\"A8174 3.jpg\"},\"gallery2