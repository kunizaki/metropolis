('2046', 'C3711', 'Urbanova/Sobrado 326 m2 - 4 quartos(ste), arms, coz.plan, lavabo, piscina, churrasq, 3 vgs garagem', 'xc3711', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">Sobrado no Condomínio Urbanova Premium, em lote de 336m2 com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">Andar de baixo: </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sala, </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- lavabo, </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- escritório, </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- cozinha planejada</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- lavanderia com banheiro</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- área gourmet com churrasqueira e piscina. </span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">Andar de cima: </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- planta com 4 quartos, sendo 1 quarto modificado em closet</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- suíte e banheiro social</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">Diferencial: </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- condomínio pequeno e silencioso</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sem vizinho de fundo</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- energia solar</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- gás encanado na cozinha</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- ventilador de teto nos quartos</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sala com ar-condicionado</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- condomínio com portaria 24hs e parquinho. </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- analisa permuta por apto com sacada gourmet e área de lazer completa, preferencialmente no Aquarius - até 1.6 milhão</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Condomínio: R$ 1000,00<br />IPTU: R$1700,00</span></p>\r\n<p> </p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/C3711 1.jpg\",\"alt_text\":\"C3711 1.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/C3711 15.jpg\",\"alt_text\":\"C3711 15.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/C3711 16.jpg\",\"alt_text\":\"C3711 16.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/C3711 17.jpg\",\"alt_text\":\"C3711 17.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/C3711 2.jpg\",\"alt_text\":\"C3711 2.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/C3711 12.jpg\",\"alt_text\":\"C3711 12.jpg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/C3711 10.jpg\",\"alt_text\":\"C3711 10.jpg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/C3711 9.jpg\",\"alt_text\":\"C3711 9.jpg\"},\"gallery14\":{\"photo\":\"images\\/gallery\\/C3711 6.jpg\",\"alt_text\":\"C3711 6.jpg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/C3711 11.jpg\",\"alt_text\":\"C3711 11.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/C3711 13.jpg\",\"alt_text\":\"C3711 13.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/C3711 14.jpg\",\"alt_text\":\"C3711 14.jpg\"},\"gallery15\":{\"photo\":\"images\\/gallery\\/C3711 5.jpg\",\"alt_text\":\"C3711 5.jpg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/C3711 8.jpg\",\"alt_text\":\"C3711 8.jpg\"},\"gallery17\":{\"photo\":\"images\\/gallery\\/C3711 3.jpg\",\"alt_text\":\"C3711 3.jpg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/C3711 7.jpg\",\"alt_text\":\"C3711 7.jpg\"},\"gallery16\":{\"photo\":\"images\\/gallery\\/C3711 4.jpg\",\"alt_text\":\"C3711 4.jpg\"}}', 'sell', '', '1810000.00', '', '', '', '1', 'show', '12', 'BR', 'São José Dos Campos/SP', 'Urbanova', '0,0', '12244-000', '326', '4', '3', '3', '', '0', '[\"8\",\"9\",\"27\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2025-04-08 00:00:00', '783', '2025-04-09 12:26:20', '0', NULL),
