('1981', 'A8172', 'Vila Sanches- apto 100 m2 com 3 quartos(suite), armários, sacada, coz.plan, 2 vgs garagem', 'xa8172', '1', '1', '', '<p><span style=\"font-size: 13.68px;\">O apto na Vila Sanches tem:</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- 100 m2 de área útil</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- 3 quartos sendo 1 suite com armários</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- banheiros com box/gabinete</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- área de fitness</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- parquinho infantil</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- espaço para festas</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- piscina adulto/infantil</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- churrasqueira</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- elevador</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- aceita financiamento</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- não aceita permutas</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- ótima localização, proximo ao Centervale, Supermercado, Rod. Dutra<br /><br />Condomínio R$560,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/A8172 1.jpg\",\"alt_text\":\"A8172 1.jpg\"},\"gallery16\":{\"photo\":\"images/gallery/A8172 16.jpg\",\"alt_text\":\"A8172 16.jpg\"},\"gallery12\":{\"photo\":\"images/gallery/A8172 12.jpg\",\"alt_text\":\"A8172 12.jpg\"},\"gallery18\":{\"photo\":\"images/gallery/A8172 18.jpg\",\"alt_text\":\"A8172 18.jpg\"},\"gallery24\":{\"photo\":\"images/gallery/A8172 25.jpg\",\"alt_text\":\"A8172 25.jpg\"},\"gallery17\":{\"photo\":\"images/gallery/A8172 17.jpg\",\"alt_text\":\"A8172 17.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/A8172 2.jpg\",\"alt_text\":\"A8172 2.jpg\"},\"gallery22\":{\"photo\":\"images/gallery/A8172 22.jpg\",\"alt_text\":\"A8172 22.jpg\"},\"gallery3\":{\"photo\":\"images/gallery/A8172 3.jpg\",\"alt_text\":\"A8172 3.jpg\"}