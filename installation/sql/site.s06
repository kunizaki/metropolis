('1934', 'A8145', 'Jd. Aquarius- Apto 105 m2 com 3 quartos(suite), sacada, coz.plan, 2 vgs gar, lazer completo', 'xa8145', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">- Apartamento com 105 metros no Jardim Aquarius/Ed Atlanta</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 3 dormitórios sendo uma suíte</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Com Armários</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sala Ampla com sacada</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Cozinha planejada</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Área de serviço</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Apartamento com vista para o por do sol</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 02 vagas com garagem cobertas</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 01 Playground</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 01 Quadra</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 01 Piscina</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 01 Churrasqueira</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 01 Salão de festa</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 01 Salão de jogos</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Aceita financiamento e FGTS</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Documentação ok.<br /><br />Condomínio R$550,00     IPTU R$1300,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A8145 1.JPG\",\"alt_text\":\"A8145 1.JPG\"}}', 'sell', '', '780000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Parque Residencial Aquarius', '-23.211399,-45.908761', '12246-002', '105', '3', '2', '2', '', '0', '[\"8\",\"9\",\"12\",\"16\",\"18\",\"21\",\"22\",\"23\",\"24\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2024-10-28 00:00:00', '783', '2024-10-31 10:34:05', '0', NULL),
('1935', 'A8154', 'Jd. Sul/ Cond Maxximo Resort 75 m2- 2 quartos(ste), coz.plan, sacada, ar-cond, 2 gar, lazer completo', 'xa8154', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">O apto está localizado no Jardim Sul, Condominio Maxximo Resort:</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> - 2 Dorms sendo uma suite</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Varanda com fechamento em vidros</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Boxes nos 2 banheiros até o teto</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Ar condicionado na suíte e no quarto</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Piso Porcelanato em tudo</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Varanda aberta pra sala</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Pedra granito São Gabriel com cooktop instalado e Coifa</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Todo Rebaixado em gesso com sancas luz indireta</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Cortineiros iluminados, repleto de iluminação</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Condomínio completíssimo lazer total</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- SPA com Sala de Massagem uso por agendamento</span></p>\r\n<p><span style=\"font-size: 12.16px;\">-  Espaço de Beleza</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Salão de Festas Adulto e Infantil</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Pista de Boliche automática</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Salão Gourmet</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Salão Pizza</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Mini Mercado</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Área de fitness</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Espaço gourmet</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Espaço jardinado</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Parquinho com dife