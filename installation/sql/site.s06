('1985', 'A5858', 'Vila Betânia- 3 dorms(suite)+armários, sacada, coz.planejada, 1 vaga garagem', 'xa5858', '1', '1', '', '<p><span style=\"font-size: 13.68px;\">O apto na Vila Betânia tem 98 m2 com:</span></p>\r\n<p><span style=\"font-size: 13.68px;\"> </span></p>\r\n<p><span style=\"font-size: 13.68px;\">- 3 quartos sendo 1 suite todos com armários</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- sala dois ambientes com sacada</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- banheiro da suite, social e de serviço</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- cozinha planejada</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- uma vaga de garagem </span></p>\r\n<p><span style=\"font-size: 13.68px;\">- elevador</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- piscina</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- salão de festas</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- sala de jogos</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- perto de vários comércios/ótima localização<br /><br />Condomínio R$600,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/A5858 0.JPG\",\"alt_text\":\"A5858 0.JPG\"},\"gallery13\":{\"photo\":\"images/gallery/A5858 13.JPG\",\"alt_text\":\"A5858 13.JPG\"},\"gallery5\":{\"photo\":\"images/gallery/A5858 5.JPG\",\"alt_text\":\"A5858 5.JPG\"},\"gallery12\":{\"photo\":\"images/gallery/A5858 12.JPG\",\"alt_text\":\"A5858 12.JPG\"},\"gallery6\":{\"photo\":\"images/gallery/A5858 6.JPG\",\"alt_text\":\"A5858 6.JPG\"},\"gallery19\":{\"photo\":\"images/gallery/A5858 19.JPG\",\"alt_text\":\"A5858 19.JPG\"},\"gallery20\":{\"photo\":\"images/gallery/A5858 20.JPG\",\"alt_text\":\"A5858 20.JPG\"},\"gallery9\":{\"photo\":\"images/gallery/A5858 9.JPG\",\"alt_text\":\"A5858 9.JPG\"},\"gallery3\":{\"photo\":\"images/gallery/A5858 3.JPG\",\"alt_text\":\"A5858 3.JPG\"},\"gallery17\":{\"photo\":\"images/gallery/A5858 17.JPG\",\"alt_text\":\"A5858 17.JPG\"},\"gallery11\":{\"photo\":