('2043', 'A8210', 'Pq Industrial- Apto 60 m2 com 2 quartos(suite), sacada, coz.plan, 2 vgs garagem', 'xa8210', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">O apto no Parque Industrial tem 60 m2 com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 Dormitórios (1 suíte)</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sala dois ambientes ampliada com sacada</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Cozinha planejada</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Banheiro</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Área de serviço</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Duas vagas de garagem (1 subsolo e 1 alugada do próprio condomínio)</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Planejados na suíte</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Planejados na cozinha</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Banheiro social com box/gabinete</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Vista livre p/ Dutra e Serra da Mantiqueira (sol da tarde)</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">Lazer no Condomínio:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Duas Churrasqueiras</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Salão de festas</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Salão de jogos</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Academia</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Elevador para mais praticidade no dia-a-dia</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Condomínio: R$590,00</span></p>\r\n<p><span style=\"font-size: 12.16px;\">IPTU: R$680,00</span></p>\r\n<p> </p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/A8210 9.jpg\",\"alt_text\":\"A8210 9.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/A8210 1.jpg\",\"alt_text\":\"A8210 1.jpg\"},\"gallery3\":{\"photo\":\"images/gallery/A8210 14.jpg\",\"alt_text\":\