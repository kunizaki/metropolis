('2086', 'C3723', 'Jd. das Indústrias - 197 m2 com 2 quartos(suite), coz.planejada, edícula, piscina, 2 vgs garagem.', 'xc3723', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">A casa térrea no Jardim das Indústrias tem 197 m2 com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 quartos sendo 1 suite</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- ampla sala</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- cozinha com armários</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- banheiros com box/gabinete</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> - piscina</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- edícula com quarto/banheiro</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 vagas de garabem</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- avalia troca com casa térrea somente nos bairros ( Jardim das Indústrias ou Parque Industrial)</span></p>\r\n<p> </p>', '', NULL, NULL, '{\"gallery2\":{\"photo\":\"images/gallery/C3723 1.jpeg\",\"alt_text\":\"C3723 1.jpeg\"},\"gallery3\":{\"photo\":\"images/gallery/C3723 8.jpeg\",\"alt_text\":\"C3723 8.jpeg\"},\"gallery5\":{\"photo\":\"images/gallery/C3723 3.jpeg\",\"alt_text\":\"C3723 3.jpeg\"},\"gallery4\":{\"photo\":\"images/gallery/C3723 2.jpeg\",\"alt_text\":\"C3723 2.jpeg\"},\"gallery6\":{\"photo\":\"images/gallery/C3723 4.jpeg\",\"alt_text\":\"C3723 4.jpeg\"},\"gallery10\":{\"photo\":\"images/gallery/C3723 11.jpeg\",\"alt_text\":\"C3723 11.jpeg\"},\"gallery7\":{\"photo\":\"images/gallery/C3723 5.jpeg\",\"alt_text\":\"C3723 5.jpeg\"},\"gallery12\":{\"photo\":\"images/gallery/C3723 13.jpeg\",\"alt_text\":\"C3723 13.jpeg\"},\"gallery14\":{\"photo\":\"images/gallery/C3723 15.jpeg\",\"alt_text\":\"C3723 15.jpeg\"},\"gallery13\":{\"photo\":\"images/gallery/C3723 14.jpeg\",\"alt_text\":\"C3723 14.jpeg\"},\"gallery15\":{\"photo\":\"images/gallery/C3723 16.jpeg\",\"alt_text\":\"C3723 16.jpeg\"},\"gallery17\":{\"photo\":\"images/gallery/C3723 18.jpeg\",\"alt_text\":\"