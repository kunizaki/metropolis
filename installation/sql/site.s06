('1988', 'A8173', 'Vila Adyana- Apto 120 m2 / 3 quartos(suite), arms, coz. plan, quarto/banh serviço, 1 vg garagem', 'xa8173', '1', '1', '', '<p><span style=\"font-size: 13.68px;\">O apto na Vila Adyana tem 120 m2 com:</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- totalmente reformado rede elétrica/hidráulica e armários</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- 3 quartos sendo 1 suite todos com armários</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- banheiro da suite, social e de serviço com box/gabinete</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- cozinha planejada repleta de armários</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- quarto de serviço</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- 3 elevadores</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- churrasqueira</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- salão de festas</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- sala de jogos</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- perto de vários comércios/ótima localização</span></p>\r\n<p><span style=\"font-size: 13.68px;\">- não aceita permuta<br /><br />Condomínio R$700,00     IPTU R$1000,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/a.jpg\",\"alt_text\":\"a.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/b 1.jpg\",\"alt_text\":\"b 1.jpg\"},\"gallery19\":{\"photo\":\"images/gallery/e 4.jpg\",\"alt_text\":\"e 4.jpg\"},\"gallery35\":{\"photo\":\"images/gallery/IMG-20250206-WA0010.jpg\",\"alt_text\":\"IMG-20250206-WA0010.jpg\"},\"gallery16\":{\"photo\":\"images/gallery/e 1.jpg\",\"alt_text\":\"e 1.jpg\"},\"gallery34\":{\"photo\":\"images/gallery/IMG-20250206-WA0009.jpg\",\"alt_text\":\"IMG-20250206-WA0009.jpg\"},\"gallery13\":{\"photo\":\"images/gallery/d 4.jpg\",\"alt_text\":\"d 4.jpg\"},\"gallery17\":{\"photo\":\"images/gallery/e 2.jpg\",\"alt_text\":\"e 2.jpg\"},\"gallery12\":{\"photo\":\"images/gallery/d 3.jpg\",\"alt_text\":\"d 3.jpg\"},\"g