('2089', 'C3720', 'Residencial Mantiqueira- Sobrado 252 m2 com 3 quartos(suite), arms, coz.plan, churrasq, 2 vg garagem', 'xc3720', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">O sobrado no Condomínio Residencial Mantiqueira tem 252 m2 com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 3 quartos sendo 1 suite com armários</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sala com lavabo</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- cozinha planejada</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- churrasqueira</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- banheiro de serviço</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- banheiros com box/gabinete</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- parquinho infantil</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- espaço gourmet.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- quadra poliesportiva</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- quiosque com churrasqueira</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- lago para pesca</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- mata</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- trilha</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- mirante</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- avalia permuta até 50% do valor</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Condomínio: R$560,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/C3720 1.jpg\",\"alt_text\":\"C3720 1.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/C3720 2.jpg\",\"alt_text\":\"C3720 2.jpg\"},\"gallery3\":{\"photo\":\"images/gallery/C3720 3.jpg\",\"alt_text\":\"C3720 3.jpg\"},\"gallery13\":{\"photo\":\"images/gallery/C3720 13.jpg\",\"alt_text\":\"C3720 13.jpg\"},\"gallery14\":{\"photo\":\"images/gallery/C3720 14.jpg\",\"alt_text\":\"C3720 14.jpg\"},\"gallery4\":{\"photo\":\"images/gallery/C3720 4.jpg\",\"alt_text\":\"C3720 4.jpg\"},\"gallery5\":{\"photo