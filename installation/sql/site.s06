('1964', 'C3669', 'Santana- casa de 144 m2 com 2 quartos, sala, cozinha, quintal, 1 vaga de garagem', 'xc3669', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">A casa está localizada em Santana tem:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 144 m2 de área em lote de 200m2</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 quartos</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 1 banheiro</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 1 vaga de garagem</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- analisa permuta com imóvel de menor valor</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/C3669 1.jpg\",\"alt_text\":\"C3669 1.jpg\"},\"gallery5\":{\"photo\":\"images/gallery/C3669 5.jpg\",\"alt_text\":\"C3669 5.jpg\"},\"gallery6\":{\"photo\":\"images/gallery/C3669 6.jpg\",\"alt_text\":\"C3669 6.jpg\"},\"gallery4\":{\"photo\":\"images/gallery/C3669 4.jpg\",\"alt_text\":\"C3669 4.jpg\"},\"gallery3\":{\"photo\":\"images/gallery/C3669 3.jpg\",\"alt_text\":\"C3669 3.jpg\"},\"gallery7\":{\"photo\":\"images/gallery/C3669 7.jpg\",\"alt_text\":\"C3669 7.jpg\"},\"gallery11\":{\"photo\":\"images/gallery/C3669 11.jpg\",\"alt_text\":\"C3669 11.jpg\"},\"gallery8\":{\"photo\":\"images/gallery/C3669 8.jpg\",\"alt_text\":\"C3669 8.jpg\"},\"gallery10\":{\"photo\":\"images/gallery/C3669 10.jpg\",\"alt_text\":\"C3669 10.jpg\"},\"gallery14\":{\"photo\":\"images/gallery/C3669 14.jpg\",\"alt_text\":\"C3669 14.jpg\"},\"gallery13\":{\"photo\":\"images/gallery/C3669 13.jpg\",\"alt_text\":\"C3669 13.jpg\"},\"gallery12\":{\"photo\":\"images/gallery/C3669 12.jpg\",\"alt_text\":\"C3669 12.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/C3669 2.jpg\",\"alt_text\":\"C3669 2.jpg\"},\"gallery9\":{\"photo\":\"images/gallery/C3669 9.jpg\",\"alt_text\":\"C3669 9.jpg\"},\"gallery17\":{\"photo\":\"images/gallery/C3669 17.jpg\",\"alt_text\":\"C3669 17.jpg\"},\"gallery15\":{\"photo\":\"images/gallery/C3669 15.jpg\",\"alt_text\":\"C3669 15.jp