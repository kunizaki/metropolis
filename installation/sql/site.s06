('2039', 'A8208', 'Terra Brasilis- Apto 48 m2 com 2 quartos, cozinha planejada, 1 vg garagem, lazer, piscina', 'xa8208', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">O apto no Terra Brasilis tem 48 m2 com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 quartos</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- cozinha planejada</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sala com teto rebaixado</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- piso laminado nos quartos e sala</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- banheiro com box/gabinete</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- elevador</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- salão de jogos</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- brinquedoteca</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- academia</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- bicicletário</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- piscina</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- parquinho</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- salão de festas com freezer, mesas, cadeiras, fogão e micro-ondas</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- churrasqueiras com geladeira, mesa e banco</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 1 vaga de garagem</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 14 vagas para visitante</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- vagas para motos</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- área de fitness.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Condomínio: R$380,00<br />IPTU: R$550,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/A8208 2.jpeg\",\"alt_text\":\"A8208 2.jpeg\"},\"gallery2\":{\"photo\":\"images/gallery/A8208 1.jpeg\",\"alt_text\":\"A8208 1.jpeg\"},\"gallery3\":{\"photo\":\"images/gallery/A8208 2.jpg\",\"alt_text\":\"A8208 2.jpg\"},\"gallery4\":{\"photo\":\"images/gall