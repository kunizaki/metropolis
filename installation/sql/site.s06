('1979', 'A2386', 'Imóvel para venda tem 43 metros quadrados com 1 quarto em Vila Adyana - São José dos Campos - SP', 'xa2386', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">Apartamento Reformado na Vila Adyana de AU de 43m2, com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 1 Dormitório e armário embutido</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sala com sacada e sol da tarde</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Cozinha planejada</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Banheiro com box/gabinete</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 1 vaga de garagem</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Portaria 24h</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Piscina adulto/infantil</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Churrasqueira</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Salão de Festas</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Salão de festas</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Academia</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sauna</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Ótima localização, perto de restaurantes e vários outros comércios. </span></p>\r\n<p><span style=\"font-size: 12.16px;\">Entre dois parques, o Santos Dumont e o Vicentina Aranha.</span></p>\r\n<p> </p>\r\n<p><span style=\"font-size: 12.16px;\">Condomínio R$750,00     IPTU R$550,00</span></p>', '', NULL, NULL, '{\"gallery16\":{\"photo\":\"images/gallery/A7289 0.jpg\",\"alt_text\":\"A7289 0.jpg\"},\"gallery18\":{\"photo\":\"images/gallery/A2386 2.jpg\",\"alt_text\":\"A2386 2.jpg\"},\"gallery17\":{\"photo\":\"images/gallery/A2386 1.jpg\",\"alt_text\":\"A2386 1.jpg\"},\"gallery19\":{\"photo\":\"images/gallery/A2386 3.jpg\",\"alt_text\":\"A2386 3.jpg\"},\"gallery28\":{\"photo\":\"images/gallery/A2386 12.jpg\",\"alt_text\":\"A2386 12.jpg\"},\"gallery27\":{\"photo\":\"images/gallery/A2386 11.jpg\",\"alt_text\":\"A2386