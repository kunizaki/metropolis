('2053', 'A8217', 'Jd. Esplanada- Apto 94 m2 com 3 quartos(ste), sacada, coz.plan, 2 vgs / lazer completo', 'xa8217', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">O apto no Jardim Esplanada tem 94 m2 com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 3 quartos sendo 1 suite</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sala com sacada</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- cozinha planejada</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- banheiros com box/gabinete</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 vagas de garaegem</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- área de fitness</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- jardim</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- playground</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sala para festas</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- piscina</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- quadra poliesportiva</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- churrasqueira</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- elevador</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- avalia permuta de até 350 mil em Ubatuba,  ou Massaguacu</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- em Sjc avalia permuta por apartamento até 50% do valor</span></p>\r\n<p>Condomínio: R$700,00</p>\r\n<p>IPTU: R$1500,00 ano</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/a.jpg\",\"alt_text\":\"a.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/b 2.jpg\",\"alt_text\":\"b 2.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/e 1.jpg\",\"alt_text\":\"e 1.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/IMG-20250409-WA0005.jpg\",\"alt_text\":\"IMG-20250409-WA0005.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/IMG-20250409-WA0011.jpg\",\"alt_text\":\"IMG-20250409-WA0011.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/IMG-20250409-WA0013.jpg\",\"alt_text\":