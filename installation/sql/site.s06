('2025', 'C3705', 'Bosque dos Eucaliptos- Sobrado geminado de 95 m2 com 4 quartos(suite), coz.plan, 2 vgs garagem', 'xc3705', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">O sobrado no Bosque dos Eucaliptos tem 95 m2 com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">No Térreo </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 quartos</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sala</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Cozinha</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Banheiro</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">Superior</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Escritório (ou quarto)</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Suíte </span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- pintura completa refeita recentemente. </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- banheiros reformados.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- garagem pra 2 carros.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- permuta por imóvel na zona sul  de até 350 mil</span></p>\r\n<p> </p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/C3705 1.jpg\",\"alt_text\":\"C3705 1.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/C3705 6.jpg\",\"alt_text\":\"C3705 6.jpg\"},\"gallery3\":{\"photo\":\"images/gallery/C3705 2.jpg\",\"alt_text\":\"C3705 2.jpg\"},\"gallery14\":{\"photo\":\"images/gallery/C3705 14.jpg\",\"alt_text\":\"C3705 14.jpg\"},\"gallery9\":{\"photo\":\"images/gallery/C3705 8.jpg\",\"alt_text\":\"C3705 8.jpg\"},\"gallery6\":{\"photo\":\"images/gallery/C3705 5.jpg\",\"alt_text\":\"C3705 5.jpg\"},\"gallery5\":{\"photo\":\"images/gallery/C3705 4.jpg\",\"alt_text\":\"C3705 4.jpg\"},\"gallery12\":{\"photo\":\"images/gallery/C3705 12.jpg\",\"alt_text\":\"C3705 12.jpg\"},\"galle