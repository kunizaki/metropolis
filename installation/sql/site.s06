('1966', 'C3668', 'Bosque dos Ipês- Sobrado de 157 m2 com 3 quartos(suite), coz.planejada, sacada, 2 vgs garagem', 'xc3668', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">O sobrado está localizado Residencial Bosque dos Ipês possui 157m2 com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 3 quartos sendo 1 suite com sacada</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 banheiros com box/gabinete</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sala ampla</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- cozinha planejada</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 vagas de garagem</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- analisa permuta com carro</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/C3668 0.jpg\",\"alt_text\":\"C3668 0.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/C3668 1.jpg\",\"alt_text\":\"C3668 1.jpg\"},\"gallery8\":{\"photo\":\"images/gallery/C3668 8.jpg\",\"alt_text\":\"C3668 8.jpg\"},\"gallery10\":{\"photo\":\"images/gallery/C3668 10.jpg\",\"alt_text\":\"C3668 10.jpg\"},\"gallery9\":{\"photo\":\"images/gallery/C3668 9.jpg\",\"alt_text\":\"C3668 9.jpg\"},\"gallery3\":{\"photo\":\"images/gallery/C3668 3.jpg\",\"alt_text\":\"C3668 3.jpg\"},\"gallery7\":{\"photo\":\"images/gallery/C3668 7.jpg\",\"alt_text\":\"C3668 7.jpg\"},\"gallery4\":{\"photo\":\"images/gallery/C3668 4.jpg\",\"alt_text\":\"C3668 4.jpg\"},\"gallery5\":{\"photo\":\"images/gallery/C3668 5.jpg\",\"alt_text\":\"C3668 5.jpg\"},\"gallery12\":{\"photo\":\"images/gallery/C3668 12.jpg\",\"alt_text\":\"C3668 12.jpg\"},\"gallery6\":{\"photo\":\"images/gallery/C3668 6.jpg\",\"alt_text\":\"C3668 6.jpg\"},\"gallery11\":{\"photo\":\"images/gallery/C3668 11.jpg\",\"alt_text\":\"C3668 11.jpg\"}}', 'sell', '', '610000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Residencial Bosque dos Ipês', '-23.256114,-45.895651', '12236-880', '157', '3', '2', '2', '', '0', NULL, '', '', '', '{}', '1'