('1999', 'C3692', 'Cond. Rudá- Sobrado de 311 m2 / 5 quartos(3 suites), coz.planejada, área gourmet, piscina, 2 vgs gar', 'xc3692', '7', '1', '', '<p>O sobrado no Loteamento Floresta, condominio Floresta tem 311m2 com:</p>\r\n<p>- 5 quartos sendo 3 suites e 5 banheiros</p>\r\n<p>- design elegante e acabamento impecável</p>\r\n<p>- garagem para 2 carros</p>\r\n<p>- área gourmet completa (churrasqueira e Forno de Pizza)</p>\r\n<p>- piscina</p>\r\n<p>- cozinha Planejada</p>\r\n<p>- despensa</p>\r\n<p>- pé direito Duplo</p>\r\n<p>- vista livre</p>\r\n<p>- boiler</p>\r\n<p>- infra Ar condicionado</p>\r\n<p> </p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/C3692 1.jpg\",\"alt_text\":\"C3692 1.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/C3692 2.jpg\",\"alt_text\":\"C3692 2.jpg\"},\"gallery9\":{\"photo\":\"images/gallery/C3692 9.jpg\",\"alt_text\":\"C3692 9.jpg\"},\"gallery12\":{\"photo\":\"images/gallery/C3692 12.jpg\",\"alt_text\":\"C3692 12.jpg\"},\"gallery11\":{\"photo\":\"images/gallery/C3692 11.jpg\",\"alt_text\":\"C3692 11.jpg\"},\"gallery8\":{\"photo\":\"images/gallery/C3692 8.jpg\",\"alt_text\":\"C3692 8.jpg\"},\"gallery4\":{\"photo\":\"images/gallery/C3692 4.jpg\",\"alt_text\":\"C3692 4.jpg\"},\"gallery5\":{\"photo\":\"images/gallery/C3692 5.jpg\",\"alt_text\":\"C3692 5.jpg\"},\"gallery3\":{\"photo\":\"images/gallery/C3692 3.jpg\",\"alt_text\":\"C3692 3.jpg\"},\"gallery7\":{\"photo\":\"images/gallery/C3692 7.jpg\",\"alt_text\":\"C3692 7.jpg\"},\"gallery10\":{\"photo\":\"images/gallery/C3692 10.jpg\",\"alt_text\":\"C3692 10.jpg\"},\"gallery6\":{\"photo\":\"images/gallery/C3692 6.jpg\",\"alt_text\":\"C3692 6.jpg\"}}', 'sell', '', '2250000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'SJCampos', 'Loteamento Floresta', '0,0', '12226-391', '311', '5', '5', '2', '', '0', '[\"8\",\"9\",\"12\",\"16\",\"17\",\"21\",\"23\",\"27\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2025-03-20 00:00:00', '783', '2025-03-21 10:30:07', '0', NULL),
('2002', 'A8188', 'Jd. Das Industrias- Mirante Limoeiro de 44 m2 com 2 quartos, 1 vg de garagem', 'xa8188', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">O apto está localizado no Jardim das Indústrias tem 44 m2 com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 quartos</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sala</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- cozinha</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 1 banheiro com box</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 1 vaga de garagem</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- playground</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- não aceita permuta</span></p>\r\n<p>Condomínio: R$190,00</p>', '', NULL, NULL, '{\"gallery6\":{\"photo\":\"images\\/gallery\\/A8188 0.jpg\",\"alt_text\":\"A8188 0.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/A8188 2.jpg\",\"alt_text\":\"A8188 2.jpg\"},\"gallery14\":{\"photo\":\"images\\/gallery\\/A8188 7.jpg\",\"alt_text\":\"A8188 7.jpg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/A8188 6.jpg\",\"alt_text\":\"A8188 6.jpg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/A8188 5.jpg\",\"alt_text\":\"A8188 5.jpg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/A8188 3.jpg\",\"alt_text\":\"A8188 3.jpg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/A8188 4.jpg\",\"alt_text\":\"A8188 4.jpg\"},\"gallery15\":{\"photo\":\"images\\/gallery\\/A8188 0A.jpg\",\"alt_text\":\"A8188 0A.jpg\"},\"gallery16\":{\"photo\":\"images\\/gallery\\/A8188 1.jpg\",\"alt_text\":\"A8188 1.jpg\"}}', 'sell', '', '195000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'SJCampos', 'Jardim das Indústrias', '0,0', '12241-040', '44', '2', '1', '1', '', '0', '[\"8\",\"21\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2025-03-17 00:00:00', '783', '2025-03-21 12:12:43', '0', NULL),
('2003', 'C3684', 'Bosque dos Eucaliptos- casa de 125 m2 com 3 quartos(suite), arms, coz.plan, placa solar, 2 vgs gar', 'xc3684', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">A casa térrea no Bosque dos Eucaliptos tem 125 m2 com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 3 quartos sendo 1 suite com armários embutidos</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> - cozinha integrada com pé direito de 3,70m com ilha e mesa embutida</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- área gourmet</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- garagem para 2 carros</span></p>\r\n<p><span style=\"font-size: 12.16px;\">-  lavanderia e porão</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- todos ambientes com móveis planejados</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- aquecimento de água por placa solar em todas as torneiras ( exceto lavanderia e garagem) </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- terreno de 5x25 (125m²)</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- área construída de 124,72m²</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- em rua sem saída</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- próximo a escola adventista e Av. Cidade Jardim</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- permuta por terreno nos cond reserva Ruda ou Aruanã</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- ainda possui financiamento de R$160mil</span></p>\r\n<p> </p>', '', NULL, NULL, '{\"gallery14\":{\"photo\":\"images/gallery/638562608246213.jpg\",\"alt_text\":\"638562608246213.jpg\"},\"gallery15\":{\"photo\":\"images/gallery/637529240484312.jpg\",\"alt_text\":\"637529240484312.jpg\"},\"gallery18\":{\"photo\":\"images/gallery/586554727851958.jpg\",\"alt_text\":\"586554727851958.jpg\"},\"gallery16\":{\"photo\":\"images/gallery/444575362748283.jpg\",\"alt_text\":\"444575362748283.jpg\"},\"gallery19\":{\"photo\":\"images/gallery/587505121134668.jpg\",\"alt_text\":\"5875051211