('57', 'C2879', 'Jd. Bela Vista- 3 Dormitórios (suite)', 'jd-bela-vista', '2', '0', '', '<p>Sobrado de 03 dormitórios sendo 01 suite e sacada, armários embutidos, sala 2 ambientes com piso em granito/frio, cozinha com pia, gabinete e armários, churrasqueira, wc de empregada, garagem coberta p/ 02 veículos.</p>\r\n<div id=\"icpbravoaccess_loaded\"> </div>\r\n<div id=\"icpbravoaccess_loaded\"> </div>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/c2879.jpg\",\"alt_text\":\"c2879.jpg\"}}', 'sell', '', '850000.00', 'short', 'left', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos-SP', 'Jd. Bela Vista', '-236396479,-466505173', '', '212', '3', '3', '2', '', '0', '[\"12\",\"17\"]', '', '', '', '{}', '1', '*', '1', '383', '782', '2020-02-24 00:00:00', '783', '2021-02-02 16:32:20', '0', NULL),
