('797', 'C3247', 'Alphaville II - Sobrado: 4D (4 Suítes); 6 Banheiros; Closet; Piscina; Churrasqueira; Varanda; 2 Vagas com Hobby Box. ', 'xc3247', '7', '1', '', '<div class=\"spproperty-short-overview-text\">\r\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\"><span style=\"box-sizing: border-box; z-index: 2;\">Sobrado de 04 Dormitórios, sendo todos suítes, 06 Banheiros, Closet, Escritório, Ar Condicionado, Varanda, Piscina, Área Gourmet, Quarto de serviço,</span> <span style=\"box-sizing: border-box; z-index: 2;\">Área de serviço, </span><span class=\"sc-1sj3nln-1 eOSweo sc-ifAKCX cmFKIN\">Piso de madeira na área privada e porcelanato Portinari na área social,</span><span class=\"sc-1sj3nln-1 eOSweo sc-ifAKCX cmFKIN\"> Garagem para 4 carros, sendo 2 cobertas.</span></p>\r\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\"> </p>\r\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\"><span class=\"sc-1sj3nln-1 eOSweo sc-ifAKCX cmFKIN\"> Sistema de automação, áudio na área gourmet e piscina, áudio na suíte master, banheira tipo ofurô dupla com hidro, aquecedor solar, sistema de monitoramento interno e externo com câmeras, sistema de internet com antenas em toda casa, infra sistema de aspiração central. </span></p>\r\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\"> </p>\r\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\">Condomínio com excelente área de lazer com salão de festas, sala de ginástica, piscina, brinquedoteca, quadras, etc.</p>\r\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\"> </p>\r\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\"><span style=\"box-sizing: border-box; z-index: 2;\">Condomínio fechado com segurança 24h. R$ 700<br /></span></p>\r\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\"> </p>\r\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\"><span class=\"sc-1sj3nln-1 eOSweo sc-ifAKCX cmFKIN\"> </span></p>\r\n</div>', '', NULL, NULL, '{\"gallery2\":{\"photo\":\"images\\/gallery\\/C3247 2.jpg\",\"alt_text\":\"C3247 2.jpg\"},\"gallery1\":{\"photo\":\"images\\/gallery\\/C3247 1.jpg\",\"alt_text\":\"C3247 1.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/C3247 3.jpg\",\"alt_text\":\"C3247 3.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/C3247 4.jpg\",\"alt_text\":\"C3247 4.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/C3247 5.jpg\",\"alt_text\":\"C3247 5.jpg\"}}', 'sell', '', '3500000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Urbanova', '-23.178321,-45.941035', '12244035', '385', '4', '6', '2', '', '0', '[\"8\",\"9\",\"12\",\"15\",\"17\",\"25\",\"27\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2021-11-23 00:00:00', '783', '2023-12-22 17:49:42', '0', NULL),
