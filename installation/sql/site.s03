('506', 'A7385', 'Parque Industrial- Apto 2 Dorms, 2 Banh, Cozinha planejada, Sala c/ Sacada, 1 vg Gar', 'xa7385', '1', '1', '', '<p><span style=\"box-sizing: border-box; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\">Apartamento de 02 Dormitórios, 02 Banheiros; Cozinha com armários planejados;</span><span style=\"box-sizing: border-box; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\"> Área de Serviço; Sala com Sacada. 01 vaga de Garagem</span></p>\r\n<p><span style=\"box-sizing: border-box; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\"> Área de lazer do Condomínio com Salão de Festas, Churrasqueira e Academia. Condomínio fechado e Segurança 24h. Condomínio R$305</span></p>', '', NULL, NULL, '{\"gallery8\":{\"photo\":\"images\\/gallery\\/A7385 1.jpg\",\"alt_text\":\"A7385 1.jpg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/A7385 2.jpg\",\"alt_text\":\"A7385 2.jpg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/A7385 3.jpg\",\"alt_text\":\"A7385 3.jpg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/A7385 4.jpg\",\"alt_text\":\"A7385 4.jpg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/A7385 6.jpg\",\"alt_text\":\"A7385 6.jpg\"},\"gallery15\":{\"photo\":\"images\\/gallery\\/A7385 8.jpg\",\"alt_text\":\"A7385 8.jpg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/A7385 5.jpg\",\"alt_text\":\"A7385 5.jpg\"},\"gallery14\":{\"photo\":\"images\\/gallery\\/A7385 7.jpg\",\"alt_text\":\"A7385 7.jpg\"}}', 'sell', '', '350000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Parque Industrial\r\n', '-23.239489,-45.906556', '12235625', '64', '2', '2', '1', '', '0', '[\"8\",\"12\",\"16\",\"17\",\"18\",\"22\"]', '', '', '', '{}', '1', '*', '1', '180', '783', '2021-06-04 00:00:00', '783', '2021-06-23 17:51:49', '0', NULL),
('510', 'T1126', 'Condomínio Reserva do Paratehy - Lote de 900 m2', 'xt1126', '6', '1', '', '<p>Lote no Cond Reserva do Paratehy de 900m2 com calçada feita. Ótima área de lazer com quadra de futebol, salão de festas, churrasqueira, playground e quadra de tênis sendo construída. Fibra Óptica, Gás, água e energia pública, tudo embutido. Bosque Natural e lago. Condomínio de R$ 1010,00</p>', '', NULL, NULL, '{\"gallery5\":{\"photo\":\"images\\/gallery\\/T1126 1.jpg\",\"alt_text\":\"T1126 1.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/T1126 3.jpg\",\"alt_text\":\"T1126 3.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/T1126 4.jpg\",\"alt_text\":\"T1126 4.jpg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/T1126 5.jpg\",\"alt_text\":\"T1126 5.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/T1126 2.jpg\",\"alt_text\":\"T1126 2.jpg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/T1126 6.jpg\",\"alt_text\":\"T1126 6.jpg\"}}', 'sell', '', '1550000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Condomínio Reserva do Paratehy\r\n', '-23.191791,-45.958698', '12244544', '900', '0', '0', '0', '', '0', '[\"12\",\"16\",\"21\",\"23\"]', '', '', '', '{}', '1', '*', '1', '184', '783', '2021-06-04 00:00:00', '783', '2023-05-11 16:02:26', '0', NULL),
('511', 'A7389', 'Cond Spazio Campo Azuli- Apto Cobertura 2 Dorms (1 Ste), 3 Banh, Coz planejada, Arms Embutidos, 1 vg Gar', 'xa7389', '1', '1', '', '<p><span style=\"box-sizing: border-box; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\">Apartamento de 02 Dormitórios, sendo 01 Suíte; 03 Banheiros; Cozinha planejada; Armários Embutidos; Varanda; Ar condicionado; </span><span style=\"color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\">Área Gourmet com Churrasqueira; </span><span style=\"color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\">Área de serviço. Piso em Porcelanato. Área de lazer do Condomínio com Salão de Festas, Academia, Piscina.  Permitido animais, Condomínio fechado e Segurança 24h. Condomínio R$450</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A7389 1.jpg\",\"alt_text\":\"A7389 1.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/A7389 2.jpg\",\"alt_text\":\"A7389 2.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/A7389 3.jpg\",\"alt_text\":\"A7389 3.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/A7389 4.jpg\",\"alt_text\":\"A7389 4.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/A7389 5.jpg\",\"alt_text\":\"A7389 5.jpg\"}}', 'sell', '', '480000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Jardim Paraiso do Sol\r\n', '-23.239658,-45.902072', '12235431', '126', '2', '3', '1', '', '0', '[\"8\",\"9\",\"12\",\"15\",\"16\",\"18\",\"22\",\"27\"]', '', '', '', '{}', '1', '*', '1', '185', '783', '2021-05-31 00:00:00', '783', '2023-12-18 18:10:04', '0', NULL),
('525', 'C3184', 'Vista Verde- Sobrado 5 Dorms(2 Ste), 4 Banh, Coz planejada, Arms Embutidos, 8 vg Gar', 'xc3184', '7', '1', '', '<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\"><span style=\"box-sizing: border-box; z-index: 2;\">Lindo Sobrado de 5 Dormitórios sendo: </span><span style=\"color: #4a4a4a; font-family: \'Nunito Sans\', \'Helvetica Neue\', HelveticaNeue, Helvetica, Arial, sans-serif; white-space: pre-line;\">Parte inferior composta por: 1 suíte com banheira e armário planejado, 2 quartos com armários planejados, sala, 1 banheiro, Cozinha ampla com armários planejados, fogão cooktop, forno elétrico e coifa embutidos, área de lavanderia ampla, Garagem coberta para 4 veículos e descoberta cabe mais 4 veículos, Quintal amplo com 2 corredores laterais, Piscina com aquecimento solar tamanho 4x6mts, Edicula com 2 quartos, banheiro e área de lazer com churrasqueira e pia. Piso frio. Além disso o imóvel contém Ar condicionado e Churrasqueira.</span></p>\r\n<p><span style=\"color: #4a4a4a; font-family: \'Nunito Sans\', \'Helvetica Neue\', HelveticaNeue, Helvetica, Arial, sans-serif; font-size: 16px; white-space: pre-line;\">  Parte Superior composto por: Sala de TV com sacada, 1 suíte ampla com sacada, banheira e closet planejado e 1 dormitório. Piso frio. Área total terreno : 520m2</span></p>\r\n<p><span style=\"color: #4a4a4a; font-family: \'Nunito Sans\', \'Helvetica Neue\', HelveticaNeue, Helvetica, Arial, sans-serif; font-size: 16px; white-space: pre-line;\">Área de Lazer do condomínio com Piscina </span></p>\r\n<p><span style=\"color: #4a4a4a; font-family: \'Nunito Sans\', \'Helvetica Neue\', HelveticaNeue, Helvetica, Arial, sans-serif; font-size: 16px; white-space: pre-line;\">Condomínio fechado Área murada, Segurança 24h, Permitido animais. Condomínio R$780</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/C3184 1.jpg\",\"alt_text\":\"C318