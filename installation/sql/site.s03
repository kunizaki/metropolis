('485', 'A7365', 'Centro/Apto de 110 m2 com 2 quartos, armários, coz. planejada, banh. serviço, Sem garagem', 'xa7365', '1', '1', '', '<p><span style=\"color: #000000; font-family: Catamaran, sans-serif;\"><span style=\"font-size: 16px;\">O apto está localizado no Centro tem 110 m2 com:</span></span></p>\r\n<p><span style=\"color: #000000; font-family: Catamaran, sans-serif;\"><span style=\"font-size: 16px;\">- 2 quartos</span></span></p>\r\n<p><span style=\"color: #000000; font-family: Catamaran, sans-serif;\"><span style=\"font-size: 16px;\">- cozinha planejada</span></span></p>\r\n<p><span style=\"color: #000000; font-family: Catamaran, sans-serif;\"><span style=\"font-size: 16px;\">- 2 banheiro social e de serviço</span></span></p>\r\n<p><span style=\"color: #000000; font-family: Catamaran, sans-serif;\"><span style=\"font-size: 16px;\">- elevador</span></span></p>\r\n<p><span style=\"color: #000000; font-family: Catamaran, sans-serif;\"><span style=\"font-size: 16px;\">- SEM vaga de garagem</span></span></p>\r\n<p><span style=\"color: #000000; font-family: Catamaran, sans-serif;\"><span style=\"font-size: 16px;\">- aceita carro como parte de pagto</span></span></p>\r\n<p><span style=\"color: #000000; font-family: Catamaran, sans-serif;\"><span style=\"font-size: 16px;\">- frente à Pca<br /><br />Condomínio R$600,00 IPTU  R$520,00</span></span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/A7365 1.jpg\",\"alt_text\":\"A7365 1.jpg\"},\"gallery3\":{\"photo\":\"images/gallery/A7365 2.jpg\",\"alt_text\":\"A7365 2.jpg\"},\"gallery16\":{\"photo\":\"images/gallery/A7365 14.jpg\",\"alt_text\":\"A7365 14.jpg\"},\"gallery4\":{\"photo\":\"images/gallery/A7365 2.jpg\",\"alt_text\":\"A7365 2.jpg\"},\"gallery14\":{\"photo\":\"images/gallery/A7365 12.jpg\",\"alt_text\":\"A7365 12.jpg\"},\"gallery13\":{\"photo\":\"images/gallery/A7365 11.jpg\",\"alt_text\":\"A7365 11.jpg\"},\"gallery15\":{\"photo\":\"images/gallery/A7365 13.jpg\",\"alt_text\":\"A7365 13.jpg\"