('1042', 'A7708', 'Vila Zizinha - Apto: 2D, 1 Banheiro; Cozinha Americana; 2 Vagas; Cond. Fechado c Lazer Completo', 'xa7708', '1', '1', '', '<div class=\"spproperty-short-overview-text\" style=\"box-sizing: border-box; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\">\r\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2;\"><span style=\"box-sizing: border-box; z-index: 2;\">Vila Zizinha - apartamento com dois dormitórios, um banheiro social e duas vagas cobertas na garagem. Cozinha americana integrada às salas de estar e de jantar. Sala de estar com iluminação de descanso. Piso inteiro em porcelanato, móveis planejados em todos os cômodos. Armários embutidos.</span></p>\r\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2;\"> </p>\r\n</div>\r\n<div class=\"spproperty-short-overview-text\" style=\"box-sizing: border-box; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\">Condomínio fechado, inclui playground, quadra poliesportiva, salão de festas com churrasqueira. Portaria 24h, permitido animais. R$ 315.</div>', '', NULL, NULL, '{\"gallery2\":{\"photo\":\"images\\/gallery\\/A7708 1.jpg\",\"alt_text\":\"A7708 1.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/A7708 3.jpg\",\"alt_text\":\"A7708 3.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/A7708 4.jpg\",\"alt_text\":\"A7708 4.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/A7708 2.jpg\",\"alt_text\":\"A7708 2.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/A7708 5.jpg\",\"alt_text\":\"A7708 5.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/A7708 6.jpg\",\"alt_text\":\"A7708 6.jpg\"}}', 'sell', '', '222500.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Rua Kenkiti Shimomoto', '-23.173551,-45.894205', '12211020', '54', '2', '1', '2', '', '0', '[\"8\",\"12\",\"16\",\"21\",\"23\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2022-03-16 00:00:00', '783', '2022-03-18 13:00