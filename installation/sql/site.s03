  `gallery_folder_name` varchar(50) DEFAULT NULL,
  `gallery` text,
  `property_status` varchar(50) DEFAULT NULL,
  `rent_period` varchar(50) DEFAULT NULL,
  `price` float(12,2) NOT NULL DEFAULT '0.00',
  `currency_format` varchar(20) DEFAULT '',
  `currency_position` varchar(20) DEFAULT '',
  `currency` varchar(50) DEFAULT '',
  `fixed_price` tinyint NOT NULL DEFAULT '0',
  `price_request` varchar(50) DEFAULT NULL,
  `agent_id` bigint DEFAULT NULL,
  `country` varchar(50) DEFAULT NULL,
  `city` varchar(155) DEFAULT NULL,
  `address` text,
  `map` text,
  `zip` varchar(50) DEFAULT '',
  `psize` int DEFAULT NULL,
  `beds` int DEFAULT NULL,
  `baths` int DEFAULT NULL,
  `garages` int DEFAULT NULL,
  `lvl_fltno` varchar(255) DEFAULT NULL,
  `building_year` int DEFAULT NULL,
  `features` text,
  `video_text` text,
  `video` text,
  `fp_text` text,
  `floor_plans` text,
  `published` tinyint NOT NULL DEFAULT '1',
  `language` char(7) NOT NULL DEFAULT '*',
  `access` int NOT NULL DEFAULT '1',
  `ordering` int NOT NULL DEFAULT '0',
  `created_by` bigint NOT NULL DEFAULT '0',
  `created` datetime DEFAULT NULL,
  `modified_by` bigint NOT NULL DEFAULT '0',
  `modified` datetime DEFAULT NULL,
  `checked_out` bigint NOT NULL DEFAULT '0',
  `checked_out_time` datetime DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=2420 DEFAULT CHARSET=utf8mb3;/*ABDE:#__spproperty_properties*/
/**ABDB**/INSERT INTO `#__spproperty_properties`  VALUES 
('17', 'A5613   ', 'Centro', 'centro', '1', '0', '', '<p>Apartamento de 02 dormitórios sendo 01 suíte, armários embutidos, piso em tacão; sala + sacada+bar; cozinha planejada; 01 vaga de garagem. Salão de festas, churrasqueira.</p>\r\n<div id=\"icpbravoaccess_loaded\"> </div>\r\n<div id=\"icpbravoaccess_loaded\"> </div>\r\n<div id=\"icpbravoaccess_loaded\"> </div>\r\n<div id=\"icpbravoaccess_loaded\"> </div>\r\n<div id=\"icpbravoaccess_loaded\"> </div>\r\n<div id=\"icpbravoaccess_loaded\"> </div>\r\n<div id=\"icpbravoaccess_loaded\"> </div>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A5613.jpg\",\"alt_text\":\"A5613.jpg\"}}', 'sell', '', '250000.00', 'short', 'left', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos-SP', 'Centro', '-23187247,-45886121', '', '70', '2', '2', '1', '', '0', '', '', '', '', '{}', '1', '*', '1', '347', '782', '2020-01-02 00:00:00', '783', '2021-02-02 16:24:01', '0', NULL),
('18', 'A5543   ', 'Jd. São Dimas - 1 Dormitório (suite) 1 gar próximo CTA e Dutra Cond R$ 1.250,00', 'jd-sao-dimas-1-dormitorio-suite-1-gar-proximo-cta-e-dutra', '1', '0', '', '<p>Apartamento mobiliado/ótima vista, de 01 dormitório com armário embutido; sala com sacada, cozinha americana com gabinete e armários; fogão, geladeira, banheiro com box/gabinete, ar condicionado, 01 vaga de garagem. Serviço de Flat. Área de lazer com piscina, salão de festas.</p>\r\n<div id=\"icpbravoaccess_loaded\"> </div>\r\n<div id=\"icpbravoaccess_loaded\"> </div>\r\n<div id=\"icpbravoaccess_loaded\"> </div>\r\n<div id=\"icpbravoaccess_loaded\"> </div>\r\n<div id=\"icpbravoaccess_loaded\"> </div>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A5543 1.JPG\",\"alt_text\":\"A5543 1.JPG\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/A5543 2.JPG\",\"alt_text\":\"A5543 2.JPG\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/A5543 7.JPG\",\"alt_text\":\"A5543 7.JPG\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/A5543 3.JPG\",\"alt_text\":\"A5543 3.JPG\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/A5543 6.JPG\",\"alt_text\":\"A5543 6.JPG\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/A5543 4.JPG\",\"alt_text\":\"A5543 4.JPG\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/A5543 9.JPG\",\"alt_text\":\"A5543 9.JPG\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/A5543 8.JPG\",\"alt_text\":\"A5543 8.JPG\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/A5543 5.JPG\",\"alt_text\":\"A5543 5.JPG\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/A5543 10.JPG\",\"alt_text\":\"A5543 10.JPG\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/A5543 11.JPG\",\"alt_text\":\"A5543 11.JPG\"}}', 'sell', '', '185000.00', 'short', 'left', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos-SP', 'Jd. São Dimas', '-23196751,-45888831', '', '52', '1', '1', '1', '', '0', '[\"8\",\"9\",\"10\",\"15\",\"16\",\"18\",\"20\"]', '', '', '', '{}', '1', '*', '1', '348', '782', '2020-01-04 00:00:00', '783'