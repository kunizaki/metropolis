('1716', 'M0873', 'Vila Nova Conceição- Galpão de 242 m2, várias salas, copa, toaletes e estacionamento.', 'xm7803', '3', '1', '', '<p>O galpão no bairro Vila Nova Conceição tem 242 m2 com várias salas com divisórias, copa, toaletes. Ideal para fabricas, armazéns, laboratório, etc. òtima localização próximo a Rodovia Dutra, Tamoios e DCTA.</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/M0873 1.jpg\",\"alt_text\":\"M0873 1.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/M0873 2.jpg\",\"alt_text\":\"M0873 2.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/M0873 15.jpg\",\"alt_text\":\"M0873 15.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/M0873 3.jpg\",\"alt_text\":\"M0873 3.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/M0873 4.jpg\",\"alt_text\":\"M0873 4.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/M0873 7.jpg\",\"alt_text\":\"M0873 7.jpg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/M0873 8.jpg\",\"alt_text\":\"M0873 8.jpg\"},\"gallery15\":{\"photo\":\"images\\/gallery\\/M0873 14.jpg\",\"alt_text\":\"M0873 14.jpg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/M0873 12.jpg\",\"alt_text\":\"M0873 12.jpg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/M0873 9.jpg\",\"alt_text\":\"M0873 9.jpg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/M0873 11.jpg\",\"alt_text\":\"M0873 11.jpg\"},\"gallery14\":{\"photo\":\"images\\/gallery\\/M0873 13.jpg\",\"alt_text\":\"M0873 13.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/M0873 5.jpg\",\"alt_text\":\"M0873 5.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/M0873 6.jpg\",\"alt_text\":\"M0873 6.jpg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/M0873 10.jpg\",\"alt_text\":\"M0873 10.jpg\"}}', 'rent', '', '5000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Vila Nova Conceição', '-23.208640, -45.886598', '12231-101', '250', '0', '2', '0', '', '0', NULL, '', '', '', '{}', '1', '*', '1', '0', '783', '2024-03-03 00:00:00', '783', '2024-03-08 13: