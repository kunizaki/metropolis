('1924', 'A8141', 'Vila Industrial-Apto 99 m2 com 3 quartos(suite), sacada, coz.plan, 2 vgs gar. Linda vista da Serra', 'xa8141', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">O apto na Vila Industrial tem área de 99 m2</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 3 quartos sendo 1 suite, todos com armários</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Banheiros com box/gabinete</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sala com sacada e lavabo</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Vista definitiva para serra</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Armários na cozinha</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 vagas de garagem cobertas </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Vagas p/ visitantes </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 3 Elevadores</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Academia</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Piscina</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Salão de festas</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Quadra</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sala de jogos </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Brinquedoteca</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Parque infantil</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Vaga p/ caminhão de mudança</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Portaria 24h</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Aceita animais</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Analisa propostas<br /><br />Condomínio R$460,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/A8141 30.jpg\",\"alt_text\":\"A8141 30.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/A8141 31.jpg\",\"alt_text\":\"A8141 31.jpg\"},\"gallery10\":{\"photo\":\"images/gallery/A8141 39.jpg\",\"alt_text\":\"A8141 39.jpg\"},\"gallery12\":{\"photo\":\"images/gal