('1921', 'C3664', 'Setville- Sobrado novo de 160 m2 com 3 quartos(3suites), sacada, 4 vgs garagem', 'xc3664', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">- Setville- sobrado de Au 160m2 em lote de 175m2</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 3 Suítes </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sacada com vista permanente </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Área gourmet </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sala integrada </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Banheiro piso térreo , Total 4 Wcs </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Piscina Aquecida</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Churrasqueira gourmet</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Lavanderia </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Iluminação inteligente </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Alexa </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Planejada com infra ar condicionado </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Bairro planejado </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Fácil acesso às Rodovias Dutra / Tamoios  / Carvalho Pinto  / Via </span></p>\r\n<p><span style=\"font-size: 12.16px;\"> Cambuí </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Aceita carro e terreno como parte de pgto</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Em fase de acabamento e entrega até 12/2024</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/C3664 1.jpg\",\"alt_text\":\"C3664 1.jpg\"},\"gallery5\":{\"photo\":\"images/gallery/C3664 5.jpg\",\"alt_text\":\"C3664 5.jpg\"},\"gallery4\":{\"photo\":\"images/gallery/C3664 4.jpg\",\"alt_text\":\"C3664 4.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/C3664 2.jpg\",\"alt_text\":\"C3664 2.jpg\"},\"gallery6\":{\"photo\":\"images/gallery/C3664 6.jpg\",\"alt_text\":\"C3664 6.jpg\"},\"gallery3\":{\"photo\":\"images/gallery/C3664 3.