('1913', 'A8133', 'Jd. Ismênia/Max Clube - 47 m2 com 2 quartos, armários, coz.planejada, 1 vg garagem', 'xa8133', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">O apto está localizado no bairro Jardim Ismênia, Condominio Max Clube:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Tem 47 m2</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 quartos com armários</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 1 banheiro com box/gabinete</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Playground</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Salão para festas</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Piscina</span></p>\r\n<p><span style=\"font-size: 12.16px;\">-Churrasqueira</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Elevador para mais praticidade no dia-a-dia.<br /><br />Condomínio R$430,00       IPTU R$680,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A8133 1.jpg\",\"alt_text\":\"A8133 1.jpg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/A8133 10.jpg\",\"alt_text\":\"A8133 10.jpg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/A8133 9.jpg\",\"alt_text\":\"A8133 9.jpg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/A8133 11.jpg\",\"alt_text\":\"A8133 11.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/A8133 5.jpg\",\"alt_text\":\"A8133 5.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/A8133 4.jpg\",\"alt_text\":\"A8133 4.jpg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/A8133 13.jpg\",\"alt_text\":\"A8133 13.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/A8133 2.jpg\",\"alt_text\":\"A8133 2.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/A8133 3.jpg\",\"alt_text\":\"A8133 3.jpg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/A8133 12.jpg\",\"alt_text\":\"A8133 12.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/A8133 8.jpg\",\"alt_text\":\"A8133 8.jpg\"},\"gallery14\":{\"photo\":\"images\\/gallery\\/A8133 14.jpg\",\"alt_text\":\"A8133 14.jpg\"},