('1846', 'A8108', 'Jd. Sul/ Cond. Jd Sul-54 m2 com 2 quartos+armários, coz.planejada, 1 vg garagem', 'xa8108', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">O Apto está localizado no bairro Jardim Sul com 54 m2 com 2 quartos e armários, cozinha planejada, banheiro com box/gabinete, 1 vaga de garagem.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Possui salão para festas e Churrasqueira para você aproveitar nos momentos de descontração. Elevador para mais praticidade no dia-a-dia.</span></p>\r\n<p> </p>\r\n<p><span style=\"font-size: 12.16px;\">Condomínio R$300,00     IPTU R$480,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A8108 18.jpg\",\"alt_text\":\"A8108 18.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/A8108 3.jpg\",\"alt_text\":\"A8108 3.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/20191021_082108.jpg\",\"alt_text\":\"20191021_082108.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/A8108 5.jpg\",\"alt_text\":\"A8108 5.jpg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/A8108 7.jpg\",\"alt_text\":\"A8108 7.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/A8108 1.jpg\",\"alt_text\":\"A8108 1.jpg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/A8108 8.jpg\",\"alt_text\":\"A8108 8.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/A8108 4.jpg\",\"alt_text\":\"A8108 4.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/A8108 2.jpg\",\"alt_text\":\"A8108 2.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/A8108 6.jpg\",\"alt_text\":\"A8108 6.jpg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/A8108 10.jpg\",\"alt_text\":\"A8108 10.jpg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/A8108 9.jpg\",\"alt_text\":\"A8108 9.jpg\"},\"gallery16\":{\"photo\":\"images\\/gallery\\/A8108 14.jpg\",\"alt_text\":\"A8108 14.jpg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/A8108 11.jpg\",\"alt_text\":\"A8108 11.jpg\"},\"gallery14\":{\"photo\":\"images\\/gallery\\/A8108 12.jpg\",\"alt_text\":\"A8108 12.jpg\"}