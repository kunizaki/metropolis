('1790', 'A8077', 'V. Tesouro- Cond Campo Giallo-Apto 48 m2 com 2 quartos+armários, coz.plan, 1 vg garagem', 'xa8077', '1', '1', '', '<p>O apartamento no bairro Vila Tesouro, Condominio Campo Giallo com 48 m2 tem 2 quartos com armários embutidos, cozinha planejada, banheiro com box/gabinete e 1 vaga de garagem. Fácil acesso ao Centro de SJCampos e bairros vizinhos. Local bem tranquilo.</p>\r\n<p>Condomínio R$298,00</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/A8077 1.jpg\",\"alt_text\":\"A8077 1.jpg\"},\"gallery3\":{\"photo\":\"images/gallery/A8077 2.jpg\",\"alt_text\":\"A8077 2.jpg\"},\"gallery5\":{\"photo\":\"images/gallery/A8077 4.jpg\",\"alt_text\":\"A8077 4.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/A8077 1.jpeg\",\"alt_text\":\"A8077 1.jpeg\"},\"gallery13\":{\"photo\":\"images/gallery/A8077 12.jpg\",\"alt_text\":\"A8077 12.jpg\"},\"gallery10\":{\"photo\":\"images/gallery/A8077 9.jpg\",\"alt_text\":\"A8077 9.jpg\"},\"gallery8\":{\"photo\":\"images/gallery/A8077 7.jpg\",\"alt_text\":\"A8077 7.jpg\"},\"gallery12\":{\"photo\":\"images/gallery/A8077 11.jpg\",\"alt_text\":\"A8077 11.jpg\"},\"gallery7\":{\"photo\":\"images/gallery/A8077 6.jpg\",\"alt_text\":\"A8077 6.jpg\"},\"gallery9\":{\"photo\":\"images/gallery/A8077 8.jpg\",\"alt_text\":\"A8077 8.jpg\"},\"gallery4\":{\"photo\":\"images/gallery/A8077 3.jpg\",\"alt_text\":\"A8077 3.jpg\"},\"gallery6\":{\"photo\":\"images/gallery/A8077 5.jpg\",\"alt_text\":\"A8077 5.jpg\"},\"gallery11\":{\"photo\":\"images/gallery/A8077 10.jpg\",\"alt_text\":\"A8077 10.jpg\"}}', 'sell', '', '250000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Vila Tesouro', '-23.165624,-45.835581', '12221-520', '48', '2', '1', '0', '', '0', NULL, '', '', '', '{}', '1', '*', '1', '0', '783', '2024-05-13 00:00:00', '783', '2024-05-16 12:39:23', '0', NULL),
