('1809', 'A8085', 'Apartamento para venda tem 70 metros quadrados com 2 quartos', 'xa8085', '1', '1', '', '<p>O apartamento está localizado no bairro Parque Residencial Flamboyant, no Condomínio Vista Flamboyant, andar térreo, 70 m2 com 2 quartos sendo 1 suite com armários, cozinha planejada, sala ampliada com sacada, banheiros com box/gabinete, 1 vaga de garagem. </p>\r\n<p>Possui academia, espaço gourmet, playground, espaço jardinado, salão para festas e eventos.</p>\r\n<p>Vai lhe possibilitar curtir os dias mais quentes na piscina, praticar diversos esportes na quadra poliesportiva, espaço reservado para preparar o seu churrasco. Elevador para mais praticidade no dia-a-dia.</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A8085 1.jpg\",\"alt_text\":\"A8085 1.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/A8085 3.jpg\",\"alt_text\":\"A8085 3.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/A8085 4.jpg\",\"alt_text\":\"A8085 4.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/A8085 5.jpg\",\"alt_text\":\"A8085 5.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/A8085 8.jpg\",\"alt_text\":\"A8085 8.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/A8085 2.jpg\",\"alt_text\":\"A8085 2.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/A8085 6.jpg\",\"alt_text\":\"A8085 6.jpg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/A8085 10.jpg\",\"alt_text\":\"A8085 10.jpg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/A8085 11.jpg\",\"alt_text\":\"A8085 11.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/A8085 7.jpg\",\"alt_text\":\"A8085 7.jpg\"},\"gallery15\":{\"photo\":\"images\\/gallery\\/A8085 15.jpg\",\"alt_text\":\"A8085 15.jpg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/A8085 9.jpg\",\"alt_text\":\"A8085 9.jpg\"},\"gallery14\":{\"photo\":\"images\\/gallery\\/A8085 14.jpg\",\"alt_text\":\"A8085 14.jpg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/A8085 13.jpg\",\"alt_text\":\"A8085 13.jpg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/A8085 12.jpg\",\"alt_text\":\"A8085 12.jpg\"},\"gallery18\":{\"photo\":\"images\\/gallery\\/A8085 18.jpg\",\"alt_text\":\"A8085 18.jpg\"},\"gallery16\":{\"photo\":\"images\\/gallery\\/A8085 16.jpg\",\"alt_text\":\"A8085 16.jpg\"},\"gallery20\":{\"photo\":\"images\\/gallery\\/A8085 20.jpg\",\"alt_text\":\"A8085 20.jpg\"},\"gallery19\":{\"photo\":\"images\\/gallery\\/A8085 19.jpg\",\"alt_text\":\"A8085 19.jpg\"},\"gallery17\":{\"photo\":\"images\\/gallery\\/A8085 17.jpg\",\"alt_text\":\"A8085 17.jpg\"}}', 'sell', '', '386000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Parque Residencial Flamboyant', '-23.214048,-45.851431', '12227-778', '70', '2', '2', '1', '', '0', '[\"8\",\"9\",\"12\",\"16\",\"18\",\"21\",\"22\",\"23\",\"24\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2024-06-06 00:00:00', '783', '2026-02-04 18:28:02', '0', NULL),
('1812', 'C3625', 'jd-oriente-sobrado-210-m2-3-quartos-ste-arms-coz-plan-sacada-churrasq-2-vg-gar-prox-shibata', 'xc3625', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">O sobrado no bairro Jardim Oriente com 210 metros quadrados com 3 quartos sendo 1 suite e 3 banheiros, churrasqueira para você aproveitar nos momentos de descontração.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">•    Área construída 210m² e AT 243m2;</span></p>\r\n<p><span style=\"font-size: 12.16px;\">•    3 Dormitórios, sendo uma suíte.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">•    Garagem para dois carros.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">•    3 banheiros.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">•    Portas e janelas em alumínio.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">•    Janelas automatizadas.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">•    Aquecedor Solar e água quente em todos os pontos da casa.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">•    Gerador de Energia, automatizado.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">•    Ar condicionado nos quartos.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">•    Portão automatizado</span></p>\r\n<p><span style=\"font-size: 12.16px;\">•    Documentação 100%.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">•    Avalio permuta até 50% do valor imóvel.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">•    IPTU 630 anual.</span></p>', '', NULL, NULL, '{\"gallery11\":{\"photo\":\"images/gallery/A 11.jpg\",\"alt_text\":\"A 11.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/A 2.jpg\",\"alt_text\":\"A 2.jpg\"},\"gallery7\":{\"photo\":\"images/gallery/A 7.jpg\",\"alt_text\":\"A 7.jpg\"},\"gallery10\":{\"photo\":\"images/gallery/A 10.jpg\",\"alt_text\":\"A 10.jpg\"},\"gallery12\":{\"photo\":\"images/gallery/B 1.jpg\",\"alt_text\":\"B 1.jpg\"},\"gallery3\":{\"photo\":\"images/gallery/A 3.jpg\",\"alt_text\":\"A 3.jpg\"},\"gallery6\":{\"photo\":\"i