('1775', 'A8070', 'Monte Castelo- Residencial das Chácaras- Apto 51 m2 com 2 quartos, 1 vaga garagem', 'xa8070', '1', '1', '', '<p>O apartamento no bairro Monte Castelo, no Condominio Residencial das Chácaras tem 51 m2 com 2 quartos e 1 banheiro e 1 vaga de garagem. Aceita financiamento, carro ou terreno.</p>\r\n<p>Condomínio R$350,00   IPTU R$300,00</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/821f3097ec02778f7a231ca81524ebfa1.jpg\",\"alt_text\":\"821f3097ec02778f7a231ca81524ebfa1.jpg\"},\"gallery4\":{\"photo\":\"images/gallery/A8070 4.jpg\",\"alt_text\":\"A8070 4.jpg\"},\"gallery5\":{\"photo\":\"images/gallery/A8070 5.jpg\",\"alt_text\":\"A8070 5.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/A8070 1.jpg\",\"alt_text\":\"A8070 1.jpg\"},\"gallery3\":{\"photo\":\"images/gallery/A8070 3.jpg\",\"alt_text\":\"A8070 3.jpg\"},\"gallery8\":{\"photo\":\"images/gallery/A8070 9.jpg\",\"alt_text\":\"A8070 9.jpg\"},\"gallery7\":{\"photo\":\"images/gallery/A8070 8.jpg\",\"alt_text\":\"A8070 8.jpg\"},\"gallery9\":{\"photo\":\"images/gallery/A8070 10.jpg\",\"alt_text\":\"A8070 10.jpg\"},\"gallery6\":{\"photo\":\"images/gallery/A8070 6.jpg\",\"alt_text\":\"A8070 6.jpg\"}}', 'sell', '', '225000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Monte Castelo', '-23.188485,-45.868656', '12215-580', '51', '2', '1', '1', '', '0', NULL, '', '', '', '{}', '1', '*', '1', '0', '783', '2024-04-27 00:00:00', '783', '2024-05-03 18:04:48', '0', NULL),
('1776', 'C3572', 'Casa de 110m² À Venda Com 3 Dormitórios No Parque Industrial.', 'xc3572', '7', '1', '', '<p>- 3 dormitórios</p>\r\n<p> </p>\r\n<p>- 2 banheiros</p>\r\n<p> </p>\r\n<p>- Sala</p>\r\n<p> </p>\r\n<p>- Cozinha</p>\r\n<p> </p>\r\n<p>- 3 vagas cobertas de garagem</p>\r\n<p> </p>\r\n<p>- Excelente localização, próximo a todo comércio. </p>\r\n<p> </p>\r\n<p>- Aceita permuta por casa na Vila Industrial, Vila Tatetuba, Jardim Ismênia ou no 31 de Março.</p>\r\n<p>IPTU R$490,00</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/C3572 1.jpg\",\"alt_text\":\"C3572 1.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/C3572 3.jpg\",\"alt_text\":\"C3572 3.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/C3572 2.jpg\",\"alt_text\":\"C3572 2.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/C3572 5.jpg\",\"alt_text\":\"C3572 5.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/C3572 4.jpg\",\"alt_text\":\"C3572 4.jpg\"}}', 'sell', '', '585000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Parque Industrial', '-23.230337,-45.906346', '12235-550', '110', '3', '2', '3', '', '0', '[\"12\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2024-05-01 00:00:00', '783', '2025-02-17 12:27:18', '0', NULL),
('1777', 'C3614', 'Jd. Sto Onofre- Sobrado de Villagio com 56 m2 com 2 quartos., 2 banheiros, box, coz planejada, 1 vg', 'xc3614', '7', '1', '', '<p>O sobrado geminado de villagio no bairro Jardim Santo Onofre com 56 m2 com 2 quartos e banheiro social, sala com lavabo, cozinha planejada, 1 vaga de garagem.</p>\r\n<p>CONDOMÍNIO R$180,00</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/C3614 14.jpg\",\"alt_text\":\"C3614 14.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/C3614 15.jpg\",\"alt_text\":\"C3614 15.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/C3614 5.jpg\",\"alt_text\":\"C3614 5.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/C3614 1.jpg\",\"alt_text\":\"C3614 1.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/C3614 6.jpg\",\"alt_text\":\"C3614 6.jpg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/C3614 9.jpg\",\"alt_text\":\"C3614 9.jpg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/C3614 7.jpg\",\"alt_text\":\"C3614 7.jpg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/C3614 10.jpg\",\"alt_text\":\"C3614 10.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/C3614 3.jpg\",\"alt_text\":\"C3614 3.jpg\"},\"gallery15\":{\"photo\":\"images\\/gallery\\/C3614 13.jpg\",\"alt_text\":\"C3614 13.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/C3614 4.jpg\",\"alt_text\":\"C3614 4.jpg\"},\"gallery14\":{\"photo\":\"images\\/gallery\\/C3614 12.jpg\",\"alt_text\":\"C3614 12.jpg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/C3614 8.jpg\",\"alt_text\":\"C3614 8.jpg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/C3614 11.jpg\",\"alt_text\":\"C3614 11.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/C3614 2.jpg\",\"alt_text\":\"C3614 2.jpg\"}}', 'sell', '', '300000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Jardim Santo Onofre', '-23.249842,-45.833739', '12228-013', '56', '2', '1', '1', '', '0', NULL, '', '', '', '{}', '1', '*', '1', '0', '783', '2024-05-01 00:00:00', '783', '2025-04-04 09:18:4