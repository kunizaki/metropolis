('1931', 'C3663', 'Jd. das Indústrias- Sobrado de 250 m2 com 4 quartos(ste), arms, coz.plan, lavabo, sac, sótão, 4 vgs', 'xc3663', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">O sobrado no Jardim das Indústrias tem 250 m2:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- São 4 quartos sendo 1 suite com armários</span></p>\r\n<p><span style=\"font-size: 12.16px;\">-  Cozinha planejada</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Salas jantar e estar</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Mezanino</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 02 sacadas</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Escritório</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Fundo com cobertura e churrasqueira</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Vagas para 4 veículos</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Área residencial mista (consultórios/ escritórios)</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Esquadrias em cedro rosa/ jatobá, telhado estilo Normandia</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Área fria em porcelanato e quartos com assoalho.<br /><br /><br /></span></p>', '', NULL, NULL, '{\"gallery4\":{\"photo\":\"images/gallery/C3663 4.jpg\",\"alt_text\":\"C3663 4.jpg\"},\"gallery1\":{\"photo\":\"images/gallery/C3663 1.jpg\",\"alt_text\":\"C3663 1.jpg\"},\"gallery3\":{\"photo\":\"images/gallery/C3663 3.jpg\",\"alt_text\":\"C3663 3.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/C3663 2.jpg\",\"alt_text\":\"C3663 2.jpg\"},\"gallery5\":{\"photo\":\"images/gallery/C3663 5.jpg\",\"alt_text\":\"C3663 5.jpg\"},\"gallery6\":{\"photo\":\"images/gallery/C3663 6.jpg\",\"alt_text\":\"C3663 6.jpg\"},\"gallery7\":{\"photo\":\"images/gallery/C3663 7.jpg\",\"alt_text\":\"C3663 7.jpg\"}}', 'sell', '', '1290000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Jardim das Indústrias', '-23.230618,-45.920609', '12240-710', '250', '4', '4', '4', '', '0', '