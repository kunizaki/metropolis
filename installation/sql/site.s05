('1922', 'A6998', 'Jd. São Dimas- Apto 118 m2 com 3 quartos(suite), coz. planejada, 1 vg de garagem.', 'xa6998', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">Apto no Jd São DImas, no Cond Mansão do Vale com área útil de 118m2:</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">-3 quartos sendo uma suite e armários embutidos,</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sala dois ambientes,</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Cozinha planejada ,</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Quarto de serviço,</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Banheiro de serviço;</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Uma vaga de garagem;</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Portaria 24h;</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Área de lazer com salão de festas, playground</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Ótima localização com vários comercios como farmácias, restaurantes, bancos e o Parque Santos Dumont,<br /><br />Condomínio 730,00     IPTU640,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A6998 1.jpg\",\"alt_text\":\"A6998 1.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/A6998 2.jpg\",\"alt_text\":\"A6998 2.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/A6998 7.jpg\",\"alt_text\":\"A6998 7.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/A6998 5.jpg\",\"alt_text\":\"A6998 5.jpg\"},\"gallery3\":{\"photo\":\"images