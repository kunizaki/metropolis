('1866', 'C3511', 'Urbanova- Sobrado de 395 m2 com 5 quartos(3 suites), lavabo, coz.plan, 4 vagas, piscina,churrasq', 'xc3511', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">O sobrado está localizado no Altos da Serra I, Urbanova e possui 395 m2 de área útil em lote de 600m2.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- São 5 quartos sendo 3 suites, closet, armários</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Ampla sala com lavabo</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Cozinha planejada</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sancas e iluminação embutida com gesso em todos os cômodos, inclusive nos banheiros</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Ar condicionado</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Aquecimento solar e boiler</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Caixas d’água grandes de inox</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Pisos e paredes Portobello</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Piscina com aquecimento solar independente</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Portão da garagem automático</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">Possibilidade de PERMUTA com casa em condominio ou apartamentos de até R$ 700mil <br />Condomínio R$450,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/C3511 1.jpeg\",\"alt_text\":\"C3511 1.jpeg\"},\"gallery5\":{\"photo\":\"images/gallery/C3511 5.jpeg\",\"alt_text\":\"C3511 5.jpeg\"},\"gallery2\":{\"photo\":\"images/gallery/C3511 2.jpeg\",\"alt_text\":\"C3511 2.jpeg\"},\"gallery3\":{\"photo\":\"images/gallery/C3511 3.jpeg\",\"alt_text\":\"C3511 3.jpeg\"},\"gallery6\":{\"photo\":\"images/gallery/C3511 6.jpeg\",\"alt_text\":\"C3511 6.jpeg\"},\"gallery8\":{\"photo\":\"images/gallery/C3511 8.jpeg\",\"alt_text\":\"C3511 8.jpeg\"},\"gallery7\":{\"photo\":\"images/gallery/C3511 7.jpeg\