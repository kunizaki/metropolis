('1916', 'C3661', 'Condominio Terra Nova- Casa térrea 70 m2 com 3 quartos(suite), 2 vagas garagem', 'xc3661', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">A casa fica no Eugênio de Mello, Condominio Terra Nova:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">_ Possui 70 m2 de área útil e 140m2 de terreno</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Tem 3 quartos sendo 1 suite, com armários e ar-condicionado</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Pedras em Granito Preto São Gabriel</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Bancada para ser usada como escritório e ar condicionado</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sala 2 ambientes com ar-condicionado, bar e aquário </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Escritório</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Cozinha com pia ampla, coifa inox e fogão embutido inox Brastemp Active! </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Área de serviço coberta e isolada da casa </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Linda área gourmet de 35m2 com churrasqueira, balcão em granito e pergolado </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Garagem para 2 carros </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Rua sem saída com baixo fluxo de veículos </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Em frente a área verde </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 15 vagas para visitantes em frente a casa</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Condomínio Tranquilo com ambiente familiar </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Mini mercado auto serviço </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Piscina adulto e infantil </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Salão de festas </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Quiosques com churrasqueiras </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Playground </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Campo de futebol </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Quadra de areia </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Portaria e segurança 24h </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 3 minutos para acessar a Via Dutra no sentido RJ ou SP (em frente ao viaduto do Sta. Ines<br /><br />Condomínio R$350</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/C3661 1.jpg\",\"alt_text\":\"C3661 1.jpg\"},\"gallery5\":{\"photo\":\"images/gallery/C3661 5.jpg\",\"alt_text\":\"C3661 5.jpg\"},\"gallery6\":{\"photo\":\"images/gallery/C3661 6.jpg\",\"alt_text\":\"C3661 6.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/C3661 2.jpg\",\"alt_text\":\"C3661 2.jpg\"},\"gallery3\":{\"photo\":\"images/gallery/C3661 3.jpg\",\"alt_text\":\"C3661 3.jpg\"},\"gallery13\":{\"photo\":\"images/gallery/C3661 13.jpg\",\"alt_text\":\"C3661 13.jpg\"},\"gallery4\":{\"photo\":\"images/gallery/C3661 4.jpg\",\"alt_text\":\"C3661 4.jpg\"},\"gallery10\":{\"photo\":\"images/gallery/C3661 10.jpg\",\"alt_text\":\"C3661 10.jpg\"},\"gallery12\":{\"photo\":\"images/gallery/C3661 12.jpg\",\"alt_text\":\"C3661 12.jpg\"},\"gallery11\":{\"photo\":\"images/gallery/C3661 11.jpg\",\"alt_text\":\"C3661 11.jpg\"},\"gallery8\":{\"photo\":\"images/gallery/C3661 8.jpg\",\"alt_text\":\"C3661 8.jpg\"},\"gallery7\":{\"photo\":\"images/gallery/C3661 7.jpg\",\"alt_text\":\"C3661 7.jpg\"},\"gallery15\":{\"photo\":\"images/gallery/C3661 15.jpg\",\"alt_text\":\"C3661 15.jpg\"},\"gallery9\":{\"photo\":\"images/gallery/C3661 9.jpg\",\"alt_text\":\"C3661 9.jpg\"},\"gallery17\":{\"photo\":\"images/gallery/C3661 17.jpg\",\"alt_text\":\"C3661 17.jpg\"},\"gallery16\":{\"photo\":\"images/gallery/C3661 16.jpg\",\"alt_text\":\"C3661 16.jpg\"},\"gallery14\":{\"photo\":\"images/gallery/C3661 14.jpg\",\"alt_text\":\"C3661 14.jpg\"},\"gallery19\":{\"photo\":\"images/gallery/C3661 19.jpg\",\"alt_text\":\"C3661 19.jpg\"},\"g