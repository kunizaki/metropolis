('1628', 'C3559', 'Residencial Righi Casa 125m² 4 quartos (2 suítes) 2 vagas portão automático', 'xc3559', '7', '1', '', '<p>Sobrado geminado à venda no bairro Residencial Armando Moreira Righi com 125 m² com 4 quartos, sendo 2 suítes, 1 wc social, sala, cozinha com armários planejados, porão espaçoso, vaga para 2 carros, portão automático, localizado em bairro tranquilo.</p>\r\n<p> </p>', '', NULL, NULL, '{\"gallery2\":{\"photo\":\"images\\/gallery\\/Sem ttulo.png\",\"alt_text\":\"Sem ttulo.png\"}}', 'sell', '', '458000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São josé dos Campos ', 'Residencial Armando Moreira Righi', '-23.137235,-45.766147', '12247-820', '125', '4', '3', '2', '', '0', NULL, '', '', '', '{}', '1', '*', '1', '0', '783', '2023-12-03 00:00:00', '783', '2023-12-08 17:00:10', '0', NULL),
('1629', 'C3557', 'Jd das Indústrias-Sobrado de 98 m2 com 3 quartos(st),arms, coz.plan, 2 vgs, portão automático', 'xc3557', '7', '1', '', '<p>O sobrado geminado está localizado no bairro Jardim das Indústrias com 98 metros quadrados com 3 quartos sendo 1 suite, armários embutidos, cozinha com atmários, banheiro social com box/gabinete, 2 vagas de garagem e portão automático.</p>\r\n<p> </p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/M3557 1.jpg\",\"alt_text\":\"M3557 1.jpg\"},\"gallery13\":{\"photo\":\"images/gallery/M3557 13.jpg\",\"alt_text\":\"M3557 13.jpg\"},\"gallery15\":{\"photo\":\"images/gallery/M3557 15.jpg\",\"alt_text\":\"M3557 15.jpg\"},\"gallery14\":{\"photo\":\"images/gallery/M3557 14.jpg\",\"alt_text\":\"M3557 14.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/M3557 2.jpg\",\"alt_text\":\"M3557 2.jpg\"},\"gallery3\":{\"photo\":\"images/gallery/M3557 3.jpg\",\"alt_text\":\"M3557 3.jpg\"},\"gallery5\":{\"photo\":\"images/gallery/M3557 5.jpg\",\"alt_text\":\"M3557 5.jpg\"},\"gallery7\":{\"photo\":\"images/gallery/M3557 7.jpg\",\"alt_text\":\"M3557 7.jpg\"},\"gallery11\":{\"photo\":\"images/gallery/M3557 11.jpg\",\"alt_text\":\"M3557 11.jpg\"},\"gallery10\":{\"photo\":\"images/gallery/M3557 10.jpg\",\"alt_text\":\"M3557 10.jpg\"},\"gallery8\":{\"photo\":\"images/gallery/M3557 8.jpg\",\"alt_text\":\"M3557 8.jpg\"},\"gallery4\":{\"photo\":\"images/gallery/M3557 4.jpg\",\"alt_text\":\"M3557 4.jpg\"},\"gallery6\":{\"photo\":\"images/gallery/M3557 6.jpg\",\"alt_text\":\"M3557 6.jpg\"},\"gallery16\":{\"photo\":\"images/gallery/M3557 16.jpg\",\"alt_text\":\"M3557 16.jpg\"},\"gallery17\":{\"photo\":\"images/gallery/M3557 17.jpg\",\"alt_text\":\"M3557 17.jpg\"},\"gallery12\":{\"photo\":\"images/gallery/M3557 12.jpg\",\"alt_text\":\"M3557 12.jpg\"},\"gallery18\":{\"photo\":\"images/gallery/M3557 18.jpg\",\"alt_text\":\"M3557 18.jpg\"},\"gallery19\":{\"photo\":\"images/gallery/M3557 9.jpg\",\"alt_text\":\"M3557 9.jpg\"}}', 'sell', '', '665000.00',