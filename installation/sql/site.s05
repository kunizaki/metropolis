('1608', 'M0457', 'Jd, São Dimas - salão de 100m2 na Rua Paraibuna', 'xm0477', '3', '1', '', '<p>Salão duplo comercial de 100m2 na Rua Paraibuna, próximo ao Cooper Laticinios. Dois salôes juntos</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/M0477 0.JPG\",\"alt_text\":\"M0477 0.JPG\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/M0477 1.JPG\",\"alt_text\":\"M0477 1.JPG\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/M0477 8.JPG\",\"alt_text\":\"M0477 8.JPG\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/M0477 7.JPG\",\"alt_text\":\"M0477 7.JPG\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/M0477 4.JPG\",\"alt_text\":\"M0477 4.JPG\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/M0477 5.JPG\",\"alt_text\":\"M0477 5.JPG\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/M0477 3.JPG\",\"alt_text\":\"M0477 3.JPG\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/M0477 2.JPG\",\"alt_text\":\"M0477 2.JPG\"}}', 'rent', '', '3600.00', '', '', '', '1', 'show', '12', 'BR', 'SJCampos', 'Rua Paraibuna', '-23.194476,-45.888210', '12245-021', '100', '0', '2', '0', '', '0', '[\"1\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2023-10-22 00:00:00', '783', '2023-10-25 13:52:37', '0', NULL),
('1611', 'A7986', 'Urbanova/Cond. The Gold-Apto Novo 90 m2 com 3 quartos(ste),sacada, 2 vagas', 'xa7986', '1', '1', '', '<p><span style=\"color: #1a1d23; font-family: \'Nunito Sans\', \'Helvetica Neue\', Helvetica, Arial, sans-serif; font-size: 16px; white-space-collapse: preserve-breaks;\">O apartamento novo está localizado no bairro Condomínio Residencial Colinas do Paratehy, Edifício The Gold com 90 metros quadrados com 3 quartos sendo 1 suite, sala com sacada, 2 banheiros e 2 vagas de garagem. Possui área de fitness, espaço jardinado, espaço para festas, espaço gourmet. Vai lhe possibilitar curtir os dias mais quentes na piscina, praticar diversos esportes na quadra poliesportiva. Espaço reservado para preparar o seu churrasco. Elevador para mais praticidade no dia-a-dia. Encontra-se na privacidade de um condomínio fechado.</span></p>\r\n<p><span style=\"color: #1a1d23; font-family: \'Nunito Sans\', \'Helvetica Neue\', Helvetica, Arial, sans-serif; font-size: 16px; white-space-collapse: preserve-breaks;\">Condomínio R$500,00 IPTU R$1.000,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/A7986 0.jpg\",\"alt_text\":\"A7986 0.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/A7986 1.jpg\",\"alt_text\":\"A7986 1.jpg\"},\"gallery5\":{\"photo\":\"images/gallery/A7986 4.jpg\",\"alt_text\":\"A7986 4.jpg\"},\"gallery3\":{\"photo\":\"images/gallery/A7986 2.jpg\",\"alt_text\":\"A7986 2.jpg\"},\"gallery4\":{\"photo\":\"images/gallery/A7986 3.jpg\",\"alt_text\":\"A7986 3.jpg\"},\"gallery8\":{\"photo\":\"images/gallery/A7986 4A.jpg\",\"alt_text\":\"A7986 4A.jpg\"},\"gallery6\":{\"photo\":\"images/gallery/A7986 2A.jpg\",\"alt_text\":\"A7986 2A.jpg\"},\"gallery9\":{\"photo\":\"images/gallery/A7986 6A.jpg\",\"alt_text\":\"A7986 6A.jpg\"},\"gallery7\":{\"photo\":\"images/gallery/A7986 3A.jpg\",\"alt_text\":\"A7986 3A.jpg\"},\"gallery10\":{\"photo\":\"images/gallery/A7986 10.jpg\",\"alt_text\":\"A7986 10.jpg\"},\"gallery11\":{\"photo\":\"images/gallery/A7986