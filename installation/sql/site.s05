('1815', 'A8090', 'Pq Industrial - Apto 82 m2 com 3 quartos(ste), sacada gourmet, coz.plan, ar-condicionado, 2 vgs gar', 'xa8090', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">O apartamento está localizado no Pq Industrial/Jardim Veneza tem 82 m2 com 3 quartos sendo 1 suite com armários, sala com sacada gourmet, cozinha planejada, 2 banheiros com box/gabinete, 2 vagas de garagem.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Área de lazer com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">* portaria 24h com excelentes porteiros presentes.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">* várias vagas para visitantes</span></p>\r\n<p><span style=\"font-size: 12.16px;\">* 3 elevadores por torre.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">* academia indoor e outdoor</span></p>\r\n<p><span style=\"font-size: 12.16px;\">* 2 churrasqueiras completas</span></p>\r\n<p><span style=\"font-size: 12.16px;\">* Salão de festas adulto</span></p>\r\n<p><span style=\"font-size: 12.16px;\">* Salão de festas infantil</span></p>\r\n<p><span style=\"font-size: 12.16px;\">* playground</span></p>\r\n<p><span style=\"font-size: 12.16px;\">* brinquedoteca</span></p>\r\n<p><span style=\"font-size: 12.16px;\">* salão de jogos</span></p>\r\n<p><span style=\"font-size: 12.16px;\">* quadra de esportes</span></p>\r\n<p><span style=\"font-size: 12.16px;\">* piscina adulto com raia olímpica</span></p>\r\n<p><span style=\"font-size: 12.16px;\">* piscina infantil</span></p>\r\n<p><span style=\"font-size: 12.16px;\">* Bicicletário.<br />Condominio R$540,00        IPTU R$1200,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A8090 1.jpg\",\"alt_text\":\"A8090 1.jpg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/A8090 11.jpg\",\"alt_text\":\"A8090 11.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/A8090 4.jpg\",\"alt_text\":\"A8090 4.jpg\"},\"gallery16\":{\"photo\":\"images\\/gallery\\/A8090 16.jpg\",\"alt_text\":\"A8090 16.jpg\"},