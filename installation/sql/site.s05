('1822', 'A8099', 'Jd Aquarius- Apto 90 m2 com 3 quartos(ste), armários, coz. planejada, sacada gourmet, 2 vgs gar', 'xa8099', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">O aptol está localizado no Jd Aquarius, Condomínio Patio Club de 90 m2 com 3 quartos sendo 1 suite, todos com armários embutidos, banheiros com box/gabinete, sala com sacada gourmet, cozinha planejada, 2 vagas de garagem.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Possui excelente área de lazer com academia, espaço gourmet, área verde de jardim, playground, salão de festas, piscina, quadra poliesportiva, espaço reservado para preparar o seu churrasco.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Elevador para mais praticidade no dia-a-dia.</span></p>\r\n<p><span style=\"font-size: 12.16px;\"><br />Condomínio R$569,00 IPTU R$1300,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/A8099 0.jpg\",\"alt_text\":\"A8099 0.jpg\"},\"gallery9\":{\"photo\":\"images/gallery/A8099 8.jpg\",\"alt_text\":\"A8099 8.jpg\"},\"gallery12\":{\"photo\":\"images/gallery/A8099 11.jpg\",\"alt_text\":\"A8099 11.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/A8099 1.jpg\",\"alt_text\":\"A8099 1.jpg\"},\"gallery6\":{\"photo\":\"images/gallery/A8099 5.jpg\",\"alt_text\":\"A8099 5.jpg\"},\"gallery11\":{\"photo\":\"images/gallery/A8099 10.jpg\",\"alt_text\":\"A8099 10.jpg\"},\"gallery7\":{\"photo\":\"images/gallery/A8099 6.jpg\",\"alt_text\":\"A8099 6.jpg\"},\"gallery8\":{\"photo\":\"images/gallery/A8099 7.jpg\",\"alt_text\":\"A8099 7.jpg\"}}', 'sell', '', '945000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Condomínio Royal Park', '-23.223499,-45.909904', '12246-875', '90', '3', '2', '2', '', '0', '[\"8\",\"9\",\"12\",\"16\",\"18\",\"21\",\"22\",\"23\",\"24\",\"26\",\"27\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2024-07-05 00:00:00', '783', '2024-07-08 11:23:42', '0', NULL),
('1823', 'A8098', 'Jd América- Apto de 53 m2 com 2 quartos+armários; coz.planejada, sala e sacada, 1 vaga de gar', 'xa8098', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">Apto de 53 metros quadrados; 2 quartos (sem suíte); 1 banheiro com box até o teto; Sala e varanda com linda vista; Cozinha integrada com lavanderia; Ar condicionado na sala; Móvel planejado em todos os cômodos; Infraestrutura pronta para ar condicionado nos quartos;</span></p>\r\n<p><span style=\"font-size: 12.16px;\">1 vaga de garagem (Subsolo); Parede com espelho na sala.</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">O condomínio oferece salão de festas, churrasqueira e playground para crianças.</span></p>\r\n<p> </p>\r\n<p><span style=\"font-size: 12.16px;\">Condomínio R$380,00 IPTU R$900,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A8098 2.jpg\",\"alt_text\":\"A8098 2.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/A8098 1.jpg\",\"alt_text\":\"A8098 1.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/A8098 3.jpg\",\"alt_text\":\"A8098 3.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/A8098 5.jpg\",\"alt_text\":\"A8098 5.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/A8098 4.jpg\",\"alt_text\":\"A8098 4.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/A8098 6.jpg\",\"alt_text\":\"A8098 6.jpg\"}}', 'sell', '', '385000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Jardim América', '-23.230723,-45.894705', '12235-080', '53', '2', '1', '1', '', '0', '[\"16\",\"22\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2024-07-04 00:00:00', '783', '2025-07-29 22:50:54', '0', NULL),
('1827', 'A8094', 'Imóvel para venda possui 90 metros quadrados com 3 quartos', 'xa8094', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">Apto no Parque Residencial Aquarius de 90 m2 com 3 quartos sendo 1 suite, todos com armários, cozinha planejada, despensa, banheiros com box/gabinete, sala com sacada, 02 vagas de garagem.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Possui espaço para festas, parquinho infantil, jardim, Churrasqueira, piscina. Elevador que garante o transporte das suas malas e compras. Próximo ao Carrefour.<br /><br />Condomínio R$500,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/A8094 1.jpg\",\"alt_text\":\"A8094 1.jpg\"},\"gallery5\":{\"photo\":\"images/gallery/A8094 5.jpg\",\"alt_text\":\"A8094 5.jpg\"},\"gallery9\":{\"photo\":\"images/gallery/A8094 9.jpg\",\"alt_text\":\"A8094 9.jpg\"},\"gallery7\":{\"photo\":\"images/gallery/A8094 7.jpg\",\"alt_text\":\"A8094 7.jpg\"},\"gallery4\":{\"photo\":\"images/gallery/A8094 4.jpg\",\"alt_text\":\"A8094 4.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/A8094 2.jpg\",\"alt_text\":\"A8094 2.jpg\"},\"gallery3\":{\"photo\":\"images/gallery/A8094 3.jpg\",\"alt_text\":\"A8094 3.jpg\"},\"gallery6\":{\"photo\":\"images/gallery/A8094 6.jpg\",\"alt_text\":\"A8094 6.jpg\"},\"gallery10\":{\"photo\":\"images/gallery/A8094 10.jpg\",\"alt_text\":\"A8094 10.jpg\"},\"gallery8\":{\"photo\":\"images/gallery/A8094 8.jpg\",\"alt_text\":\"A8094 8.jpg\"},\"gallery11\":{\"photo\":\"images/gallery/A8094 11.jpg\",\"alt_text\":\"A8094 11.jpg\"}}', 'sell', '', '830000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Parque Residencial Aquarius', '-23.222106,-45.909653', '12246-021', '90', '3', '2', '2', '', '0', '[\"8\",\"9\",\"12\",\"16\",\"21\",\"22\",\"27\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2024-07-05 00:00:00', '783', '2024-07-08 15:04:44', '0', NULL),
('1828', 'C3631', 'Campo dos Alemães- Casa de 62 m2 com 3 quartos(suite), 2 vagas de garagem', 'xc3631', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">Casa no Campo dos Alemães com 3 Quartos sendo uma suíte e garagem para 2 carros . Casa Reformada com detalhamento de madeira em todos batentes e portas de madeira sanfonada de alta qualidade.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Aceita permuta com Carro</span></p>\r\n<p> </p>\r\n<p><span style=\"font-size: 12.16px;\">IPTU R$900,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/C3631 1.jpg\",\"alt_text\":\"C3631 1.jpg\"},\"gallery9\":{\"photo\":\"images/gallery/C3631 9.jpg\",\"alt_text\":\"C3631 9.jpg\"},\"gallery4\":{\"photo\":\"images/gallery/C3631 4.jpg\",\"alt_text\":\"C3631 4.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/C3631 2.jpg\",\"alt_text\":\"C3631 2.jpg\"},\"gallery6\":{\"photo\":\"images/gallery/C3631 6.jpg\",\"alt_text\":\"C3631 6.jpg\"},\"gallery5\":{\"photo\":\"images/gallery/C3631 5.jpg\",\"alt_text\":\"C3631 5.jpg\"},\"gallery11\":{\"photo\":\"images/gallery/C3631 11.jpg\",\"alt_text\":\"C3631 11.jpg\"},\"gallery10\":{\"photo\":\"images/gallery/C3631 10.jpg\",\"alt_text\":\"C3631 10.jpg\"},\"gallery8\":{\"photo\":\"images/gallery/C3631 8.jpg\",\"alt_text\":\"C3631 8.jpg\"},\"gallery3\":{\"photo\":\"images/gallery/C3631 3.jpg\",\"alt_text\":\"C3631 3.jpg\"},\"gallery13\":{\"photo\":\"images/gallery/C3631 13.jpg\",\"alt_text\":\"C3631 13.jpg\"},\"gallery7\":{\"photo\":\"images/gallery/C3631 7.jpg\",\"alt_text\":\"C3631 7.jpg\"},\"gallery15\":{\"photo\":\"images/gallery/C3631 15.jpg\",\"alt_text\":\"C3631 15.jpg\"},\"gallery14\":{\"photo\":\"images/gallery/C3631 14.jpg\",\"alt_text\":\"C3631 14.jpg\"},\"gallery12\":{\"photo\":\"images/gallery/C3631 12.jpg\",\"alt_text\":\"C3631 12.jpg\"},\"gallery18\":{\"photo\":\"images/gallery/C3631 18.jpg\",\"alt_text\":\"C3631 18.jpg\"},\"gallery17\":{\"photo\":\"images/gallery/C3631 17.jpg\",\"alt_text\":\"C3631 17