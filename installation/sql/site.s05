('1877', 'C3648', 'Colinas do Parahyba- Sobrado novo de 300 m2 com 4 quartos(4 suites), 5 vagas garagem', 'xc3648', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">O sobrado novo  está localizado no Condomínio Colinas do Parahyba com 300 m2. Tem 4 quartos sendo 4 suites, lavabo, piscina, churrasqueira, 5 vagas de garaem.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Terreno de 1100m2 terreno</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Persianas nos dormitórios com controle remoto</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Hall de entrada com Pé direito duplo</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sala ambiente integrado</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Piscina</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Lavabo</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Solarium</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Infraestrutura para ar condicionado e sauna</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Possibilidade de permuta até 30% valor.</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/C3648 1.jpg\",\"alt_text\":\"C3648 1.jpg\"},\"gallery4\":{\"photo\":\"images/gallery/C3648 4.jpg\",\"alt_text\":\"C3648 4.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/C3648 2.jpg\",\"alt_text\":\"C3648 2.jpg\"},\"gallery6\":{\"photo\":\"images/gallery/C3648 6.jpg\",\"alt_text\":\"C3648 6.jpg\"},\"gallery10\":{\"photo\":\"images/gallery/C3648 10.jpg\",\"alt_text\":\"C3648 10.jpg\"},\"gallery12\":{\"photo\":\"images/gallery/C3648 12.jpg\",\"alt_text\":\"C3648 12.jpg\"},\"gallery15\":{\"photo\":\"images/gallery/C3648 15.jpg\",\"alt_text\":\"C3648 15.jpg\"},\"gallery9\":{\"photo\":\"images/gallery/C3648 9.jpg\",\"alt_text\":\"C3648 9.jpg\"},\"gallery8\":{\"photo\":\"images/gallery/C3648 8.jpg\",\"alt_text\":\"C3648 8.jpg\"},\"gallery14\":{\"photo\":\"images/gallery/C3648 14.jpg\",\"alt_text\":\"C3648 14.jpg\"},\"gallery3\":{\"photo\":\"images/gallery/C