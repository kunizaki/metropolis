('1848', 'C3641', 'Bosque dos Ipês- Sobrado de 170 m2 com 3 quartos(suite), coz.planejada, sacada, 2 vagas gar', 'xc3641', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">O sobrado no Bosque dos Ipês possui 170 m2 com 3 quartos sendo 1 suite, cozinha planejada, banheiros com box, sala, sacada, churrasqueira, 2 vagas de garagem.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Aceita financiamento</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- FGTS</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Carro</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/C3641 2.jpg\",\"alt_text\":\"C3641 2.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/C3641 1.jpg\",\"alt_text\":\"C3641 1.jpg\"},\"gallery6\":{\"photo\":\"images/gallery/C3641 6.jpg\",\"alt_text\":\"C3641 6.jpg\"},\"gallery7\":{\"photo\":\"images/gallery/C3641 7.jpg\",\"alt_text\":\"C3641 7.jpg\"},\"gallery8\":{\"photo\":\"images/gallery/C3641 8.jpg\",\"alt_text\":\"C3641 8.jpg\"},\"gallery4\":{\"photo\":\"images/gallery/C3641 4.jpg\",\"alt_text\":\"C3641 4.jpg\"},\"gallery3\":{\"photo\":\"images/gallery/C3641 3.jpg\",\"alt_text\":\"C3641 3.jpg\"},\"gallery5\":{\"photo\":\"images/gallery/C3641 5.jpg\",\"alt_text\":\"C3641 5.jpg\"}}', 'sell', '', '607000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Residencial Bosque dos Ipês', '-23.256114,-45.895651', '12236-882', '170', '3', '2', '2', '', '0', '[\"12\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2024-07-30 00:00:00', '783', '2024-08-02 15:08:19', '0', NULL),
('1850', 'C3642', 'Urbanova/Altos da Serra II- Sobrado 380 m2 com 4 quartos(4stes), arms, piscina, 2 vgs garagem', 'xc3642', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">O sobrado no bairro Urbanova III possui 380 m2 de área construida e 444m2 de terreno.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Características internas:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Quatro suítes no pavimento superior; sendo uma máster, duas americanas e uma suíte tradicional, todos com sacada!</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Armários planejados em 3 das 4 suítes</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Amplo escritório com sacada;</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sala de home theater;</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sala de estar integrada com jantar, com lavabo para visitas;</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Cozinha americana com marcenaria planejada;</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Piso de madeira nos quartos;</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Despensa;</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Quarto de empregada ou hobby box;</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Área gourmet com churrasqueira e banheiro completo com chuveiro para uso da piscina;</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Área de serviço;</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Garagem coberta para 2 carros;</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Piscina privativa em alvenaria;</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sauna úmida privativa;</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">O Condomínio conta com 2 playground para crianças, 1 quadra de poliesportiva, diversos quiosques e ampla pista de caminhada em área de preservação ambiental;</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Segurança 24h.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Próximo a supermercado, feira livre, academias, igreja e perto da área com mais comércios do Urbanova.</span></p>\r\n<p> </p>\r\n<p> </p>\r\n<p><span style=\"font-size: 12.16px;\">Condomínio R$495,00       IPTU R$3270,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/C3642 0.jpeg\",\"alt_text\":\"C3642 0.jpeg\"},\"gallery14\":{\"photo\":\"images/gallery/C3642 16.jpg\",\"alt_text\":\"C3642 16.jpg\"},\"gallery11\":{\"photo\":\"images/gallery/C3642 13.jpeg\",\"alt_text\":\"C3642 13.jpeg\"},\"gallery2\":{\"photo\":\"images/gallery/C3642 4.jpeg\",\"alt_text\":\"C3642 4.jpeg\"},\"gallery10\":{\"photo\":\"images/gallery/C3642 12.jpeg\",\"alt_text\":\"C3642 12.jpeg\"},\"gallery7\":{\"photo\":\"images/gallery/C3642 9.jpeg\",\"alt_text\":\"C3642 9.jpeg\"},\"gallery3\":{\"photo\":\"images/gallery/C3642 5.jpeg\",\"alt_text\":\"C3642 5.jpeg\"},\"gallery9\":{\"photo\":\"images/gallery/C3642 11.jpeg\",\"alt_text\":\"C3642 11.jpeg\"},\"gallery4\":{\"photo\":\"images/gallery/C3642 6.jpeg\",\"alt_text\":\"C3642 6.jpeg\"},\"gallery15\":{\"photo\":\"images/gallery/C3642 17.jpeg\",\"alt_text\":\"C3642 17.jpeg\"},\"gallery8\":{\"photo\":\"images/gallery/C3642 10.jpeg\",\"alt_text\":\"C3642 10.jpeg\"},\"gallery5\":{\"photo\":\"images/gallery/C3642 7.jpeg\",\"alt_text\":\"C3642 7.jpeg\"},\"gallery12\":{\"photo\":\"images/gallery/C3642 14.jpeg\",\"alt_text\":\"C3642 14.jpeg\"},\"gallery6\":{\"photo\":\"images/gallery/C3642 8.jpeg\",\"alt_text\":\"C3642 8.jpeg\"},\"gallery13\":{\"photo\":\"images/gallery/C3642 15.jpeg\",\"alt_text\":\"C3642 15.jpeg\"}}', 'sell', '', '2390000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Urbanova III', '-23.200059,-45.949743', '12244-522', '380', '4', '6', '2', '', '0', '[\"8\",\"21\",\"23\",\"27\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2024-07-30 00:00:00', '783', '2024-08-02 15:23:39', '0', NULL),
('1856', 'M0716', 'Centro- Salão comercial de 50 m2, 2 toaletes, sem estacto. Em frente à Sabesp na R. Dolzani Ricardo', 'xm0716', '3', '1', '', '<p><span style=\"font-size: 12.16px;\">O salão comercial, bem em frente a Sabesp, no Centro, tem 50 m2 e 2 banheiros. Ideal para loja, consultório, etc<br /></span>IPTU R$3720,00</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/M0716 1.jpg\",\"alt_text\":\"M0716 1.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/M0716 2.jpg\",\"alt_text\":\"M0716 2.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/M0716 3.jpg\",\"alt_text\":\"M0716 3.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/M0716 4.jpg\",\"alt_text\":\"M0716 4.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/M0716 8.JPG\",\"alt_text\":\"M0716 8.JPG\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/M0716 6.JPG\",\"alt_text\":\"M0716 6.JPG\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/M0716 10.JPG\",\"alt_text\":\"M0716 10.JPG\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/M0716 9.JPG\",\"alt_text\":\"M0716 9.JPG\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/M0716 7.JPG\",\"alt_text\":\"M0716 7.JPG\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/M0716 5.JPG\",\"alt_text\":\"M0716 5.JPG\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/M0716 11.jpg\",\"alt_text\":\"M0716 11.jpg\"}}', 'rent', '', '5000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Centro', '-23.187110,-45.885304', '12210-110', '50', '0', '2', '0', '', '0', NULL, '', '', '', '{}', '1', '*', '1', '0', '783', '2024-08-02 00:00:00', '783', '2024-08-06 12:52:53', '0', NULL),
