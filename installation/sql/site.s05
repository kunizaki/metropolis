('1915', 'A8135', 'Jd. América/ Cond Dunas- 47 m2 com 2 quartos, 1 vaga garagem', 'xa8135', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">O apartamento está localizado no bairro Jardim América, no Condominio Dunas. Tem 48 m2 com 2 quartos, sala, cozinha planejada, 1 banheiro com box/gabinete e 1 vaga de garagem.</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Possui parquinho infantil, espaço para festas.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Vai lhe possibilitar curtir os dias mais quentes na piscina</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- churrasqueira para você aproveitar nos momentos de descontração</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Próximo ao Shopping Oriente e Shibata Supermercado.<br /><br />Condomínio R$440,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A8135 3.jpg\",\"alt_text\":\"A8135 3.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/A8135 8.jpg\",\"alt_text\":\"A8135 8.jpg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/A8135 9.jpg\",\"alt_text\":\"A8135 9.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/A8135 4.jpg\",\"alt_text\":\"A8135 4.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/A8135 1.jpg\",\"alt_text\":\"A8135 1.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/A8135 6.jpg\",\"alt_text\":\"A8135 6.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/A8135 7.jpg\",\"alt_text\":\"A8135 7.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/A8135 5.jpg\",\"alt_text\":\"A8135 5.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/A8135 2.jpg\",\"alt_text\":\"A8135 2.jpg\"}}', 'sell', '', '220000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Jardim América', '-23.231911,-45.893365', '12235-000', '47', '2', '1', '1', '', '0', '[\"8\",\"9\",\"12\",\"16\",\"21\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2024-09-30 00:00:00', '783', '2024-10-04 16:51:23', '