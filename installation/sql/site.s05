('1617', 'A7989', 'Pq Industrial-Apto 65 m2, 2 quartos(ste), armários, coz.plan, sacada gourmet,1 vg gar/Sol', 'xa7989', '1', '1', '', '<p><span style=\"color: #1a1d23; font-family: \'Nunito Sans\', \'Helvetica Neue\', Helvetica, Arial, sans-serif; font-size: 16px; white-space-collapse: preserve-breaks;\">O apartamento no bairro Parque Industrial com 65 metros quadrados com 2 quartos sendo 1 suite com armários, sala com sacada gourmet, cozinha planejada, 1 banheiro social e 1 vaga de garagem. Possui academia, espaço jardinado, parquinho com diferentes brinquedos, salão para festas e eventos. Vai lhe possibilitar curtir os dias mais quentes na piscina, churrasqueira para você aproveitar nos momentos de descontração. Elevador que garante o transporte das suas malas e compras.<br /></span>Condomínio R$410,00 IPTU R$800,00</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A7989 0.png\",\"alt_text\":\"A7989 0.png\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/A7989 3.jpg\",\"alt_text\":\"A7989 3.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/A7989 1.jpg\",\"alt_text\":\"A7989 1.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/A7989 5.jpg\",\"alt_text\":\"A7989 5.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/A7989 2.jpg\",\"alt_text\":\"A7989 2.jpg\"}}', 'sell', '', '510000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Pq Industrial-', '-23.232508635286152 ,-45.90678075889495', '', '65', '2', '1', '1', '', '0', '[\"8\",\"9\",\"12\",\"16\",\"18\",\"20\",\"22\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2023-10-26 00:00:00', '783', '2024-04-24 17:17:32', '0', NULL),
('1620', 'C3564', 'Casa Geminada À Venda Com 3 Dormitórios.', 'xc3564', '7', '1', '', '<p>Casa geminada à venda. </p>\r\n<p>Possui:</p>\r\n<p>3 dormitórios, sendo 1 com varanda espaçosa</p>\r\n<p>Cozinha</p>\r\n<p>Sala de estar e sala de jantar</p>\r\n<p>Banheiro para hóspedes</p>\r\n<p>Banheiro na parte superior ao lado do quarto</p>\r\n<p>Espaço gourmet com fogão a lenha e churrasqueira </p>\r\n<p>Área externa coberta </p>\r\n<p>Garagem para 2 carros </p>\r\n<p>Portão automático novo</p>\r\n<p>Casa pronta para morar e bairro tranquilo, a 2 minutos da rua principal com escolas, creches, postos de saúde, supermercados, salão de cabeleireiros, farmácias, padarias e muitos outros comércios. De frente para rua principal do bairro Jardim das Cerejeiras.</p>\r\n<p> </p>\r\n<p>Aceita financiamento. Aceita carro até 100 mil como parte de pagamento.</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/C3564 1.jpg\",\"alt_text\":\"C3564 1.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/C3564 3.jpg\",\"alt_text\":\"C3564 3.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/C3564 2.jpg\",\"alt_text\":\"C3564 2.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/C3564 4.jpg\",\"alt_text\":\"C3564 4.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/C3564 5.jpg\",\"alt_text\":\"C3564 5.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/C3564 6.jpg\",\"alt_text\":\"C3564 6.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/C3564 7.jpg\",\"alt_text\":\"C3564 7.jpg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/C3564 12.jpg\",\"alt_text\":\"C3564 12.jpg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/C3564 9.jpg\",\"alt_text\":\"C3564 9.jpg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/C3564 13.jpg\",\"alt_text\":\"C3564 13.jpg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/C3564 11.jpg\",\"alt_text\":\"C3564 11.jpg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/C3564 10.jpg\",\"alt_text\":\"C3564 10.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/C3564 8.jpg\",\"alt_text\":\"C3564 8.jpg\"}}', 'sell', '', '570.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'SÃO JOSÉ DOS CAMPOS', 'Jardim das Cerejeiras', '-23.194545,-45.78963', '12225-540', '150', '3', '2', '2', '', '0', '[\"8\",\"12\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2023-12-04 00:00:00', '783', '2023-12-08 10:10:13', '0', NULL),
('1623', 'C3562', 'Sobrado em Condomínio Fechado Veredas dos Campos', 'xc3562', '7', '1', '', '<p>Casa à venda no condomínio Veredas dos Campos</p>\r\n<p>Zona Leste de SJC</p>\r\n<p>3 quartos ( 1 suíte)</p>\r\n<p>Garagem para 4 Carros</p>\r\n<p>Móveis planejados na sala e cozinha</p>\r\n<p>Acabamento em Quartzo e Granito</p>\r\n<p>Área Gourmet com churrasqueira e ilha</p>\r\n<p>Porcelanato nos banheiros e piso inferior, Piso Vinilico no piso superior</p>\r\n<p>ENERGIA FOTOVOLTAICA</p>\r\n<p> </p>\r\n<p>CONDOMINIO R$300,00</p>\r\n<p>Área de Lazer com quadras de beach tenis e volei, campo gramado e playground</p>\r\n<p>Portaria e segurança 24 hs</p>\r\n<p>Baixo valor de condomínio</p>\r\n<p> </p>\r\n<p>PERMUTA APENAS POR TERRENO NO MESMO CONDOMINIO</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/C3562 5.jpg\",\"alt_text\":\"C3562 5.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/C3562 4.jpg\",\"alt_text\":\"C3562 4.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/C3562 2.jpg\",\"alt_text\":\"C3562 2.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/C3562 3.jpg\",\"alt_text\":\"C3562 3.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/C3562 1.jpg\",\"alt_text\":\"C3562 1.jpg\"}}', 'sell', '', '1350000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos ', 'Jardim Itapoã', '-23.140225,-45.779556', '12247-400', '250', '3', '4', '4', '', '0', '[\"8\",\"21\",\"27\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2023-12-03 00:00:00', '783', '2025-05-02 12:32:44', '0', NULL),
('1625', 'C3561', 'Casa alto padrão Reserva do Paratehy - Urbanova', 'xc3561', '7', '1', '', '<p>CASA PANORAMA</p>\r\n<p> </p>\r\n<p>Projetada por Otta Albernaz Arquitetura</p>\r\n<p> </p>\r\n<p>Ambientes:</p>\r\n<p> </p>\r\n<p>- 4 suítes com closet (acesso íntimo para os quartos)</p>\r\n<p>- Sala de estar e jantar integradas</p>\r\n<p>- Lavabo</p>\r\n<p>- Cozinha (com possibilidade de fechamento)</p>\r\n<p>- Despensa</p>\r\n<p>- Área Gourmet</p>\r\n<p>- Banheiro de Lazer</p>\r\n<p>- Piscina com SPA, prainha e espelho d?água</p>\r\n<p>- Pátio externo com vista privilegiada para as montanhas</p>\r\n<p>- Lavanderia interna com pátio externo</p>\r\n<p>- Hobby Box com 5 metros de comprimento</p>\r\n<p>- Garagem para 3 carros cobertos</p>\r\n<p>- Depósito multiuso</p>\r\n<p> </p>\r\n<p>Diferenciais:</p>\r\n<p> </p>\r\n<p>- Elevador instalado</p>\r\n<p>- Paisagismo por @leticiafortunapaisagismo</p>\r\n<p>- Area verde livre multiuso</p>\r\n<p>- Boiler e placas solares instalados</p>\r\n<p>- Infra de Ar Condicionado preparada</p>\r\n<p>- Infra de Aquecimento de piscina preparada</p>\r\n<p>- Infra de Automação preparada</p>\r\n<p>- Infra de Aspiração Central preparada</p>\r\n<p>- Tomada para carro elétrico</p>\r\n<p>- Acabamentos de primeira linha</p>\r\n<p>Dados:</p>\r\n<p>- 995 m2 de terreno</p>\r\n<p>- 600 m2 de área construída<br />Condomínio R$1192,00  IPTU R$820,00</p>\r\n<p> </p>\r\n<p> </p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/C3561 1.jpg\",\"alt_text\":\"C3561 1.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/C3561 2.jpg\",\"alt_text\":\"C3561 2.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/C3561 10.jpg\",\"alt_text\":\"C3561 10.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/C3561 12.jpg\",\"alt_text\":\"C3561 12.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/C3561 3.jpg\",\"alt_text\":\"C3561 3.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/C3561 4.jpg\",\"alt_text\":\"C3561 4.jpg\"},\"gallery18\":{\"photo\":\"im