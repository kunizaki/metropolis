('1894', 'A8124', 'Pq. Resid. Flamboyant/Mirante Flamboyant- 53 m2/2 quartos, sacada, cz.planejada, 2 vgs gar, lazer', 'xa8124', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">O Apto está localizado no Parque Residencial Flamboyant/ Mirante Flamboyant  Clube Residencial</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Apto com 53 metros quadrados</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 quartos sendo 1 suite com armários embutidos</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- banheiros com box/gabinete</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sala com sacada com sol da tarde</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Cozinha planejada</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 vagas de garagem</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">Area de lazer com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Possui academia, </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- espaço gourmet, </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- parquinho com diferentes brinquedos, </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- área verde de jardim, </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- espaço para festas,</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- piscina, </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- quadra poliesportiva</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Churrasqueira</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Elevador</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Mini mercado<br /><br />Condomínio R$316,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/A8124 1.jpg\",\"alt_text\":\"A8124 1.jpg\"},\"gallery10\":{\"photo\":\"images/gallery/A8124 10.jpg\",\"alt_text\":\"A8124 10.jpg\"},\"gallery5\":{\"photo\":\"images/gallery/A8124 5.jpg\",\"alt_text\":\"A8124 5.jpg\"},\"gallery4\":{\"photo\":\"images/galler