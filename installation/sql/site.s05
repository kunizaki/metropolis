('1813', 'A8089', 'conjunto-residencial-trinta-e-um-de-marco', 'xa8089', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">O apartamento está localizado no Conjunto Residencial Trinta e Um de Março com 94 m2 com 3 quartos sendo 1 suite com armárias, cozinha planejada, sacada gourmet, banheiros com box/gabinete, 2 vagas de garagem.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Possui academia, área verde de jardim, área de recreação infantil, salão para festas e eventos.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Vai lhe possibilitar curtir os dias mais quentes na piscina, elevador para mais praticidade no dia-a-dia.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Churrasqueira para você aproveitar nos momentos de descontração.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Condomínio R$550,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A8089 1.jpg\",\"alt_text\":\"A8089 1.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/A8089 6.jpg\",\"alt_text\":\"A8089 6.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/A8089 2.jpg\",\"alt_text\":\"A8089 2.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/A8089 4.jpg\",\"alt_text\":\"A8089 4.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/A8089 5.jpg\",\"alt_text\":\"A8089 5.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/A8089 3.jpg\",\"alt_text\":\"A8089 3.jpg\"}}', 'sell', '', '860000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Conjunto Residencial Trinta e Um de Março', '-23.246249,-45.915594', '12237-550', '94', '3', '2', '2', '', '0', '[\"8\",\"9\",\"12\",\"16\",\"18\",\"21\",\"22\",\"24\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2024-06-16 00:00:00', '783', '2024-06-20 11:58:59', '0', NULL),
('1814', 'C3626', 'monte-castelo-sobrado-230-m2-com-3-quartos-ste-sacada-4-vgs-gar', 'xc3626', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">O sobrado no bairro Monte Castelo possui 230 m2 com 3 quartos sendo 1 suite, sala com sacada, porão, cozinha com armários, churrasqueira e fogão à lenha, 4 vagas de garagem. Aceita permuta por apartamento e  propostas.</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/C3626 1.jpg\",\"alt_text\":\"C3626 1.jpg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/C3626 13.jpg\",\"alt_text\":\"C3626 13.jpg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/C3626 10.jpg\",\"alt_text\":\"C3626 10.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/C3626 2.jpg\",\"alt_text\":\"C3626 2.jpg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/C3626 11.jpg\",\"alt_text\":\"C3626 11.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/C3626 4.jpg\",\"alt_text\":\"C3626 4.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/C3626 8.jpg\",\"alt_text\":\"C3626 8.jpg\"},\"gallery14\":{\"photo\":\"images\\/gallery\\/C3626 14.jpg\",\"alt_text\":\"C3626 14.jpg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/C3626 12.jpg\",\"alt_text\":\"C3626 12.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/C3626 5.jpg\",\"alt_text\":\"C3626 5.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/C3626 3.jpg\",\"alt_text\":\"C3626 3.jpg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/C3626 9.jpg\",\"alt_text\":\"C3626 9.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/C3626 7.jpg\",\"alt_text\":\"C3626 7.jpg\"},\"gallery15\":{\"photo\":\"images\\/gallery\\/C3626 15.jpg\",\"alt_text\":\"C3626 15.jpg\"},\"gallery18\":{\"photo\":\"images\\/gallery\\/C3626 18.jpg\",\"alt_text\":\"C3626 18.jpg\"},\"gallery19\":{\"photo\":\"images\\/gallery\\/C3626 19.jpg\",\"alt_text\":\"C3626 19.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/C3626 6.jpg\",\"alt_text\":\"C3626 6.jpg\"},\"gallery16\":{\"photo\":\"images\\/gallery\\/C3626 16.jpg\",\"a