('1782', 'A8074', 'Bom Retiro/ Campo das Tulipas- Apto 42 m2 com 2 quartos, coz.planejada, 1 vg garagem', 'xa8074', '1', '1', '', '<p>O apartamento está localizado no bairro Bom Retiro, Condominio Residencial Campo das Tulipas tem 42 m2 com 2 quartos, cozinha planejada, banheiro com box/gabinete, 1 vaga de garagem.</p>\r\n<p>Condominio com salão para festas e eventos e Churrasqueira para você aproveitar nos momentos de descontração.</p>\r\n<p>Condominio R$288,00   IPTU R$480,00</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A8074 1.jpg\",\"alt_text\":\"A8074 1.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/A8074 2.jpg\",\"alt_text\":\"A8074 2.jpg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/A8074 9.jpg\",\"alt_text\":\"A8074 9.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/A8074 5.jpg\",\"alt_text\":\"A8074 5.jpg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/A8074 11.jpg\",\"alt_text\":\"A8074 11.jpg\"},\"gallery14\":{\"photo\":\"images\\/gallery\\/A8074 14.jpg\",\"alt_text\":\"A8074 14.jpg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/A8074 12.jpg\",\"alt_text\":\"A8074 12.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/A8074 4.jpg\",\"alt_text\":\"A8074 4.jpg\"},\"gallery15\":{\"photo\":\"images\\/gallery\\/A8074 15.jpg\",\"alt_text\":\"A8074 15.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/A8074 6.jpg\",\"alt_text\":\"A8074 6.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/A8074 3.jpg\",\"alt_text\":\"A8074 3.jpg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/A8074 13.jpg\",\"alt_text\":\"A8074 13.jpg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/A8074 10.jpg\",\"alt_text\":\"A8074 10.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/A8074 8.jpg\",\"alt_text\":\"A8074 8.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/A8074 7.jpg\",\"alt_text\":\"A8074 7.jpg\"},\"gallery16\":{\"photo\":\"images\\/gallery\\/A8074 16.jpg\",\"alt_text\":\"A8074 16.jpg\"}}', 'sell', '', '235000.00', '', '', 'BRL:R$', '1