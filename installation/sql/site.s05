('1925', 'A5327', 'Jd. Aquarius- Apto de 68 m2 com 2 quartos(suite), coz.plan, sacada, 1 vg garagem', 'xa5327', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">- O Apto no Pq Residencial Aquarius possui 68 m2</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Com 2 quartos sendo 1 suite com armários</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Banheiros com box/gabinete</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Cozinha planejada</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sala com sacada ampla</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Uma vaga de garagem</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Possui área de recreação infantil, salão para festas e eventos.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Piscina</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Churrasqueira</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Elevador que garante o transporte das suas malas e compras.<br /><br />Condomínio R$750,00   IPTU R$1320,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A5327 2.JPG\",\"alt_text\":\"A5327 2.JPG\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/A5327 7.jpg\",\"alt_text\":\"A5327 7.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/A5327 5.jpg\",\"alt_text\":\"A5327 5.jpg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/A5327 12.jpg\",\"alt_text\":\"A5327 12.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/A5327 8.jpg\",\"alt_text\":\"A5327 8.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/A5327 6.jpg\",\"alt_text\":\"A5327 6.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/A5327 1.jpg\",\"alt_text\":\"A5327 1.jpg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/A5327 11.jpg\",\"alt_text\":\"A5327 11.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/A5327 4.jpg\",\"alt_text\":\"A5327 4.jpg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/A5327 10.jpg\",\"alt_text\":\"A5327 10.jpg\"},\"gallery9\":{\"photo\":\"images\\/gal