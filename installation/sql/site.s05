('1879', 'C3647', 'Bosque Eucaliptos- Casa térrea de 140 m2 com 3 quartos(suite), armários, coz.planejada, 4 vg garagem', 'xc3647', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">Casa térrea na Reserva do Bosque, com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Área terreno de 225 m2 </span></p>\r\n<p><span style=\"font-size: 12.16px;\">Área construída de 140 m2 aproximadamente</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 3 dormitórios sendo 1suíte</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 1Banheiros social</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 4 Vagas de garagem</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Pode ser usado como ponto comercial </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Estuda permuta até 50%</span></p>', '', NULL, NULL, '{\"gallery2\":{\"photo\":\"images/gallery/WhatsApp Image 2024-08-23 at 11.09.51.jpeg\",\"alt_text\":\"WhatsApp Image 2024-08-23 at 11.09.51.jpeg\"},\"gallery3\":{\"photo\":\"images/gallery/WhatsApp Image 2024-08-23 at 11.09.57.jpeg\",\"alt_text\":\"WhatsApp Image 2024-08-23 at 11.09.57.jpeg\"},\"gallery14\":{\"photo\":\"images/gallery/WhatsApp Image 2024-08-23 at 11.09.51 2.jpeg\",\"alt_text\":\"WhatsApp Image 2024-08-23 at 11.09.51 2.jpeg\"},\"gallery5\":{\"photo\":\"images/gallery/WhatsApp Image 2024-08-23 at 11.09.55 1.jpeg\",\"alt_text\":\"WhatsApp Image 2024-08-23 at 11.09.55 1.jpeg\"},\"gallery12\":{\"photo\":\"images/gallery/WhatsApp Image 2024-08-23 at 11.09.52.jpeg\",\"alt_text\":\"WhatsApp Image 2024-08-23 at 11.09.52.jpeg\"},\"gallery4\":{\"photo\":\"images/gallery/WhatsApp Image 2024-08-23 at 11.09.56.jpeg\",\"alt_text\":\"WhatsApp Image 2024-08-23 at 11.09.56.jpeg\"},\"gallery10\":{\"photo\":\"images/gallery/WhatsApp Image 2024-08-23 at 11.09.53.jpeg\",\"alt_text\":\"WhatsApp Image 2024-08-23 at 11.09.53.jpeg\"},\"gallery7\":{\"photo\":\"images/gallery/WhatsApp Image 2024-08-23 at 11.09.54 1.jpeg\",\"alt_text\":\"WhatsApp Image 2024-08-23 at