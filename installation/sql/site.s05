('1870', 'A8116', 'Urbanova/Res. Bosque paratehy- Apto 63 m2 com 2 quartos(suite=sacada), sala +sacada, coz.plan, 1 vg', 'xa8116', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">Apto recém construído no Condomínio Bosque Paratehy com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 63 m2 de área útil</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 dormitórios (sendo 1 suíte)</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sala de estar/jantar, cozinha aberta</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 1 vaga de garagem no subsolo</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">Possui diferenciais como:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">-  garagem coberta</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- sacada na suíte e na sala</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- piso laminado</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- persianas</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- infraestrutura para ar condicionado</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- oferece lazer completo no condomínio, incluindo piscina, academia, salão de festas</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- cortina de vidro nas duas sacadas</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Box até o teto em todos os banheiros</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- quarto repleto de armários<br /><br />Condomínio R$680,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A8116 0.jpg\",\"alt_text\":\"A8116 0.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/A8116 7.jpg\",\"alt_text\":\"A8116 7.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/A8116 8.jpg\",\"alt_text\":\"A8116 8.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/A8116 6.jpg\",\"alt_text\":\"A8116 6.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/A8116 5.jpg\",\"alt_text\":\"A8116 5.jpg\"},\"g