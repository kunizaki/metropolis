('1646', 'T1199', 'Residencial Portal dos Pássaros', 'xt1199', '6', '1', '', '<p>Lote plano no Res. Portal dos Pássaros, no bairro  Recanto dos Eucaliptos, com 238m2, plano, com toda infraestrutura. Valor de venda a R$ 380mil ou R$ 240mil transferindo o Saldo Devedor.</p>\r\n<p>IPTU R$760,00</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/T1199 1.jpg\",\"alt_text\":\"T1199 1.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/T1199 6.jpg\",\"alt_text\":\"T1199 6.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/T1199 4.jpg\",\"alt_text\":\"T1199 4.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/T1199 3.jpg\",\"alt_text\":\"T1199 3.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/T1199 5.jpg\",\"alt_text\":\"T1199 5.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/T1199 2.jpg\",\"alt_text\":\"T1199 2.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/T1199 8.jpg\",\"alt_text\":\"T1199 8.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/T1199 7.jpg\",\"alt_text\":\"T1199 7.jpg\"}}', 'sell', '', '380000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Recanto dos Eucalípitos', '-23.223691,-45.852724', '12227-822', '238', '0', '0', '0', '', '0', NULL, '', '', '', '{}', '1', '*', '1', '0', '783', '2023-12-24 00:00:00', '783', '2024-03-18 11:45:58', '0', NULL),
('1649', 'A8020', 'Apartamento de 72m² com 2 Dormitórios (1 Suíte), No Jardim Veneza.', 'xa8020', '1', '1', '', '<p>- 2 dormitórios com armário planejado (1 suíte)</p>\r\n<p>- 1 wc social</p>\r\n<p>- Sala e varanda com fechamento em vidro</p>\r\n<p>- Teto em gesso rebaixado com iluminação embutida</p>\r\n<p>- Cozinha americana planejada com armários, cooktop, coifa</p>\r\n<p>- Área de serviço</p>\r\n<p>Condomínio: Piscina adulto e infantil, quadra poliesportiva, academia, churrasqueira,  espaço gourmet, bicicletário, coworking, brinquedoteca, quadra de tênis, quadra de futebol de salão.</p>\r\n<p> </p>\r\n<p><span style=\"font-size: 12.16px;\">Condomínio R$420,00      IPTU R$1070,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A8020 1.jpg\",\"alt_text\":\"A8020 1.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/A8020 3.jpg\",\"alt_text\":\"A8020 3.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/A8020 4.jpg\",\"alt_text\":\"A8020 4.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/A8020 8.jpg\",\"alt_text\":\"A8020 8.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/A8020 2.jpg\",\"alt_text\":\"A8020 2.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/A8020 7.jpg\",\"alt_text\":\"A8020 7.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/A8020 5.jpg\",\"alt_text\":\"A8020 5.jpg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/A8020 10.jpg\",\"alt_text\":\"A8020 10.jpg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/A8020 11.jpg\",\"alt_text\":\"A8020 11.jpg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/A8020 9.jpg\",\"alt_text\":\"A8020 9.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/A8020 6.jpg\",\"alt_text\":\"A8020 6.jpg\"}}', 'sell', '', '639000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Jardim Veneza', '-23.240659,-45.910505', '12237-070', '72', '2', '2', '2', '', '0', '[\"8\",\"9\",\"12\",\"16\",\"17\",\"18\",\"21\",\"22\",\"23\",\"27\"]', '', '', '', '{}', '1', '*', '1', '0', '7