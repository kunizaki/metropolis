('1829', 'A8104', 'Palmeiras São José- APTO de 68 m2 com 3 quartos(suite), sacada, coz.planejada, 1 vaga garagem.', 'xa8104', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">O apto no Palmeiras de São José possui 68 m2 com 3 quartos sendo 1 suíte, armários, cozinha planejada, sala com sacada e sol da manhã, banheiros com box/gabinete, 1 vaga de garagem.</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">Área de lazer do condomínio com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Academia</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Condomínio fechado</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Elevador</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Permitido animais</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Salão de festas<br /><br />Condomínio R$395,00     IPTU R$600,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A8104 1.jpg\",\"alt_text\":\"A8104 1.jpg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/A8104 13.jpg\",\"alt_text\":\"A8104 13.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/A8104 2.jpg\",\"alt_text\":\"A8104 2.jpg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/A8104 9.jpg\",\"alt_text\":\"A8104 9.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/A8104 8.jpg\",\"alt_text\":\"A8104 8.jpg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/A8104 10.jpg\",\"alt_text\":\"A8104 10.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/A8104 5.jpg\",\"alt_text\":\"A8104 5.jpg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/A8104 11.jpg\",\"alt_text\":\"A8104 11.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/A8104 4.jpg\",\"alt_text\":\"A8104 4.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/A8104 6.jpg\",\"alt_text\":\"A8104 6.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/A8104 3.jpg\",\"alt_text\":\"A8104 3.jpg\"},\"gallery15\":{\"photo\":\"images\\/gallery\\/A8104 15.jpg\",\"alt_text\":\"A8104 15.jpg\"},\