('1842', 'C3637', 'Jd do Golfe- Sobrado 400 m2 com 4 quartos(4suites), lavabo, piscina, escritório, piscina, 4 vgs gar', 'xc3637', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">Sobrado no Jardim do Golfe II no Urbanova:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Pronta para morar</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Terreno 450 m2 Construção 402 m2 </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 4 suítes sendo uma master</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Escritório</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Home Theater,</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Hobby Box </span></p>\r\n<p><span style=\"font-size: 12.16px;\">_ Sala com Lavabo</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Banheiro externo</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sala de estar e sala de jantar</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Area gourmet completa integrada com cozinha  </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Piscina aquecida</span></p>\r\n<p><span style=\"font-size: 12.16px;\">-  2 vagas cobertas 2 vagas descobertas   </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Construção 2024</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Terreno 450 m área construída 400</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Aquecimento solar boiler aquecimento da piscina solar</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Aceita permuta até 1.200.000 </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Aceita financiamento</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Condominio com: Três quadras de tênis, salão de festas, playground e espaço kids, duas quadras de beach tênis, quadra de basquete / futsal.</span></p>\r\n<p> </p>\r\n<p><span style=\"font-size: 12.16px;\">Condomínio R$1.000,00    IPTU R$4.000,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/C3637 1.jpg\",\"alt_text\":\"C3637 1.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/C3637 2.jpg\",\"alt_text\":\"C3637 2.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/C3637 5.jpg\",\"alt_text\":\"C3637 5.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/C3637 4.jpg\",\"alt_text\":\"C3637 4.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/C3637 3.jpg\",\"alt_text\":\"C3637 3.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/C3637 6.jpg\",\"alt_text\":\"C3637 6.jpg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/C3637 10.jpg\",\"alt_text\":\"C3637 10.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/C3637 8.jpg\",\"alt_text\":\"C3637 8.jpg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/C3637 11.jpg\",\"alt_text\":\"C3637 11.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/C3637 7.jpg\",\"alt_text\":\"C3637 7.jpg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/C3637 9.jpg\",\"alt_text\":\"C3637 9.jpg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/C3637 13.jpg\",\"alt_text\":\"C3637 13.jpg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/C3637 12.jpg\",\"alt_text\":\"C3637 12.jpg\"},\"gallery15\":{\"photo\":\"images\\/gallery\\/C3637 15.jpg\",\"alt_text\":\"C3637 15.jpg\"},\"gallery14\":{\"photo\":\"images\\/gallery\\/C3637 14.jpg\",\"alt_text\":\"C3637 14.jpg\"},\"gallery18\":{\"photo\":\"images\\/gallery\\/C3637 18.jpg\",\"alt_text\":\"C3637 18.jpg\"},\"gallery16\":{\"photo\":\"images\\/gallery\\/C3637 16.jpg\",\"alt_text\":\"C3637 16.jpg\"},\"gallery17\":{\"photo\":\"images\\/gallery\\/C3637 17.jpg\",\"alt_text\":\"C3637 17.jpg\"},\"gallery19\":{\"photo\":\"images\\/gallery\\/C3637 19.jpg\",\"alt_text\":\"C3637 19.jpg\"},\"gallery20\":{\"photo\":\"images\\/gallery\\/C3637 20.jpg\",\"alt_text\":\"C3637 20.jpg\"}}', 'sell', '', '4800000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Jardim do Golfe', '-23.188382,-45.921460', '12244-633', '400', '4', '5', '4', '', '0', '[\"8\",\"9\",\"12\",\"16\",\"21\",\"23\",\"24\",\"27\"]', '', '', '', '