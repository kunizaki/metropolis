('1436', 'C3479', 'Reserva do Bosque - Sobrado 4D (Suíte c/ sacada); 3 Banheiros; Quintal c/ Piscina; Sauna; 6 Vgs', 'xc3479', '7', '1', '', '<p><span style=\"color: #4a4a4a; font-family: \'Nunito Sans\', \'Helvetica Neue\', HelveticaNeue, Helvetica, Arial, sans-serif; font-size: 16px; white-space: pre-line;\">Lindo sobrado na Reserva do Bosque dos Eucaliptos</span></p>\r\n<p> </p>\r\n<p><span style=\"color: #4a4a4a; font-family: \'Nunito Sans\', \'Helvetica Neue\', HelveticaNeue, Helvetica, Arial, sans-serif; font-size: 16px; white-space: pre-line;\"> terreno de 312 m², contendo 4 (quatro) dormitórios (1 suite com varanda intima, closet, banheiro com hidro), sala em \"L\" com lareira, 2 ar condicionados,despensa, nos fundos tem 2 </span><span style=\"color: #4a4a4a; font-family: \'Nunito Sans\', \'Helvetica Neue\', HelveticaNeue, Helvetica, Arial, sans-serif; font-size: 16px; white-space: pre-line;\">quartos + um (01) banheiro, piscina, sauna, e rancho, 2 portões automáticos para autos, vaga para 6 carros, varandão.</span></p>\r\n<p><span style=\"color: #4a4a4a; font-family: \'Nunito Sans\', \'Helvetica Neue\', HelveticaNeue, Helvetica, Arial, sans-serif; font-size: 16px; white-space: pre-line;\">Documentação OK</span></p>\r\n<p><span style=\"color: #4a4a4a; font-family: \'Nunito Sans\', \'Helvetica Neue\', HelveticaNeue, Helvetica, Arial, sans-serif; font-size: 16px; white-space: pre-line;\">Aceita financiamento, FGTS.</span></p>\r\n<p> </p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/C3479 1.jpg\",\"alt_text\":\"C3479 1.jpg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/C3479 12.jpg\",\"alt_text\":\"C3479 12.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/C3479 3.jpg\",\"alt_text\":\"C3479 3.jpg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/C3479 10.jpg\",\"alt_text\":\"C3479 10.jpg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/C3479 11.jpg\",\"alt_text\":\"C3479 11.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/C3479 4.jpg\"