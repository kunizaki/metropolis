('1175', 'M1493', 'Centro - Sala Comercial 44 m²; 2 Banheiros; Ar-Condicionado; Porcelanato', 'xm1493', '3', '1', '', '<p>Centro - Sala comercial de 44 m² para venda com:</p>\r\n<p>- 2 Banheiros;</p>\r\n<p>- Copa;</p>\r\n<p>- Piso em porcelanato;</p>\r\n<p>- Ar-condicionado;</p>\r\n<p>- Uma vaga coberta.</p>\r\n<p> </p>\r\n<p>Auditório no edifício;</p>\r\n<p>Elevador;</p>\r\n<p>Aceito permuta por imóvel até 150 mil.</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/M1493 1.jpg\",\"alt_text\":\"M1493 1.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/M1493 2.jpg\",\"alt_text\":\"M1493 2.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/M1493 3.jpg\",\"alt_text\":\"M1493 3.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/M1493 4.jpg\",\"alt_text\":\"M1493 4.jpg\"}}', 'sell', '', '330000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Rua Marechal Floriano Peixoto', '-23.189037,-45.884182', '12210030', '44', '0', '2', '1', '', '0', '[\"1\",\"8\",\"15\",\"22\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2022-05-09 00:00:00', '783', '2022-05-13 17:21:42', '0', NULL),
('1181', 'C3389', 'Bosque dos Eucaliptos - Sobrado 3D (Suíte); 3 Banheiros (Lavabo); Cozinha planejada; Churrasqueira; 4 Vagas', 'xc3389', '2', '1', '', '<p><span style=\"color: #4a4a4a; font-family: \'Nunito Sans\', \'Helvetica Neue\', HelveticaNeue, Helvetica, Arial, sans-serif; font-size: 16px; white-space: pre-line;\">Vende-se sobrado com 135m de construção. São 3 dorm., sendo 1 suite, 1 banheiro social, 1 lavabo, 2 salas de estar, 1 sala de jantar, cozinha com armários planejados e dispensa, área com churrasqueira, garagem para 4 carros e portão automático. Piso frio.</span></p>\r\n<p> </p>\r\n<p><span style=\"color: #4a4a4a; font-family: \'Nunito Sans\', \'Helvetica Neue\', HelveticaNeue, Helvetica, Arial, sans-serif; font-size: 16px; white-space: pre-line;\">Muito próx. da ubs, creche, escolas adventista, cristã, sesi, farmácia, bancos e supermercados. Ótima oportunidade de morar bem.</span></p>\r\n<p><span style=\"color: #4a4a4a; font-family: \'Nunito Sans\', \'Helvetica Neue\', HelveticaNeue, Helvetica, Arial, sans-serif; font-size: 16px; white-space: pre-line;\">Analisa permuta por apartamento nos bairros Jd. Satélite, bosque, jd. estoril, parque industrial e jd america.</span></p>\r\n<p><span style=\"color: #4a4a4a; font-family: \'Nunito Sans\', \'Helvetica Neue\', HelveticaNeue, Helvetica, Arial, sans-serif; font-size: 16px; white-space: pre-line;\">Imóvel escriturado e sem restrições;</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/C3389 2.jpg\",\"alt_text\":\"C3389 2.jpg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/C3389 8.jpg\",\"alt_text\":\"C3389 8.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/C3389 5.jpg\",\"alt_text\":\"C3389 5.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/C3389 1.jpg\",\"alt_text\":\"C3389 1.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/C3389 0.jpg\",\"alt_text\":\"C3389 0.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/C3389 3.jpg\",\"alt_text\":\"C3389 3.jpg\"},\"gallery14\"