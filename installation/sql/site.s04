('1509', 'C3519', 'Res. Mantiqueira- Sobrado 286 m2, 3 quartos (ste) sacada, churrasq, 2 vgs', 'xc3519', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">A casa de condomínio sobrado no bairro Condomínio Residencial Mantiqueira possui 286 metros quadrados com 3 quartos sendo 1 suite e 3 banheiros, área gourmet, sacada, piscina, 2 vagas de garagem. Excelente localização, próximo a quadra e playground, na parte alta do condomínio.</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Possui área de recreação infantil e espaço pet</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Vai lhe possibilitar praticar diversos esportes na quadra poliesportiva.</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/310371740356604.jpg\",\"alt_text\":\"310371740356604.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/313339266180117.jpg\",\"alt_text\":\"313339266180117.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/318338142656231.jpg\",\"alt_text\":\"318338142656231.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/316359860164192.jpg\",\"alt_text\":\"316359860164192.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/316351142513285.jpg\",\"alt_text\":\"316351142513285.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/318335029101819.jpg\",\"alt_text\":\"318335029101819.jpg\"}}', 'sell', '', '1390000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Rua Bom Repouso, Condomínio Portal Mantiqueira', '-23.137839,-45.915645', '12213659', '252', '3', '2', '2', '', '0', '[\"8\",\"9\",\"12\",\"21\",\"23\",\"27\"]', '', '', '', '{}', '1', 'pt-BR', '1', '0', '783', '1936-09-11 00:00:00', '783', '2023-03-31 09:57:39', '0', NULL),
('1516', 'C3525', 'Casa no Villa Branca, Jacareí - área de 166 m2, 3 quartos (1 suíte) e 2 vagas na garagem coberta', 'xc3525', '7', '1', '', '<p><span style=\"font-size: 12.16px;\">- Casa belíssima, no Vila Branca (bairro nobre)</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Área de 166 m2, com 3 quartos (1 suíte) e 2 vagas na garagem (coberta)</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sala e copa com pé direito de 5m</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Cozinha e espaço gourmet</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Lavabo</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Suíte c/ closet</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 vagas em garagem coberta</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">Aceita financiamento e FGTS</span></p>\r\n<p><span style=\"font-size: 12.16px;\">IPTU: R$1260/ano</span></p>', '', NULL, NULL, '{\"gallery5\":{\"photo\":\"images\\/gallery\\/C3525 6.jpg\",\"alt_text\":\"C3525 6.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/C3525 3.jpg\",\"alt_text\":\"C3525 3.jpg\"},\"gallery1\":{\"photo\":\"images\\/gallery\\/C3525 2.jpg\",\"alt_text\":\"C3525 2.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/C3525 9.jpg\",\"alt_text\":\"C3525 9.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/C3525 8.jpg\",\"alt_text\":\"C3525 8.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/C3525 7.jpg\",\"alt_text\":\"C3525 7.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/C3525 5.jpg\",\"alt_text\":\"C3525 5.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/C3525 4.jpg\",\"alt_text\":\"C3525 4.jpg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/C3525 10.jpg\",\"alt_text\":\"C3525 10.jpg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/C3525 11.jpg\",\"alt_text\":\"C3525 11.jpg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/C3525 12.jpg\",\"alt_text\":\"C3525 12.jpg\"},\"gallery12\":{\"photo\":\"images\\/g