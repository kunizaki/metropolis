('1284', 'T1160', 'Bairro Floresta - Terreno 278m² em Condomínio Fechado', 'xt1160', '6', '1', '', '<p>Terreno de 278 m² em condomínio fechado de alto padrão com lazer completo: salão de festas, piscina, quadra poliesportiva, churrasqueira, academia e muita área verde. Estacionamento para visitantes e segurança.</p>\r\n<p>Aceita permuta por casa na Zona Sul.</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/0.jpg\",\"alt_text\":\"0.jpg\"}}', 'sell', '', '370000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Rua Joel Faria', '-23.229930,-45.826903', '12226376', '278', '0', '0', '0', '', '0', '[\"1\",\"9\",\"12\",\"16\",\"18\",\"23\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2022-07-08 00:00:00', '783', '2022-07-08 16:46:19', '0', NULL),
('1289', 'C3420', 'Parque Industrial - Casa: 2D(1 Suíte); 2 Banheiro; Quintal; 2 Vagas cobertas', 'xc3420', '1', '1', '', '<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\"><span style=\"box-sizing: border-box; z-index: 2;\">Casa de 150m² no Parque Industrial para venda com:</span></p>\r\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\"> </p>\r\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\"><span style=\"box-sizing: border-box; z-index: 2;\">03 Dormitórios, sendo 1 suíte, 2 Banheiros</span><span style=\"box-sizing: border-box; z-index: 2;\">; </span><span style=\"box-sizing: border-box; z-index: 2;\">Área de serviço; Quintal; Piso de madeira nos quartos e cerâmica nos demais cômodos</span><span style=\"box-sizing: border-box; z-index: 2;\">. 2 vagas de Garagem cobertas</span></p>\r\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\"> </p>\r\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\"><span style=\"box-sizing: border-box; z-index: 2;\">Somente venda</span></p>\r\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\"> </p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/C3420 1.jpg\",\"alt_text\":\"C3420 1.jpg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/C3420 13.jpg\",\"alt_text\":\"C3420 13.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/C3420 5.jpg\",\"alt_text\":\"C3420 5.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/C3420 4.jpg\",\"alt_text\":\"C3420 4.jpg\"},\"gallery6\":{\"photo\":\"images\\/ga