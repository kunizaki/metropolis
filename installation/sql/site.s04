('1542', 'C3544', 'Jd. Das Industrias-Casa 170 m2, 3 quartos(suite), arms, coz planejada, 2 vagas', 'x3544', '7', '1', '', '<p><span class=\"ad__sc-1sj3nln-1 fMgwdS sc-bZQynM gXnDHl\" data-ds-component=\"DS-Text\">A casa no bairro Jardim das Indústrias com 170 metros quadrados com 3 quartos com armários sendo 1 suite e 3 banheiros, mezanino, cozinha planejada, piso em madeira e porcelanato, Churrasqueira para você aproveitar nos momentos de descontração. Possível permuta com terreno ou carro. Aceita financiamento. IPTU R$700,00<br /></span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/C3544 13.jpg\",\"alt_text\":\"C3544 13.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/C3544 1.jpg\",\"alt_text\":\"C3544 1.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/C3544 12.jpg\",\"alt_text\":\"C3544 12.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/C3544 10.jpg\",\"alt_text\":\"C3544 10.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/C3544 4.jpg\",\"alt_text\":\"C3544 4.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/C3544 9.jpg\",\"alt_text\":\"C3544 9.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/C3544 3.jpg\",\"alt_text\":\"C3544 3.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/C3544 5.jpg\",\"alt_text\":\"C3544 5.jpg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/C3544 11.jpg\",\"alt_text\":\"C3544 11.jpg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/C3544 6.jpg\",\"alt_text\":\"C3544 6.jpg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/C3544 7.jpg\",\"alt_text\":\"C3544 7.jpg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/C3544 14.jpg\",\"alt_text\":\"C3544 14.jpg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/C3544 2.jpg\",\"alt_text\":\"C3544 2.jpg\"},\"gallery14\":{\"photo\":\"images\\/gallery\\/C3544 15.jpg\",\"alt_text\":\"C3544 15.jpg\"}}', 'sell', '', '990000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Jardim das Indústrias', '-23.228844349311824,-45.92086884076462', '', '