('1204', 'A7790', ' Vila Rangel - Apto 2D; 1 Banheiro; Cozinha Planejada; Armários Planejados; 1 Vaga', 'xa7790', '1', '1', '', '<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\">Zona Norte - Vila Rangel - Apto. de 44 m² para venda com:</p>\r\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\">- 2 Dormitórios;</p>\r\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\">- 1 Banheiro social;</p>\r\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\">- Sala dois ambientes;</p>\r\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\">- Armários embutidos nos quartos;</p>\r\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\">- Cozinha com armários embutidos planejados;</p>\r\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\">- Área de serviço;</p>\r\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\">- Piso em cerâmica;</p>\r\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\">- 1 Vaga de garagem coberta.</p>\r\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\"> </p>\r\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\">Em cond. fechado e área de lazer com:</p>\r\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\">- Salão de festas;</p>\r\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\">- Playground;</p>\r\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; z-index: 2; color: #000000; font-family: Catamaran, sans-serif; font-size: 16px;\">- Quadra Poliesportiva;</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A7790 1.jpg\",\"alt_text\":\"A7790 1.jpg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/A7790 10.jpg\",\"alt_text\":\"A7790 10.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/A7790 2.jpg\",\"alt_text\":\"A7790 2.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/A7790 4.jpg\",\"alt_text\":\"A7790 4.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/A7790 7.jpg\",\"alt_text\":\"A7790 7.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/A7790 8.jpg\",\"alt_text\":\"A7790 8.jpg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/A7790 11.jpg\",\"alt_text\":\"A7790 11.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/A7790 3.jpg\",\"alt_text\":\"A7790 3.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/A7790 6.jpg\",\"alt_text\":\"A7790 6.jpg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/A7790 9.jpg\",\"alt_text\":\"A7790 9.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/A7790 5.jpg\",\"alt_text\":\"A7790 5.jpg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/A7790 12.jpg\",\"alt_text\":\"A7790 12.jpg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/A7790 13.jpg\",\"alt_text\":\"A7790 13.jpg\"}}', 'sell', '', '180000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Vila Rangel', '-23.157400,-45.892176', '12211463', '44', '2', '1', '1', '', '0', '[\"8\",\"16\",\"21\",\"23\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2022-05-23