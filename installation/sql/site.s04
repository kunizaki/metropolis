('1383', 'xt1176', 'Cond. Bella Vittá - Terreno 384m² em cond. fechado completo', 'xt1176', '6', '1', '', '<p><span style=\"color: #4a4a4a; font-family: \'Nunito Sans\', \'Helvetica Neue\', HelveticaNeue, Helvetica, Arial, sans-serif; font-size: 16px; white-space: pre-line;\">Terreno de 384m² em condomínio fechado (Bella Vittá), localizado em Caçapava, próximo às empresas: Embraer, Pilkington, Cebrace e outras.</span></p>\r\n<p> </p>\r\n<p><span style=\"color: #4a4a4a; font-family: \'Nunito Sans\', \'Helvetica Neue\', HelveticaNeue, Helvetica, Arial, sans-serif; font-size: 16px; white-space: pre-line;\">Terreno em declive.</span></p>\r\n<p> </p>\r\n<p><span style=\"color: #4a4a4a; font-family: \'Nunito Sans\', \'Helvetica Neue\', HelveticaNeue, Helvetica, Arial, sans-serif; font-size: 16px; white-space: pre-line;\">Condomínio conta com ampla área de lazer com:</span></p>\r\n<p><span style=\"color: #4a4a4a; font-family: \'Nunito Sans\', \'Helvetica Neue\', HelveticaNeue, Helvetica, Arial, sans-serif; font-size: 16px; white-space: pre-line;\">- Salão de festas</span></p>\r\n<p><span style=\"color: #4a4a4a; font-family: \'Nunito Sans\', \'Helvetica Neue\', HelveticaNeue, Helvetica, Arial, sans-serif; font-size: 16px; white-space: pre-line;\">- Churrasqueiras</span></p>\r\n<p><span style=\"color: #4a4a4a; font-family: \'Nunito Sans\', \'Helvetica Neue\', HelveticaNeue, Helvetica, Arial, sans-serif; font-size: 16px; white-space: pre-line;\">- Quadras poliesportivas</span></p>\r\n<p><span style=\"color: #4a4a4a; font-family: \'Nunito Sans\', \'Helvetica Neue\', HelveticaNeue, Helvetica, Arial, sans-serif; font-size: 16px; white-space: pre-line;\">- Academia</span></p>\r\n<p><span style=\"color: #4a4a4a; font-family: \'Nunito Sans\', \'Helvetica Neue\', HelveticaNeue, Helvetica, Arial, sans-serif; font-size: 16px; white-space: pre-line;\">- Piscina</span></p>\r\n<p><span style=\"color: #4a4a4a; font-family: \'Nunito Sans\', \'Helvetica Neue\', HelveticaNeue, Helvetica, Arial, sans-serif; font-size: 16px; white-space: pre-line;\">- Área verde e lago (Área de preservação permanente).</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/T1176 1.jpg\",\"alt_text\":\"T1176 1.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/T1176 7.jpg\",\"alt_text\":\"T1176 7.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/T1176 3.jpg\",\"alt_text\":\"T1176 3.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/T1176 6.jpg\",\"alt_text\":\"T1176 6.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/T1176 2.jpg\",\"alt_text\":\"T1176 2.jpg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/T1176 9.jpg\",\"alt_text\":\"T1176 9.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/T1176 8.jpg\",\"alt_text\":\"T1176 8.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/T1176 5.jpg\",\"alt_text\":\"T1176 5.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/T1176 4.jpg\",\"alt_text\":\"T1176 4.jpg\"}}', 'sell', '', '180000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Estr. Santa Luzia II', '-23.145860,-45.754624', '12247004', '384', '0', '0', '0', '', '0', '[\"8\",\"9\",\"12\",\"16\",\"18\",\"21\",\"23\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2022-08-28 00:00:00', '783', '2022-08-29 16:01:15', '0', NULL),
('1388', 'C3454', 'Jd Aquarius-Sunset Park- Sobrado de 4 Dorms (2 suites), 2 vgs garagem, piscina, churrasqueira', 'xc3454', '7', '1', '', '<p>O sobrado no bairro Condomínio Sunset Park, Jd. Aquairus tem:<br />- 285 metros quadrados de área útil em lote de 360m2<br />- 4 quartos sendo 2 suites com banheira<br />- cozinha planejada<br />- sacada nos quartos<br />- sala ampla com lavabo<br />- ar-condicionado<br />- piscina<br />- churrasqueira<br />- duas vagas de garagem cobertas<br />- frente à praça japonesa<br />- ótima localização shopping, lojas, bancos, restaurantes</p>\r\n<p>- Condomínio de R$ 640,00</p>\r\n<p>- Iptu de R$ 2.690,00</p>', '', NULL, NULL, '{\"gallery13\":{\"photo\":\"images\\/gallery\\/C3454 1.jpg\",\"alt_text\":\"C3454 1.jpg\"},\"gallery19\":{\"photo\":\"images\\/gallery\\/C3454 7.jpg\",\"alt_text\":\"C3454 7.jpg\"},\"gallery17\":{\"photo\":\"images\\/gallery\\/C3454 5.jpg\",\"alt_text\":\"C3454 5.jpg\"},\"gallery16\":{\"photo\":\"images\\/gallery\\/C3454 4.jpg\",\"alt_text\":\"C3454 4.jpg\"},\"gallery20\":{\"photo\":\"images\\/gallery\\/C3454 8.jpg\",\"alt_text\":\"C3454 8.jpg\"},\"gallery15\":{\"photo\":\"images\\/gallery\\/C3454 3.jpg\",\"alt_text\":\"C3454 3.jpg\"},\"gallery18\":{\"photo\":\"images\\/gallery\\/C3454 6.jpg\",\"alt_text\":\"C3454 6.jpg\"},\"gallery14\":{\"photo\":\"images\\/gallery\\/C3454 2.jpg\",\"alt_text\":\"C3454 2.jpg\"},\"gallery21\":{\"photo\":\"images\\/gallery\\/C3454 9.jpg\",\"alt_text\":\"C3454 9.jpg\"},\"gallery22\":{\"photo\":\"images\\/gallery\\/C3454 10.jpg\",\"alt_text\":\"C3454 10.jpg\"},\"gallery24\":{\"photo\":\"images\\/gallery\\/C3454 12.jpg\",\"alt_text\":\"C3454 12.jpg\"},\"gallery23\":{\"photo\":\"images\\/gallery\\/C3454 11.jpg\",\"alt_text\":\"C3454 11.jpg\"},\"gallery25\":{\"photo\":\"images\\/gallery\\/C3454 13.jpg\",\"alt_text\":\"C3454 13.jpg\"},\"gallery27\":{\"photo\":\"images\\/gallery\\/C3454 12.jpg\",\"alt_text\":\"C3454 12.jpg\"},\"gallery30\":{\"photo\":\"images\\/gallery\\/C3454 15.jpg\