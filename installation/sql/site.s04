('1389', 'T1177', 'Cond. Portal Mantiqueira - Terreno de 252m² à venda', 'xt1177', '6', '1', '', '<p><span style=\"color: #4a4a4a; font-family: \'Nunito Sans\', \'Helvetica Neue\', HelveticaNeue, Helvetica, Arial, sans-serif; font-size: 16px; white-space: pre-line;\">Terreno à venda no Condomínio Portal Mantiqueira na Zona Norte.</span></p>\r\n<p> </p>\r\n<p><span style=\"color: #4a4a4a; font-family: \'Nunito Sans\', \'Helvetica Neue\', HelveticaNeue, Helvetica, Arial, sans-serif; font-size: 16px; white-space: pre-line;\">Quitado, com 252 m2.</span></p>\r\n<p><span style=\"color: #4a4a4a; font-family: \'Nunito Sans\', \'Helvetica Neue\', HelveticaNeue, Helvetica, Arial, sans-serif; font-size: 16px; white-space: pre-line;\">Segurança 24 horas.</span></p>\r\n<p><span style=\"color: #4a4a4a; font-family: \'Nunito Sans\', \'Helvetica Neue\', HelveticaNeue, Helvetica, Arial, sans-serif; font-size: 16px; white-space: pre-line;\">Excelente infraestrutura com quadras, lago, pista de caminhada, espaço pet.</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/T1177 1.jpg\",\"alt_text\":\"T1177 1.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/T1177 4.jpg\",\"alt_text\":\"T1177 4.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/T1177 6.jpg\",\"alt_text\":\"T1177 6.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/T1177 2.jpg\",\"alt_text\":\"T1177 2.jpg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/T1177 9.jpg\",\"alt_text\":\"T1177 9.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/T1177 5.jpg\",\"alt_text\":\"T1177 5.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/T1177 7.jpg\",\"alt_text\":\"T1177 7.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/T1177 3.jpg\",\"alt_text\":\"T1177 3.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/T1177 8.jpg\",\"alt_text\":\"T1177 8.jpg\"}}', 'sell', '', '260000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Portal Mantiqueira', '-23.136969,-45.911354', '12213646', '