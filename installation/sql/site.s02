/**ABDB**/INSERT INTO `#__sppagebuilder_versions`  VALUES 
('6', '18', 'Jul 17, 2026, 9:26:31 AM', '[{\"layout\":12,\"settings\":{\"title\":\"\",\"heading_selector\":\"h3\",\"title_fontsize\":\"\",\"title_fontweight\":\"\",\"title_text_color\":\"\",\"title_margin_top\":\"\",\"title_margin_bottom\":\"\",\"subtitle\":\"\",\"subtitle_fontsize\":\"\",\"title_position\":\"sppb-text-center\",\"background_color\":\"\",\"color\":\"\",\"background_image\":\"\",\"background_repeat\":\"no-repeat\",\"background_size\":\"cover\",\"background_attachment\":\"fixed\",\"background_position\":\"0 0\",\"background_video\":0,\"background_video_mp4\":\"\",\"background_video_ogv\":\"\",\"id\":\"\",\"class\":\"about-top-wrapper\",\"padding\":\"65px 0 110px 0\",\"margin\":\"0px\",\"fullscreen\":0,\"background_type\":\"none\",\"fit_columns\":{\"xl\":true,\"lg\":true,\"md\":true,\"sm\":true,\"xs\":true}},\"id\":1542275575,\"visibility\":1,\"columns\":[{\"class_name\":\"col-sm-12\",\"settings\":{\"background\":\"\",\"color\":\"\",\"padding\":\"\",\"animation\":\"\",\"animationduration\":300,\"animationdelay\":0,\"class\":\"\",\"width\":{\"xl\":\"100%\",\"lg\":\"100%\",\"md\":\"100%\",\"sm\":\"100%\",\"xs\":\"100%\"}},\"id\":1542275576,\"addons\":[{\"type\":\"content\",\"name\":\"image\",\"title\":\"Image\",\"id\":1542275577,\"settings\":{\"admin_label\":\"\",\"title\":\"\",\"heading_selector\":\"h3\",\"title_fontsize\":\"\",\"title_fontweight\":\"\",\"title_text_color\":\"\",\"title_margin_top\":\"\",\"title_margin_bottom\":\"\",\"image\":\"images\\/2020\\/01\\/06\\/metropolis_sjc_capa.jpg\",\"alt_text\":\"\",\"position\":\"sppb-text-center\",\"link\":\"\",\"target\":\"\",\"class\":\"\",\"open_lightbox\":0,\"title_typography\":{\"font\":\"\",\"size\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"line_height\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"letter_spacing\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"uppercase\":\"\",\"italic\":\"\",\"underline\":\"\",\"weight\":\"\",\"type\":\"google\"}},\"visibility\":false},{\"type\":\"content\",\"name\":\"empty_space\",\"title\":\"Empty Space\",\"id\":1542275578,\"settings\":{\"admin_label\":\"\",\"gap\":\"55\",\"hidden_md\":\"0\",\"hidden_sm\":\"0\",\"hidden_xs\":\"0\",\"class\":\"\",\"hidden_xl\":\"0\",\"hidden_lg\":\"0\"},\"visibility\":false},{\"type\":\"content\",\"name\":\"text_block\",\"title\":\"Text Block\",\"id\":1542275579,\"settings\":{\"admin_label\":\"Imobili\\u00e1ria Metr\\u00f3polis\",\"title\":\"Imobili\\u00e1ria Metr\\u00f3polis\",\"heading_selector\":\"h3\",\"title_fontsize\":\"\",\"title_fontweight\":\"\",\"title_text_color\":\"\",\"title_margin_top\":\"\",\"title_margin_bottom\":\"30\",\"text\":\"<div style=\\\"text-align: justify;\\\">A Imobili\\u00e1ria Metr\\u00f3polis est\\u00e1 estabelecida em S\\u00e3o Jos\\u00e9 dos Campos e atua no mercado imobili\\u00e1rio desde 1994. Contamos com uma equipe de advogados, administradores e corretores, que trabalham visando a satisfa\\u00e7\\u00e3o e a certeza dos melhores neg\\u00f3cios aos nossos clientes.<\\/div>\\n<div style=\\\"text-align: justify;\\\">Nossa empresa \\u00e9 reconhecida pela seriedade, honestidade e transpar\\u00eancia em cada neg\\u00f3cio realizado.<\\/div>\\n<div style=\\\"text-align: justify;\\\">Nosso escrit\\u00f3rio fica pr\\u00f3ximo a escolas como Poliedro, Unesp, Univap e Ita (Instituto de Tecnologia Aeron\\u00e1utica) de SJCampos. Atuamos principalmente em bairros como V. Adyana, Aquarius, Urbanova, Esplanada.<\\/div>\\n<div style=\\\"text-align: justify;\\\">Nosso endere\\u00e7o:<br \\/>Rua Paraibuna, 330 - Jardim S\\u00e3o Dimas<br \\/>CEP: 12.245-021 - S\\u00e3o Jos\\u00e9 dos Campos-SP<br \\/>Telefones: (12) 3922-4722 ou 3921-2121<br \\/>CRECI: 28.971-J<br \\/>E-mail: contato@imobmetropolis.com<\\/div>\",\"alignment\":\"sppb-text-left\",\"class\":\"\",\"dropcap\":0,\"text_typography\":{\"font\":\"\",\"size\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"line_height\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"letter_spacing\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"uppercase\":false,\"italic\":false,\"underline\":false,\"weight\":\"\",\"type\":\"google\"},\"title_typography\":{\"font\":\"\",\"size\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"line_height\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"letter_spacing\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"uppercase\":\"\",\"italic\":\"\",\"underline\":\"\",\"weight\":\"\",\"type\":\"google\"}},\"visibility\":1},{\"type\":\"content\",\"name\":\"empty_space\",\"title\":\"Empty Space\",\"id\":1542275580,\"settings\":{\"admin_label\":\"\",\"gap\":\"50\",\"hidden_md\":\"0\",\"hidden_sm\":\"0\",\"hidden_xs\":\"0\",\"class\":\"\",\"hidden_xl\":\"0\",\"hidden_lg\":\"0\"},\"visibility\":1},{\"type\":\"content\",\"name\":\"text_block\",\"title\":\"Text Block\",\"id\":1578323058900,\"settings\":{\"admin_label\":\"S\\u00e3o Jos\\u00e9 dos Campos - SP\",\"title\":\"S\\u00e3o Jos\\u00e9 dos Campos - SP\",\"heading_selector\":\"h3\",\"title_fontsize\":\"\",\"title_fontweight\":\"\",\"title_text_color\":\"\",\"title_margin_top\":\"\",\"title_margin_bottom\":\"30\",\"text\":\"<div style=\\\"text-align: justify;\\\">\\n<div style=\\\"text-align: justify;\\\">S\\u00e3o Jos\\u00e9 dos Campos uma cidade que une cultura, tradi\\u00e7\\u00e3o e tecnologia. No n\\u00facleo urbano est\\u00e3o localizados institutos federais de pesquisa cient\\u00edfica (DCTA, INPE), empresas de tecnologia de ponta (GM, J&amp;J, PANASONIC, EMBRAER), pr\\u00e9dios de arquitetura arrojada, universidades (ITA, UNESP, UNIVAP, UNIP, FATEC, POLIEDRO, OBJETIVO, ANGLO), faculdades e centros de forma\\u00e7\\u00e3o de m\\u00e3o de obra qualificada. Por outro lado,\\u00a0a zona rural concentra quase 70% do territ\\u00f3rio do munic\\u00edpio, boa parte em \\u00e1reas de prote\\u00e7\\u00e3o ambiental.<\\/div>\\n<div style=\\\"text-align: justify;\\\">\\u00c9 o principal munic\\u00edpio da Regi\\u00e3o Metropolitana do Vale do Para\\u00edba e o mais importante polo aeron\\u00e1utico e aeroespacial da Am\\u00e9rica Latina. A popula\\u00e7\\u00e3o tamb\\u00e9m preserva a cultura local, influenciada pela hist\\u00f3ria dos bandeirantes, que tra\\u00e7aram pela regi\\u00e3o os caminhos rumo ao ouro das Minas Gerais, e dos tropeiros que vinham do sul do estado vizinho. Hospitaleira, a cidade recebe bem os migrantes de todas as partes, muitos dos quais participam do crescimento local.<\\/div>\\n<div style=\\\"text-align: justify;\\\">Localizada estrategicamente entre S\\u00e3o Paulo e Rio de Janeiro e ligada por modernas rodovias e pelo aeroporto, a cidade est\\u00e1 bem pr\\u00f3xima das praias, da regi\\u00e3o serrana e de outros destinos tur\\u00edsticos do vale. Entre uma ou duas horas de carro, \\u00e9 poss\\u00edvel chegar a Ubatuba, Campos do Jord\\u00e3o ou Aparecida, onde fica a Bas\\u00edlica Nacional, maior santu\\u00e1rio mariano do mundo.<\\/div>\\n<div style=\\\"text-align: justify;\\\">\\u00c9 destaque no pa\\u00eds devido ao potencial de neg\\u00f3cios, fator que\\u00a0impulsiona investimentos na \\u00e1rea de hotelaria, com\\u00e9rcio e servi\\u00e7os. Isso se verifica no enorme fluxo de pessoas que diariamente procuram S\\u00e3o Jos\\u00e9 em visitas a shoppings, polos industriais e tecnol\\u00f3gicos e centros educacionais t\\u00e9cnicos ou de n\\u00edvel superior.<\\/div>\\n<div style=\\\"text-align: justify;\\\">Aqui o desenvolvimento tecnol\\u00f3gico e industrial est\\u00e1 em harmonia com a natureza, com parques em todos os cantos, pra\\u00e7as nos bairros e ruas arborizadas. O destaque \\u00e9 S\\u00e3o Francisco Xavier, que tem uma paisagem verde preservada e vista panor\\u00e2mica das cidades vizinhas, em meio a um relevo de montanhas e vales na Serra da Mantiqueira.<\\/div>\\n<\\/div>\",\"alignment\":\"sppb-text-left\",\"class\":\"\",\"dropcap\":0,\"text_typography\":{\"font\":\"\",\"size\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"line_height\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"letter_spacing\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"uppercase\":false,\"italic\":false,\"underline\":false,\"weight\":\"\",\"type\":\"google\"},\"title_typography\":{\"font\":\"\",\"size\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"line_height\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"letter_spacing\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"uppercase\":\"\",\"italic\":\"\",\"underline\":\"\",\"weight\":\"\",\"type\":\"google\"}},\"visibility\":1},{\"type\":\"content\",\"name\":\"empty_space\",\"title\":\"Empty Space\",\"id\":1578323058905,\"settings\":{\"admin_label\":\"\",\"gap\":\"50\",\"hidden_md\":\"0\",\"hidden_sm\":\"0\",\"hidden_xs\":\"0\",\"class\":\"\",\"hidden_xl\":\"0\",\"hidden_lg\":\"0\"},\"visibility\":1},{\"type\":\"nested_row\",\"name\":\"row\",\"id\":1542275581}],\"visibility\":1,\"width\":{\"xl\":\"100%\",\"lg\":\"100%\",\"md\":\"100%\",\"sm\":\"100%\",\"xs\":\"100%\"}}],\"collapse\":\"\",\"title\":\"Row\"},{\"layout\":\"12\",\"disable\":false,\"settings\":{\"default\":{\"admin_label\":\"\",\"title\":\"\",\"heading_selector\":\"h3\",\"title_fontsize\":\"\",\"title_fontweight\":\"\",\"title_position\":\"sppb-text-center\",\"columns_align_center\":0,\"fullscreen\":0,\"no_gutter\":0,\"padding\":\"50px 0px 50px 0px\",\"margin\":\"0px 0px 0px 0px\",\"background_type\":\"none\",\"background_gradient\":{\"color\":\"#00c6fb\",\"color2\":\"#005bea\",\"deg\":\"45\",\"type\":\"linear\"},\"background_image\":\"\",\"background_parallax\":\"0\",\"background_repeat\":\"no-repeat\",\"background_size\":\"cover\",\"background_attachment\":\"fixed\",\"background_position\":\"0 0\",\"external_background_video\":\"0\",\"video_loop\":1,\"overlay_type\":\"overlay_none\",\"gradient_overlay\":{\"color\":\"rgba(127, 0, 255, 0.8)\",\"color2\":\"rgba(225, 0, 255, 0.7)\",\"deg\":\"45\",\"type\":\"linear\"},\"pattern_overlay\":\"\",\"overlay_pattern_color\":\"\",\"blend_mode\":\"normal\",\"show_top_shape\":\"\",\"shape_name\":\"clouds-flat\",\"shape_color\":\"#e5e5e5\",\"shape_width\":{\"md\":100,\"sm\":100,\"xs\":100},\"shape_height\":\"\",\"shape_flip\":false,\"shape_invert\":false,\"shape_to_front\":false,\"show_bottom_shape\":\"\",\"bottom_shape_name\":\"clouds-opacity\",\"bottom_shape_color\":\"#e5e5e5\",\"bottom_shape_width\":{\"md\":100,\"sm\":100,\"xs\":100},\"bottom_shape_height\":\"\",\"bottom_shape_flip\":false,\"bottom_shape_invert\":false,\"bottom_shape_to_front\":false,\"hidden_xs\":\"\",\"hidden_sm\":\"\",\"hidden_md\":\"\",\"animationduration\":\"300\",\"animationdelay\":\"0\"},\"columns_align_center\":0,\"fullscreen\":0,\"no_gutter\":0,\"padding\":{\"xl\":\"5% 5% 5% 5%\",\"lg\":\"   \",\"md\":\"   \",\"sm\":\"   \",\"xs\":\"   \"},\"margin\":{\"xl\":\"   \",\"lg\":\"   \",\"md\":\"   \",\"sm\":\"   \",\"xs\":\"   \"},\"show_top_shape\":0,\"show_bottom_shape\":0,\"background_color\":\"#dcdcdc\",\"background_type\":\"color\",\"fit_columns\":{\"xl\":true,\"lg\":true,\"md\":true,\"sm\":true,\"xs\":true}},\"id\":1542275581,\"visibility\":1,\"columns\":[{\"class_name\":\"col-md-12\",\"settings\":{\"width\":{\"xl\":\"100%\",\"lg\":\"100%\",\"md\":\"100%\",\"sm\":\"100%\",\"xs\":\"100%\"}},\"id\":1542275582,\"addons\":[{\"type\":\"content\",\"name\":\"text_block\",\"title\":\"Text Block\",\"id\":1542275583,\"settings\":{\"admin_label\":\"Administra\\u00e7\\u00e3o de Im\\u00f3veis\",\"title\":\"Administra\\u00e7\\u00e3o de Im\\u00f3veis\",\"heading_selector\":\"h4\",\"title_fontsize\":\"\",\"title_fontweight\":\"\",\"title_text_color\":\"\",\"title_margin_top\":\"\",\"title_margin_bottom\":\"30\",\"text\":\"<div style=\\\"text-align: justify;\\\">\\n<div>A Metr\\u00f3polis administra o seu im\\u00f3vel com efici\\u00eancia e seriedade j\\u00e1 comprovada pelos nossos clientes propriet\\u00e1rios. Estamos bem pr\\u00f3ximo a institui\\u00e7\\u00f5es de ensino como POLIEDRO, UNESP, ITA e UNIVAP, e tamb\\u00e9m no cora\\u00e7\\u00e3o da cidade, ao lado de bairros como Vila Adyana, Vila Ema e Jd. S\\u00e3o Dimas, o que facilita o contato tanto de clientes locat\\u00e1rios como de propriet\\u00e1rios.<\\/div>\\n<div>Sempre abertos para novos clientes, convidamos voc\\u00ea para uma visita em nosso escrit\\u00f3rio.<\\/div>\\n<\\/div>\",\"alignment\":\"sppb-text-left\",\"class\":\"empire-fun-fact\",\"dropcap\":0,\"text_typography\":{\"font\":\"\",\"size\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"line_height\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"letter_spacing\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"uppercase\":false,\"italic\":false,\"underline\":false,\"weight\":\"\",\"type\":\"google\"},\"title_typography\":{\"font\":\"\",\"size\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"line_height\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"letter_spacing\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"uppercase\":\"\",\"italic\":\"\",\"underline\":\"\",\"weight\":\"\",\"type\":\"google\"}},\"visibility\":1},{\"type\":\"content\",\"name\":\"empty_space\",\"title\":\"Empty Space\",\"id\":1542275584,\"settings\":{\"admin_label\":\"\",\"gap\":\"70\",\"hidden_md\":\"0\",\"hidden_sm\":\"0\",\"hidden_xs\":\"0\",\"class\":\"\",\"hidden_xl\":\"0\",\"hidden_lg\":\"0\"},\"visibility\":1},{\"type\":\"content\",\"name\":\"text_block\",\"title\":\"Text Block\",\"id\":1542275585,\"settings\":{\"admin_label\":\"Documentos para Loca\\u00e7\\u00e3o\\/Pessoa F\\u00edsica\",\"title\":\"Documentos para Loca\\u00e7\\u00e3o\\/Pessoa F\\u00edsica\",\"heading_selector\":\"h4\",\"title_fontsize\":\"\",\"title_fontweight\":\"\",\"title_text_color\":\"\",\"title_margin_top\":\"\",\"title_margin_bottom\":\"30\",\"text\":\"1. Tr\\u00eas \\u00faltimos comprovantes de renda (contracheque\\/horelite). O valor da loca\\u00e7\\u00e3o n\\u00e3o deve comprometer mais que 30% do rendimento;<br \\/>2. Certid\\u00e3o negativa de SPC, adquirido junto ao Sindicato do Com\\u00e9rcio Varejista. Se for pela imobili\\u00e1ria, o valor \\u00e9 R$10,00;<br \\/>3. CPF e RG (xerox);<br \\/>4. Comprovante de resid\\u00eancia (conta de luz, telefone, etc);<br \\/>5. Imposto de renda do \\u00faltimo exerc\\u00edcio na \\u00edntegra, com recibo de envio;<br \\/>6. Carteira de trabalho<br \\/>7. Preencher formul\\u00e1rio de proposta de loca\\u00e7ao do im\\u00f3vel<br \\/>8. Apresentar um Fiador com os mesmo documentos do locat\\u00e1rio (1 \\u00e0 7). Al\\u00e9m disso, apresentar a certid\\u00e3o atualizada da matr\\u00edcula do im\\u00f3vel dado em garantia e certid\\u00e3o de casamento(se casado). <br \\/><br \\/>Obs.: As demais modalidades de garantia estar\\u00e3o sujeitas a concord\\u00e2ncia do locador e an\\u00e1lise da imobili\\u00e1ria.\",\"alignment\":\"sppb-text-left\",\"class\":\"empire-fun-fact\",\"dropcap\":0,\"text_typography\":{\"font\":\"\",\"size\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"line_height\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"letter_spacing\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"uppercase\":false,\"italic\":false,\"underline\":false,\"weight\":\"\",\"type\":\"google\"},\"title_typography\":{\"font\":\"\",\"size\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"line_height\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"letter_spacing\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"uppercase\":\"\",\"italic\":\"\",\"underline\":\"\",\"weight\":\"\",\"type\":\"google\"}},\"visibility\":1},{\"type\":\"content\",\"name\":\"empty_space\",\"title\":\"Empty Space\",\"id\":1542275586,\"settings\":{\"admin_label\":\"\",\"gap\":\"70\",\"hidden_md\":\"0\",\"hidden_sm\":\"0\",\"hidden_xs\":\"0\",\"class\":\"\",\"hidden_xl\":\"0\",\"hidden_lg\":\"0\"},\"visibility\":1},{\"type\":\"content\",\"name\":\"text_block\",\"title\":\"Text Block\",\"id\":1542275587,\"settings\":{\"admin_label\":\"Documentos para Loca\\u00e7\\u00e3o\\/Pessoa Jur\\u00eddica\",\"title\":\"Documentos para Loca\\u00e7\\u00e3o\\/Pessoa Jur\\u00eddica\",\"heading_selector\":\"h4\",\"title_fontsize\":\"\",\"title_fontweight\":\"\",\"title_text_color\":\"\",\"title_margin_top\":\"\",\"title_margin_bottom\":\"30\",\"text\":\"<ol>\\n<li style=\\\"text-align: justify;\\\">CNPJ;<\\/li>\\n<li style=\\\"text-align: justify;\\\">SPC R$ 30,00 se adquiro pela Imobili\\u00e1ria<\\/li>\\n<li style=\\\"text-align: justify;\\\">Contrato Social e \\u00faltima altera\\u00e7\\u00e3<\\/li>\\n<li style=\\\"text-align: justify;\\\">I.R. do \\u00faltimo exerc\\u00edcio da empresa;<\\/li>\\n<li style=\\\"text-align: justify;\\\">RG; CPF e I.R.(\\u00faltimo exerc\\u00edcio) dos respons\\u00e1veis pela empresa.<\\/li>\\n<\\/ol>\\n\\u00a0 \\u00a0 Fiador:<br \\/>a. Tr\\u00eas \\u00faltimos comprovantes de renda (contracheque\\/horelite). O valor da loca\\u00e7\\u00e3o n\\u00e3o deve comprometer mais que 30% do rendimento;<br \\/>b. Certid\\u00e3o negativa de SPC, adquirido junto ao Sindicato do Com\\u00e9rcio Varejista. e for pela imobili\\u00e1ria, o valor \\u00e9 R$10,00;<br \\/>c. CPF e RG (xerox);<br \\/>d. Comprovante de resid\\u00eancia (conta de luz, telefone, etc);<br \\/>e. Imposto de renda do \\u00faltimo exerc\\u00edcio na \\u00edntegra, com recibo de envio;<br \\/>f. Carteira de trabalho<br \\/>g. Apresentar a certid\\u00e3o atualizada da matr\\u00edcula do im\\u00f3vel dado em garantia e certid\\u00e3o de casamento(se casado).\\u00a0<br \\/><br \\/>Obs.: As demais modalidades de garantia estar\\u00e3o sujeitas a concord\\u00e2ncia do locador e an\\u00e1lise da imobili\\u00e1ria.\",\"alignment\":\"sppb-text-left\",\"class\":\"empire-fun-fact\",\"dropcap\":0,\"text_typography\":{\"font\":\"\",\"size\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"line_height\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"letter_spacing\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"uppercase\":false,\"italic\":false,\"underline\":false,\"weight\":\"\",\"type\":\"google\"},\"title_typography\":{\"font\":\"\",\"size\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"line_height\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"letter_spacing\":{\"xl\":{\"value\":\"\",\"unit\":\"px\"},\"lg\":{\"value\":\"\",\"unit\":\"px\"},\"md\":{\"value\":\"\",\"unit\":\"px\"},\"sm\":{\"value\":\"\",\"unit\":\"px\"},\"xs\":{\"value\":\"\",\"unit\":\"px\"}},\"uppercase\":\"\",\"italic\":\"\",\"underline\":\"\",\"weight\":\"\",\"type\":\"google\"}},\"visibility\":1}],\"visibility\":1,\"width\":{\"xl\":\"100%\",\"lg\":\"100%\",\"md\":\"100%\",\"sm\":\"100%\",\"xs\":\"100%\"}}],\"parent\":{\"rowId\":1542275575,\"columnId\":1542275576}}]', '', '{\"meta_description\":\"\",\"meta_keywords\":\"\",\"robots\":\"\",\"seo_spacer\":\"\",\"author\":\"\",\"og_type\":\"\",\"schema\":{\"schemaType\":\"None\"}}', '', '', '', NULL, '1', '2026-07-17 12:26:31', '502'),
