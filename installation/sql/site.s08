('2417', 'A8422', 'V. Adyana- Apto 72 m2 com 2 quartos(suite)+armários, coz.plan, sacada gourmet, 2 vgs gar paralelas', 'xa8422', '1', '1', '', '<p>O apto na Vila Adyana tem:<br />- 72m² Área útil<br />- 2 Dormitórios sendo uma suíte + armários<br />- Sala dois ambientes com varanda gourmet<br />- Cozinha planejada<br />- Banheiro social com box/gabinete<br />- Área de serviço com armário<br />- 2 Vagas de garagem paralelas sem vizinho<br />- Água e gás individualizados<br />- Piso porcelanato<br />- Andar alto<br /><br />Condomínio com:<br />- Churrasqueira<br />- Academia<br />- Playground<br />- Gazebo<br />- Sala de jogos<br />- Sala de reuniões<br />- Horta<br />- Salão de festas<br />- Portaria digital<br />- Vagas de visitantes<br />- Torre única<br />- 2 Elevadores<br />- 8 Vagas para visitantes, sendo seis de carros e duas motos<br />- Área para carga e descarga<br />- Excelente localização, a 100 metros do Parque Santos Dumont e a 300 metros do Pq Vicentina</p>\r\n<p>- condominio R$ 570,00 (sujeito a alteração sem aviso prévio)</p>\r\n<p>- iptu R$ 176,00/mês</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A8422 0.jpg\",\"alt_text\":\"A8422 0.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/A8422 5.jpeg\",\"alt_text\":\"A8422 5.jpeg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/A8422 4.jpeg\",\"alt_text\":\"A8422 4.jpeg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/A8422 2.jpeg\",\"alt_text\":\"A8422 2.jpeg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/A8422 3.jpeg\",\"alt_text\":\"A8422 3.jpeg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/A8422 1.jpeg\",\"alt_text\":\"A8422 1.jpeg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/A8422 6.jpeg\",\"alt_text\":\"A8422 6.jpeg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/A8422 7.jpeg\",\"alt_text\":\"A8422 7.jpeg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/A8422 11.jpeg\",\"alt_text\":\"A8422 11.jpeg\"},\"gallery14\":{\"photo\":\"images\\/gallery\\/A8422 13.jpeg\",\"alt_text\":\"A8422 13.jpeg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/A8422 12.jpeg\",\"alt_text\":\"A8422 12.jpeg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/A8422 10.jpeg\",\"alt_text\":\"A8422 10.jpeg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/A8422 9.jpeg\",\"alt_text\":\"A8422 9.jpeg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/A8422 8.jpeg\",\"alt_text\":\"A8422 8.jpeg\"},\"gallery15\":{\"photo\":\"images\\/gallery\\/A8422 14.jpeg\",\"alt_text\":\"A8422 14.jpeg\"},\"gallery19\":{\"photo\":\"images\\/gallery\\/A8422 18.jpeg\",\"alt_text\":\"A8422 18.jpeg\"},\"gallery21\":{\"photo\":\"images\\/gallery\\/A8422 20.jpeg\",\"alt_text\":\"A8422 20.jpeg\"},\"gallery20\":{\"photo\":\"images\\/gallery\\/A8422 19.jpeg\",\"alt_text\":\"A8422 19.jpeg\"},\"gallery18\":{\"photo\":\"images\\/gallery\\/A8422 17.jpeg\",\"alt_text\":\"A8422 17.jpeg\"},\"gallery17\":{\"photo\":\"images\\/gallery\\/A8422 16.jpeg\",\"alt_text\":\"A8422 16.jpeg\"},\"gallery16\":{\"photo\":\"images\\/gallery\\/A8422 15.jpeg\",\"alt_text\":\"A8422 15.jpeg\"}}', 'rent', '', '4200.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'sjcampos', '', '0,0', '12245-320', '72', '2', '2', '2', '', '0', '[\"1\",\"8\",\"12\",\"16\",\"18\",\"21\",\"22\",\"27\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2026-06-01 00:00:00', '783', '2026-06-02 10:51:19', '0', NULL),
('2418', 'A8423', 'Centro- Apto 40 m2 com 1 quarto, coz.planejada, sacada, 1 vg gar, s.festas, piscina', 'xa8423', '1', '1', '', '<p>O apto no Centro tem:<br />- área de 40 metros quadrados<br />- 1 quarto<br />- cozinha planejada<br />- sala com sacada e sol da manhã<br />- banheiro com box/gabinete<br />- 1 vaga de garagem<br />- área de fitness<br />- playground<br />- salão para festas e eventos<br />- piscina<br />- churrasqueira<br />- portaria 24h</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A8423 0.jpg\",\"alt_text\":\"A8423 0.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/A8423 3.jpeg\",\"alt_text\":\"A8423 3.jpeg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/A8423 4.jpeg\",\"alt_text\":\"A8423 4.jpeg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/A8423 2.jpeg\",\"alt_text\":\"A8423 2.jpeg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/A8423 1.jpeg\",\"alt_text\":\"A8423 1.jpeg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/A8423 5.jpeg\",\"alt_text\":\"A8423 5.jpeg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/A8423 5B.jpg\",\"alt_text\":\"A8423 5B.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/A8423 5A.jpg\",\"alt_text\":\"A8423 5A.jpg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/A8423 7.png\",\"alt_text\":\"A8423 7.png\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/A8423 6.jpeg\",\"alt_text\":\"A8423 6.jpeg\"}}', 'sell', '', '340000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'SJCAMPOS', 'CENTRO', '0,0', '12210-030', '40', '1', '1', '1', '', '0', '[\"8\",\"9\",\"12\",\"16\",\"18\",\"21\",\"22\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2026-06-02 00:00:00', '783', '2026-06-02 12:09:44', '0', NULL),
('2419', 'A8424', 'Pq Industrial- Apto 48 m2 com 2 quartos(suite), coz.planejada, box/gab nos banheiros, 1 gar, lazer', 'xa8424', '1', '1', '', '<p>O apto no Pq Industrial/Palmeiras de São José. Campo de Bragança tem:<br />- área de 48 metros quadrados<br />- 2 quartos sendo 1 suite<br />- banheiros com box/gabinete<br />- piso laminado nas áreas quentes e porcelanato nas áreas frias <br />- sala com Sanca em Gesso e iluminação em led <br />- porta de vidro para dividir cozinha e área de serviço <br />- vaga coberta em frente à entrada bloco e próximo à entrada de pedestres do condomínio<br />- área de Serviço (Planejados e Máquina Lava e Seca 12 Kg)<br />- cozinha (Fogão cooktop 4 bocas, forno elétrico, exaustor, microondas e geladeira)<br />- sala de Jantar (Mesa e canto Alemão com baú)<br />- sala de TV (sofá 2 lugares, Painel para TV com gavetas e cortina)<br />- quarto (Guarda roupa planejado com 2 portas, uma delas toda em espelho, cama e colchão tamanho solteiro box baú. Quarto com nuvens luminosas em MDF em duas paredes)<br />- quarto Suite (Guarda roupa planejado com 2 portas inteiras em espelho, armários planejados suspensos com iluminação e laterais para apoio. Cama e colchão tamanho Queen Box baú. Mesa e armário para Home Office, painel para TV com gavetas)<br /><br />O condominio tem:<br />- sala de jogos com mesa de bilhar / Ping pongue/ Pebolim e pôquer <br />- Sala de leitura<br />- Brinquedoteca <br />- 2 salões para 60 pessoas com mesas, cadeiras e refrigeradores <br />- 2 churrasqueiras <br />- Lavandeira <br />- Mercado 24h<br />- Portaria 24h <br />- Administração para recebimento de encomendas <br />- 2 quadras de futsal <br />- 2 meias quadras de basquete<br />- Parquinho infantil <br />- Academia ao ar livre</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A8424 0.jpg\",\"alt_text\":\"A8424 0.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/A8424 0A.jpg\",\"alt_text\":\"A8424 0A.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/A8424 4.jpeg\",\"alt_text\":\"A8424 4.jpeg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/A8424 5.jpeg\",\"alt_text\":\"A8424 5.jpeg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/A8424 1.jpeg\",\"alt_text\":\"A8424 1.jpeg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/A8424 3.jpeg\",\"alt_text\":\"A8424 3.jpeg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/A8424 2.jpeg\",\"alt_text\":\"A8424 2.jpeg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/A8424 6.jpeg\",\"alt_text\":\"A8424 6.jpeg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/A8424 9.jpeg\",\"alt_text\":\"A8424 9.jpeg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/A8424 8.jpeg\",\"alt_text\":\"A8424 8.jpeg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/A8424 10.jpeg\",\"alt_text\":\"A8424 10.jpeg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/A8424 7.jpeg\",\"alt_text\":\"A8424 7.jpeg\"},\"gallery15\":{\"photo\":\"images\\/gallery\\/A8424 13.jpeg\",\"alt_text\":\"A8424 13.jpeg\"},\"gallery14\":{\"photo\":\"images\\/gallery\\/A8424 12.jpeg\",\"alt_text\":\"A8424 12.jpeg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/A8424 11.jpeg\",\"alt_text\":\"A8424 11.jpeg\"},\"gallery16\":{\"photo\":\"images\\/gallery\\/A8424 14.jpeg\",\"alt_text\":\"A8424 14.jpeg\"}}', 'sell', '', '448000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'sjcampos', '', '0,0', '12237-828', '48', '2', '2', '1', '', '0', '[\"8\",\"9\",\"12\",\"16\",\"21\",\"22\",\"23\",\"24\",\"27\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2026-06-02 00:00:00', '783', '2026-06-02 16:01:06', '0', NULL);
/**ABDB**/CREATE TABLE `#__spproperty_propertyfeatures` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `title` varchar(255) NOT NULL,
  `alias` varchar(255) NOT NULL DEFAULT '',
  `image` text,
  `icon_sp` varchar(100) DEFAULT NULL,
  `icon_fa` varchar(100) DEFAULT NULL,
  `icon` varchar(100) DEFAULT NULL,
  `icon_type` tinyint(1) NOT NULL DEFAULT '0',
  `polls` text NOT NULL,
  `published` tinyint NOT NULL DEFAULT '1',
  `language` char(7) NOT NULL DEFAULT '*',
  `access` int NOT NULL DEFAULT '1',
  `ordering` int NOT NULL DEFAULT '0',
  `created_by` bigint NOT NULL DEFAULT '0',
  `created` datetime DEFAULT NULL,
  `modified_by` bigint NOT NULL DEFAULT '0',
  `modified` datetime DEFAULT NULL,
  `checked_out` bigint NOT NULL DEFAULT '0',
  `checked_out_time` datetime DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=39 DEFAULT CHARSET=utf8mb3;/*ABDE:#__spproperty_propertyfeatures*/
