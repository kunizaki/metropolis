('2395', 'A8401', 'Pq Industrial- Apto 80 m2 com 3 quartos(suite)+arms, varanda, coz,plan, 1 vg gar', 'xa8401', '1', '1', '', '<p>O apto no Parque Industrial tem:<br />- área de 80 metros quadrados<br />- 3 quartos sendo uma suite, todos com armários<br />- cozinha com armários/gabinete<br />- sala com varanda envidraçada, vista livre e sol da manhã<br />- banheiros com box<br />- 2 vagas de garagem<br />- playground<br />- piscina<br />- churrasqueira<br />- salão de festas<br />- elevador</p>\r\n<p>- condominio R$ 350,00</p>\r\n<p>- iptu R$ 150,00</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A8401 1.jpeg\",\"alt_text\":\"A8401 1.jpeg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/A8401 2.jpeg\",\"alt_text\":\"A8401 2.jpeg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/A8401 3.jpeg\",\"alt_text\":\"A8401 3.jpeg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/A8401 4.jpeg\",\"alt_text\":\"A8401 4.jpeg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/A8401 5.jpeg\",\"alt_text\":\"A8401 5.jpeg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/A8401 6.jpeg\",\"alt_text\":\"A8401 6.jpeg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/A8401 7.jpeg\",\"alt_text\":\"A8401 7.jpeg\"}}', 'sell', '', '720000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'sjcampos', 'pq industrial', '0,0', '12235620', '80', '3', '2', '2', '', '0', '[\"8\",\"9\",\"12\",\"16\",\"17\",\"18\",\"21\",\"22\",\"27\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2026-04-30 00:00:00', '783', '2026-05-05 13:16:13', '0', NULL),
('2396', 'C3820', 'Urbanova/Jaguary- Sobrado de 303m2, 3 suites+armários+closet, escritório, coz.plan, churrasqueira, piscina, 2 vgs garagem ', 'xc3820', '7', '1', '', '<p>Sobrado no Urbanova, Condomínio Jaguary. Características do Imóvel:<br />-3 súites no pavimento inferior sendo: Duas suítes americanas; 1 suíte completa;<br />- 1 suíte máster de tamanho excepcional, com hidro, 2 duchas, 2 cubas, amplo solarium com vista<br />- Escritório espaçoso, ideal para home office;<br />- Sala íntima de TV;<br />- Sala de estar integrada à sala de jantar;<br />- Lavabo social;<br />- Cozinha planejada;<br />- Área de serviço;<br />- Área gourmet com churrasquera;<br />- Piscina;<br />- Garagem coberta para 2 carros;<br /><br />Condomínio:<br />- Playground para crianças,<br /> - 2 quadras de tênis,<br /> - 1 quadra de poliesportiva,<br /> - 1 campo de futebol,<br /> - 3 quadras de areia,<br /> - pista de skate,<br /> - espaço pet,<br /> - diversos quiosques,<br /> - academia ao ar livre; há também uma academia completa há poucos metros do condomínio;<br /> - Segurança total 24h.<br /><br /></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/C3820 1.jpg\",\"alt_text\":\"C3820 1.jpg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/C3820 10.jpg\",\"alt_text\":\"C3820 10.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/C3820 2.jpg\",\"alt_text\":\"C3820 2.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/C3820 8.jpg\",\"alt_text\":\"C3820 8.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/C3820 7.jpg\",\"alt_text\":\"C3820 7.jpg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/C3820 9.jpg\",\"alt_text\":\"C3820 9.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/C3820 4.jpg\",\"alt_text\":\"C3820 4.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/C3820 6.jpg\",\"alt_text\":\"C3820 6.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/C3820 3.jpg\",\"alt_text\":\"C3820 3.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/C3820 5.jpg\",\"alt_text\":