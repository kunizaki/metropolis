('2416', 'M0058', 'Jd. Maringá- Sobrado comercial de 220 m2 com 5 quartos (suite), sala, copa, lavabo, 2 vgs gar', 'xm0058', '3', '1', '', '<p>O sobrado comercial no Jd. Maringá/Vila Betânia possui:<br />- área útil de 220 m2<br />- 5 quartos sendo 1 suite<br />- sala com lavado<br />- amplo depósito nos fundos<br />- habite-se comercial</p>\r\n<p>- 2 vagas de garagem<br />- ideal para escritórios, representações.</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/M0058 1.jpg\",\"alt_text\":\"M0058 1.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/M0058 3.jpg\",\"alt_text\":\"M0058 3.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/M0058 2.jpg\",\"alt_text\":\"M0058 2.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/M0058 5.jpg\",\"alt_text\":\"M0058 5.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/M0058 4.jpg\",\"alt_text\":\"M0058 4.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/M0058 6.jpg\",\"alt_text\":\"M0058 6.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/M0058 7.jpg\",\"alt_text\":\"M0058 7.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/M0058 8.jpg\",\"alt_text\":\"M0058 8.jpg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/M0058 9.jpg\",\"alt_text\":\"M0058 9.jpg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/M0058 10.jpg\",\"alt_text\":\"M0058 10.jpg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/M0058 12.jpg\",\"alt_text\":\"M0058 12.jpg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/M0058 11.jpg\",\"alt_text\":\"M0058 11.jpg\"},\"gallery14\":{\"photo\":\"images\\/gallery\\/M0058 14.jpg\",\"alt_text\":\"M0058 14.jpg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/M0058 13.jpg\",\"alt_text\":\"M0058 13.jpg\"},\"gallery17\":{\"photo\":\"images\\/gallery\\/M0058 17.jpg\",\"alt_text\":\"M0058 17.jpg\"},\"gallery15\":{\"photo\":\"images\\/gallery\\/M0058 15.jpg\",\"alt_text\":\"M0058 15.jpg\"},\"gallery16\":{\"photo\":\"images\\/gallery\\/M0058 16.jpg\",\"alt_text\":\"M0058 16.jpg\"},\"gallery18\":{\"phot