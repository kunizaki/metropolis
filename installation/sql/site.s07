('2371', 'A8389', 'Jd. Satélite- Apto 68 m2 com 3 quartos(suite)+armário, coz.plan, 1 vg garagem', 'xa8389', '1', '1', '', '<p>O apto no Cond. Campo Belo no Jd. Satélite tem:<br />- área de 68m 2<br />- 3 dorm sendo 1 suite com armário<br />-banheiros com box blindex<br />- sala ampla<br />- cozinha com gabinete e armário<br />-1 vaga fixa de garagem<br />- face norte com sol da manhã e vista livre nos quartos, cozinha e área de serviço<br />- primeiro andar<br />- prédio sem elevador. <br />- excelente localização, perto do Shopping Vale Sul, bancos, comércio e transporte público.</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A8389 1.jpg\",\"alt_text\":\"A8389 1.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/A8389 4.png\",\"alt_text\":\"A8389 4.png\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/A8389 5.png\",\"alt_text\":\"A8389 5.png\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/A8389 3.png\",\"alt_text\":\"A8389 3.png\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/A8389 2.png\",\"alt_text\":\"A8389 2.png\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/A8389 1.png\",\"alt_text\":\"A8389 1.png\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/A8389 7.png\",\"alt_text\":\"A8389 7.png\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/A8389 6.png\",\"alt_text\":\"A8389 6.png\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/A8389 8.png\",\"alt_text\":\"A8389 8.png\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/A8389 9.png\",\"alt_text\":\"A8389 9.png\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/A8389 10.png\",\"alt_text\":\"A8389 10.png\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/A8389 11.png\",\"alt_text\":\"A8389 11.png\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/A8389 12.png\",\"alt_text\":\"A8389 12.png\"},\"gallery14\":{\"photo\":\"images\\/gallery\\/A8389 13.png\",\"alt_text\":\"A8389 13.png\"}}', 'rent-sell', '', '360000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'SJCAMPOS', 'SATELITE', '0,0', '12230-075', '68', '3