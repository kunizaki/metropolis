('2332', 'A8362', 'Jd. São Dimas- Apto 40 m2 com 1 quarto, sem garagem', 'xa8362', '1', '1', '', '<p>O apto no Jardim São Dimas tem:<br />- 40 metros quadrados<br />- 1 quarto<br />- 1 banheiro<br />- sala/cozinha<br />- sem garagem<br />- área de recreação infantil<br />- salão de festas<br />- piscina<br />- quadra poliesportiva<br />- churrasqueira<br />- próximo ao Poliedro, Univap e Unesp<br />- condomínio e iptu já inclusos no valor do aluguel<br /><br />Obs.: esse  apto é ideal para estudantes, solteiros. Essse espaço era a antiga casa do zelador do condomínio</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/A8362 1.jpeg\",\"alt_text\":\"A8362 1.jpeg\"},\"gallery2\":{\"photo\":\"images/gallery/A8362 9.jpeg\",\"alt_text\":\"A8362 9.jpeg\"},\"gallery10\":{\"photo\":\"images/gallery/A8362 8.jpeg\",\"alt_text\":\"A8362 8.jpeg\"},\"gallery9\":{\"photo\":\"images/gallery/A8362 7.jpeg\",\"alt_text\":\"A8362 7.jpeg\"},\"gallery8\":{\"photo\":\"images/gallery/A8362 6.jpeg\",\"alt_text\":\"A8362 6.jpeg\"},\"gallery5\":{\"photo\":\"images/gallery/A8362 3.jpeg\",\"alt_text\":\"A8362 3.jpeg\"},\"gallery7\":{\"photo\":\"images/gallery/A8362 5.jpeg\",\"alt_text\":\"A8362 5.jpeg\"},\"gallery6\":{\"photo\":\"images/gallery/A8362 4.jpeg\",\"alt_text\":\"A8362 4.jpeg\"},\"gallery4\":{\"photo\":\"images/gallery/A8362 2.jpeg\",\"alt_text\":\"A8362 2.jpeg\"},\"gallery3\":{\"photo\":\"images/gallery/A8362 10.jpeg\",\"alt_text\":\"A8362 10.jpeg\"},\"gallery12\":{\"photo\":\"images/gallery/A3304a.jpeg\",\"alt_text\":\"A3304a.jpeg\"},\"gallery11\":{\"photo\":\"images/gallery/A3304.JPG\",\"alt_text\":\"A3304.JPG\"}}', 'rent', '', '1600.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Jardim São Dimas', '00,0', '12245-370', '40', '1', '1', '0', '', '0', '[\"8\",\"9\",\"12\",\"16\",\"21\",\"22\",\"23\",\"24\"]', '', '', '', '{}', '0', '*', '1', '0', '783', '2026-01-24 00:00:00', '783', '2026-02-09 17:00:35', '0', NULL),
