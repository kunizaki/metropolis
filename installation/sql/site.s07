('2350', 'C3808', 'Urbanova/Cond. Monte Carlo- Sobrado para venda com 297 m2 com 4 quartos(4 Sts), lavabo, 3 vgs gar', 'xc3808', '7', '1', '', '<p>O sobrado novo no Cond. Residencial Monte Carlo, Urbanova tem:<br />- 297 metros quadrados de área construída<br />- lote de 451m2<br />- 4 quartos sendo 4 suites<br />- banheiros<br />- 3 vagas de garagem<br />-  academia<br />- espaço gourmet<br />- playground<br />- salão de festas<br />- piscina adulto/infantil<br />- quadra poliesportiva<br />- churrasqueira<br />- sauna<br />- salão de jogos</p>\r\n<p>- condominio de R$ 800,00</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/C3808 1.jpeg\",\"alt_text\":\"C3808 1.jpeg\"},\"gallery2\":{\"photo\":\"images/gallery/C3808 2.jpeg\",\"alt_text\":\"C3808 2.jpeg\"},\"gallery4\":{\"photo\":\"images/gallery/C3808 4.jpeg\",\"alt_text\":\"C3808 4.jpeg\"},\"gallery3\":{\"photo\":\"images/gallery/C3808 3.jpeg\",\"alt_text\":\"C3808 3.jpeg\"},\"gallery5\":{\"photo\":\"images/gallery/C3808 5.jpeg\",\"alt_text\":\"C3808 5.jpeg\"}}', 'sell', '', '2800000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'SJCampos', '', '0,0', '12244-115', '297', '4', '5', '3', '', '0', '[\"8\",\"9\",\"12\",\"16\",\"21\",\"23\",\"26\",\"27\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2026-03-02 00:00:00', '783', '2026-03-04 12:23:30', '0', NULL),
('2351', 'A8371', 'Jd. Aquarius- Apto 75 m2 com 2 quartos(suite)+armários, coz.plan, sacada gourmet, 2 vg +lazer compl', 'xa8371', '1', '1', '', '<p>O apto no Parque Residencial Aquarius tem:<br />- 75 metros quadrados<br />- sala com sacada gourmet + cortina vidro<br />- 2 quartos sendo 1 suite + armários<br />- banheiros com box/gabinete<br />- academia<br />- playground<br />- salão de festas<br />- piscina<br />- quadra poliesportiva<br />- churrasqueira<br />- elevador</p>\r\n<p>- condominio de R$ 490,00 (sujeito à alteração sem aviso prévio)</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A8371 1.jpeg\",\"alt_text\":\"A8371 1.jpeg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/A8371 4.jpeg\",\"alt_text\":\"A8371 4.jpeg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/A8371 5.jpeg\",\"alt_text\":\"A8371 5.jpeg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/A8371 3.jpeg\",\"alt_text\":\"A8371 3.jpeg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/A8371 2.jpeg\",\"alt_text\":\"A8371 2.jpeg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/A8371 10.jpeg\",\"alt_text\":\"A8371 10.jpeg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/A8371 8.jpeg\",\"alt_text\":\"A8371 8.jpeg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/A8371 7.jpeg\",\"alt_text\":\"A8371 7.jpeg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/A8371 9.jpeg\",\"alt_text\":\"A8371 9.jpeg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/A8371 6.jpeg\",\"alt_text\":\"A8371 6.jpeg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/A8371 12.jpeg\",\"alt_text\":\"A8371 12.jpeg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/A8371 11.jpeg\",\"alt_text\":\"A8371 11.jpeg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/A8371 13.jpeg\",\"alt_text\":\"A8371 13.jpeg\"},\"gallery14\":{\"photo\":\"images\\/gallery\\/A8371 14.jpeg\",\"alt_text\":\"A8371 14.jpeg\"},\"gallery15\":{\"photo\":\"images\\/gallery\\/A8371 15.jpeg\",\"alt_text\":\"A8371 15.jpeg\"},\"gallery16\":{\"photo\":\"images\\/gal