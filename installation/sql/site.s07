('2168', 'A8281', 'Jardim São Judas Tadeu-Apto à venda com 55 m2, 2 quartos (1 st), 2 banhr, 1 vg grg cob, sacd, coz pl', 'xa8281', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">O apartamento está localizado no bairro Jardim São Judas Tadeu possui 55 m2 com:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 2 quartos sendo 1 suite. Armários planejados e  iluminação em Led</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- ⁠2 banheiros sendo 1 totalmente planejado (suíte) o outro equipado com box e iluminação em Led</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- ⁠varanda gourmet com churrasqueira, bancada e armários</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- ⁠cozinha planejada</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Área de serviço e sala conjugada</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- ⁠1 vaga de garagem coberta</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Portaria  das 8 às 17h</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Elevador </span></p>\r\n<p><span style=\"font-size: 12.16px;\">- salão de festas</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- playground</span></p>\r\n<p><span style=\"font-size: 12.16px;\">IPTU 2025: R$550,00</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Condomínio: R$460,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A8281 0.jpg\",\"alt_text\":\"A8281 0.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/A8281 0B.jpg\",\"alt_text\":\"A8281 0B.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/A8281 0A.jpg\",\"alt_text\":\"A8281 0A.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/A8281 18.jpeg\",\"alt_text\":\"A8281 18.jpeg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/A8281 32.jpeg\",\"alt_text\":\"A8281 32.jpeg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/A8281 31.jpeg\",\"alt_text\":\"A8281 31.jpeg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/A8281 23.jpeg\",\"alt_text\":\"A8281 23.jpeg\"},\"gal