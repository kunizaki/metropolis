('2302', 'C3794', 'Bosque dos Ipês- Casa venda, 80 m2 área constr, 3 quartos (1 suíte), 2 vagas garagem, área gourmt', 'xc3794', '7', '1', '', '<p>A casa no bairro Residencial Bosque dos Ipês tem 80 metros quadrados com:<br />- 3 dormitórios, sendo 1 suíte<br />- ⁠Cozinha americana com pé direito alto<br />- ⁠Casa completa com tabica<br />- ⁠Área gourmet com churrasqueira<br />- ⁠Portão automático <br />- ⁠Vaga para 2 carros <br />- ⁠150 m2 de terreno <br />- ⁠80 m2 de área construída<br /><br />5 min do supermercado Barbosa 24h <br />8 min do Shopping Oriente <br />Melhor localização do bairro</p>\r\n<p>IPTU 2025: R$845,00</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/1 3.jpeg\",\"alt_text\":\"1 3.jpeg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/1 7.jpeg\",\"alt_text\":\"1 7.jpeg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/1 1.jpeg\",\"alt_text\":\"1 1.jpeg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/1 6.jpeg\",\"alt_text\":\"1 6.jpeg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/1 4.jpeg\",\"alt_text\":\"1 4.jpeg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/1 5.jpeg\",\"alt_text\":\"1 5.jpeg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/1 10.jpeg\",\"alt_text\":\"1 10.jpeg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/1 9.jpeg\",\"alt_text\":\"1 9.jpeg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/1 11.jpeg\",\"alt_text\":\"1 11.jpeg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/1 2.jpeg\",\"alt_text\":\"1 2.jpeg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/1 8.jpeg\",\"alt_text\":\"1 8.jpeg\"}}', 'sell', '', '690000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Bosque dos Ipês', '0,0', '12236-871', '80', '3', '2', '2', '', '0', '[\"8\",\"12\",\"27\"]', '', '', '', '{}', '0', '*', '1', '0', '783', '2025-12-02 00:00:00', '783', '2025-12-08 10:58:54', '0', NULL),
('2303', 'A8350', 'Centro- Apto venda, 65 m2, 2 quartos+armário, 1 banheiro+box, 1 vaga garagem, cozinha+arm, sol manhã', 'xa8350', '1', '1', '', '<p>O apartamento no bairro Centro tem 65 metros quadrados com:<br />- 2 quartos com ventiladores e armários<br />- 1 banheiro com box e gabinete<br />- cozinha com geladeira, fogão, micro-ondas, sugar (exaustor), air fryer, torradeira<br />- sol da manhã</p>\r\n<p><br />Condomínio possui:<br />- salão de festas<br />- parquinho infantil<br />- elevador<br />- churrasqueira<br />Em frente a Casa do Idoso. Com todas as atividades (+60) grátis. Pilates, ginástica, hidromassagem, etc.<br />Próximo do comércio, UNIVAP, transporte público, parques, principais vias, etc.</p>\r\n<p>IPTU 2025: R$50,00 mensal</p>\r\n<p>Condomínio: R$731,00</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A8350 1.jpg\",\"alt_text\":\"A8350 1.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/A8350 4.jpg\",\"alt_text\":\"A8350 4.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/A8350 3.jpg\",\"alt_text\":\"A8350 3.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/A8350 2.jpg\",\"alt_text\":\"A8350 2.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/A8350 17.jpg\",\"alt_text\":\"A8350 17.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/A8350 16.jpg\",\"alt_text\":\"A8350 16.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/A8350 5.jpg\",\"alt_text\":\"A8350 5.jpg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/A8350 9.jpg\",\"alt_text\":\"A8350 9.jpg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/A8350 10.jpg\",\"alt_text\":\"A8350 10.jpg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/A8350 7.jpg\",\"alt_text\":\"A8350 7.jpg\"},\"gallery14\":{\"photo\":\"images\\/gallery\\/A8350 12.jpg\",\"alt_text\":\"A8350 12.jpg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/A8350 8.jpg\",\"alt_text\":\"A8350 8.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/A8350 6.jpg\",\"alt_text\":\"A8350 6.jpg\"},\"gallery13\":{\"photo