('2388', 'T1226', 'Urbanova/Terrras Alpha - Terreno de 330 m2, plano, lazer completo', 'xt1226', '6', '1', '', '<p>O terreno localizado no Urbanova Loteamento Terras Alpha tem:<br />- 330m2 de área<br />- plana<br />- rua com pouco movimento<br /><br />Área de lazer completa:<br />- academia<br />- espaço gourmet<br />- área verde de jardim<br />- parquinho com diferentes brinquedos<br />- salão de festas<br />- piscinas<br />- quadra poliesportiva<br />- churrasqueiras<br />- quadra de tênis<br />- área verde</p>', '', NULL, NULL, '{\"gallery4\":{\"photo\":\"images\\/gallery\\/T1226 3.jpg\",\"alt_text\":\"T1226 3.jpg\"},\"gallery1\":{\"photo\":\"images\\/gallery\\/T1226 1.jpg\",\"alt_text\":\"T1226 1.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/T1226 2.jpg\",\"alt_text\":\"T1226 2.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/T1226 4.jpg\",\"alt_text\":\"T1226 4.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/T1226 1.png\",\"alt_text\":\"T1226 1.png\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/T1226 6.jpg\",\"alt_text\":\"T1226 6.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/T1226 5.jpg\",\"alt_text\":\"T1226 5.jpg\"}}', 'sell', '', '750000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'SJCAMPOS', 'URBANOVA', '0,0', '12244169', '330', '0', '0', '0', '', '0', '[\"9\",\"12\",\"16\",\"21\",\"23\",\"26\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2026-05-04 00:00:00', '783', '2026-05-05 11:37:22', '0', NULL);/**ABDB**/
