('2295', 'C3792', 'Setville Altos de São José- Casa venda, 78 m2, 3 quartos (1 st), 2 banh, 3 vgs grg desc, sala+coz', 'xc3792', '7', '1', '', '<p>A casa térrea no bairro Setville Altos de São José com:<br />- 3 quartos sendo 1 suíte<br />- 2 banheiros (ambos banheiros com pia em granito e vaso sanitário monobloco)<br />- sala e cozinha em conceito aberto( cozinha com pia ampla em granito), - área de serviço externa com piso e revestimento<br />- garagem descoberta para 3 carros e portão automatizado<br />- Terreno 175m² , área construída 78m².</p>\r\n<p>IPTU 2025: R$450,00</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/C3792 1.jpg\",\"alt_text\":\"C3792 1.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/C3792 2.jpg\",\"alt_text\":\"C3792 2.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/C3792 3.jpg\",\"alt_text\":\"C3792 3.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/C3792 6.jpg\",\"alt_text\":\"C3792 6.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/C3792 4.jpg\",\"alt_text\":\"C3792 4.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/C3792 5.jpg\",\"alt_text\":\"C3792 5.jpg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/C3792 12.jpg\",\"alt_text\":\"C3792 12.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/C3792 7.jpg\",\"alt_text\":\"C3792 7.jpg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/C3792 9.jpg\",\"alt_text\":\"C3792 9.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/C3792 19.jpg\",\"alt_text\":\"C3792 19.jpg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/C3792 8.jpg\",\"alt_text\":\"C3792 8.jpg\"},\"gallery15\":{\"photo\":\"images\\/gallery\\/C3792 14.jpg\",\"alt_text\":\"C3792 14.jpg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/C3792 11.jpg\",\"alt_text\":\"C3792 11.jpg\"},\"gallery17\":{\"photo\":\"images\\/gallery\\/C3792 16.jpg\",\"alt_text\":\"C3792 16.jpg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/C3792 10.jpg\",\"alt_text\":\"C3792 10.jpg\"},\"gallery14\":{\"photo\":\"images\\/galler