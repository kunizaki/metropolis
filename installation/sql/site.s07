('2365', 'A8381', 'Jd. Satélite- Wonder Cidade Jardim- 85 m2 com 2 quartos(ste), sala estendida+varanda gourmet, 2 vgs', 'xa8381', '1', '1', '', '<p>O Apto no Jardim Satélite, Condominio Wonder Cidade Jardim tem:<br />- 85 metros quadrados de área útil<br />- 2 quartos sendo 1 suite<br />- sala estendida com varanda gourmet+lavabo<br />- cozinha americana<br />- quarto principal com closet<br />- janela com 2m de largura e espaço para cama king<br />- instalação para aquecedor a gás com água aquecida em todas as torneiras<br />- preparo para ar condicionado pronta<br />- piso em porcelanato<br />- possui hobby box no mesmo andar<br />- andar alto no vista livre<br />- condominio clube com piscina<br />- churrasqueira<br />- academia equipada<br />- sala de jogos<br />- área gourmet<br />- área de coworking<br />- possui 2 vagas de garagem cobertas<br />- apartamento novo<br />- aceita financiamento bancário<br />- área de fitness</p>\r\n<p>- condominio de R$ 400,00</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A8381 1.jpg\",\"alt_text\":\"A8381 1.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/A8381 3.jpg\",\"alt_text\":\"A8381 3.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/A8381 2.jpg\",\"alt_text\":\"A8381 2.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/A8381 4.jpg\",\"alt_text\":\"A8381 4.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/A8381 5.jpg\",\"alt_text\":\"A8381 5.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/A8381 6.jpg\",\"alt_text\":\"A8381 6.jpg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/A8381 9.jpg\",\"alt_text\":\"A8381 9.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/A8381 8.jpg\",\"alt_text\":\"A8381 8.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/A8381 7.jpg\",\"alt_text\":\"A8381 7.jpg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/A8381 10.jpg\",\"alt_text\":\"A8381 10.jpg\"}}', 'sell', '', '930000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'SJCampos', 'Jd. Satelite', '0,0