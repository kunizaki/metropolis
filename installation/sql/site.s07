('2311', 'T1220', 'Loteamento Floresta- Terreno à venda tem 260 m2, terreno plano, condomínio fechado, lazer completo', 'xt1220', '6', '1', '', '<p>O terreno está localizado no bairro Loteamento Floresta tem 260 metros terreno no condomínio Reserva Rudá<br />Características:<br />- Terreno plano<br />- Excelente terreno no Bairro Floresta, Condomínio fechado com 260 metros pronto para construir (13 metros de frente e 20 de comprimento)<br />- Documentação em dia;<br />Lazer completo:<br />-Salão de Festa<br />-Salão de Jogos <br />-Área de Churrasqueira<br />-Piscina <br />-Academia <br />-Quadra Poliesportiva<br />PORTARIA COM SEGURANÇA 24 HORAS</p>\r\n<p>Condomínio: R$400,00</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/T1220 1.jpeg\",\"alt_text\":\"T1220 1.jpeg\"},\"gallery2\":{\"photo\":\"images/gallery/T1220 1.jpg\",\"alt_text\":\"T1220 1.jpg\"},\"gallery3\":{\"photo\":\"images/gallery/T1220 3.jpg\",\"alt_text\":\"T1220 3.jpg\"},\"gallery5\":{\"photo\":\"images/gallery/T1220 2.jpg\",\"alt_text\":\"T1220 2.jpg\"},\"gallery6\":{\"photo\":\"images/gallery/T1220 3.jpeg\",\"alt_text\":\"T1220 3.jpeg\"},\"gallery4\":{\"photo\":\"images/gallery/T1220 2.jpeg\",\"alt_text\":\"T1220 2.jpeg\"},\"gallery8\":{\"photo\":\"images/gallery/T1220 5.jpeg\",\"alt_text\":\"T1220 5.jpeg\"},\"gallery7\":{\"photo\":\"images/gallery/T1220 4.jpeg\",\"alt_text\":\"T1220 4.jpeg\"},\"gallery9\":{\"photo\":\"images/gallery/T1220 6.jpeg\",\"alt_text\":\"T1220 6.jpeg\"},\"gallery10\":{\"photo\":\"images/gallery/T1220 7.jpeg\",\"alt_text\":\"T1220 7.jpeg\"}}', 'sell', '', '530000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Loteamento Floresta', '0,0', '12226392', '260', '0', '0', '0', '', '0', '[\"9\",\"12\",\"16\",\"21\",\"23\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2025-12-12 00:00:00', '783', '2025-12-12 13:33:15', '0', NULL),
