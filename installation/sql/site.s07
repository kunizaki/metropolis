('2352', 'C3809', 'Jd. Morumbi- Casa térrea de 160 m2 com 2 quartos(suite), duas salas, 2 cozinhas, edicula, 2 vgs gar', 'xc3809', '7', '1', '', '<p>Casa à Venda – Jardim Morumbi, São José dos Campos<br />Localização privilegiada em bairro já formado, com total infraestrutura: mercados, padaria na esquina, próximo ao shopping e com fácil acesso às principais vias da cidade.<br />Detalhes do imóvel:<br />Terreno amplo de 300m² (lote inteiro);<br />Imóvel dividido em duas casas, ideal para moradia + renda extra ou famílias que desejam viver próximas;<br />Casa 1:<br />1 quarto com suíte;<br />Sala ampla;<br />Cozinha funcional;<br />Escada para o andar superior com área de lazer;<br />Churrasqueira pré-moldada;<br />Nos fundos: edícula com 2 cômodos e 1 banheiro.<br /><br />Casa 2:<br />3 cômodos bem distribuídos;<br />1 banheiro.<br />Diferenciais:<br />Espaço versátil e bem aproveitado;<br />Ideal para quem busca conforto, lazer e praticidade;<br />Ótima opção para morar e ainda garantir uma renda extra com aluguel.<br /><br />São dois muros dividindo a casa, caso queira voltar a uma casa, só desfazer os muros e realocar colocar as portas</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/C3809 1.jpeg\",\"alt_text\":\"C3809 1.jpeg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/C3809 5.jpeg\",\"alt_text\":\"C3809 5.jpeg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/C3809 4.jpeg\",\"alt_text\":\"C3809 4.jpeg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/C3809 3.jpeg\",\"alt_text\":\"C3809 3.jpeg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/C3809 2.jpeg\",\"alt_text\":\"C3809 2.jpeg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/C3809 6.jpeg\",\"alt_text\":\"C3809 6.jpeg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/C3809 8.jpeg\",\"alt_text\":\"C3809 8.jpeg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/C3809 7.jpeg\",\"alt_text\":\"C3809 7.jpeg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/C3809 12.jpeg\",\"alt_text\":\"C3809 12.jpeg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/C3809 9.jpeg\",\"alt_text\":\"C3809 9.jpeg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/C3809 10.jpeg\",\"alt_text\":\"C3809 10.jpeg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/C3809 13.jpeg\",\"alt_text\":\"C3809 13.jpeg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/C3809 11.jpeg\",\"alt_text\":\"C3809 11.jpeg\"},\"gallery15\":{\"photo\":\"images\\/gallery\\/C3809 15.jpeg\",\"alt_text\":\"C3809 15.jpeg\"},\"gallery18\":{\"photo\":\"images\\/gallery\\/C3809 18.jpeg\",\"alt_text\":\"C3809 18.jpeg\"},\"gallery17\":{\"photo\":\"images\\/gallery\\/C3809 17.jpeg\",\"alt_text\":\"C3809 17.jpeg\"},\"gallery16\":{\"photo\":\"images\\/gallery\\/C3809 16.jpeg\",\"alt_text\":\"C3809 16.jpeg\"},\"gallery14\":{\"photo\":\"images\\/gallery\\/C3809 14.jpeg\",\"alt_text\":\"C3809 14.jpeg\"},\"gallery19\":{\"photo\":\"images\\/gallery\\/C3809 19.jpeg\",\"alt_text\":\"C3809 19.jpeg\"},\"gallery21\":{\"photo\":\"images\\/gallery\\/C3809 21.jpeg\",\"alt_text\":\"C3809 21.jpeg\"},\"gallery22\":{\"photo\":\"images\\/gallery\\/C3809 22.jpeg\",\"alt_text\":\"C3809 22.jpeg\"},\"gallery23\":{\"photo\":\"images\\/gallery\\/C3809 23.jpeg\",\"alt_text\":\"C3809 23.jpeg\"},\"gallery20\":{\"photo\":\"images\\/gallery\\/C3809 20.jpeg\",\"alt_text\":\"C3809 20.jpeg\"},\"gallery24\":{\"photo\":\"images\\/gallery\\/C3809 24.jpeg\",\"alt_text\":\"C3809 24.jpeg\"},\"gallery25\":{\"photo\":\"images\\/gallery\\/C3809 25.jpeg\",\"alt_text\":\"C3809 25.jpeg\"},\"gallery26\":{\"photo\":\"images\\/gallery\\/C3809 26.jpeg\",\"alt_text\":\"C3809 26.jpeg\"},\"gallery27\":{\"photo\":\"images\\/gallery\\/C3809 27.jpeg\",\"alt_text\":\"C3809 27.jpeg\"}}', 'sell', '', '750000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'SJCampos', '', '0,0', '12236-440', '160', '2', '3', '2', '', '0', NULL, '', '', '', '{}', '1', '*', '1', '0', '783', '2026-03-05 00:00:00', '783', '2026-03-05 17:23:18', '0', NULL),
('2353', 'A7318', 'Vila Adyana- Apto 120 m2 com 3 quartos(ste)+armários, coz.plan, banh.serviço, 1 vg, frente à praça', 'xa7318', '1', '1', '', '<p>O apto na Vila Adyana possui 120 m2 com:<br />- 3 quartos sendo 1 suite com armários <br />- banheiros com box<br />- ampla sala com frente livre e vista para a praça<br />- cozinha com sol da manhã<br />- espaço para festas<br />- elevador<br />- ótima localização com vários comércios na redondeza e feira livre</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A7318 0.JPG\",\"alt_text\":\"A7318 0.JPG\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/A7318 0B.jpg\",\"alt_text\":\"A7318 0B.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/A7318 0A.jpg\",\"alt_text\":\"A7318 0A.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/A7318 2.jpg\",\"alt_text\":\"A7318 2.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/A7318 3.jpeg\",\"alt_text\":\"A7318 3.jpeg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/A7318 1.jpg\",\"alt_text\":\"A7318 1.jpg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/A7318 4.jpeg\",\"alt_text\":\"A7318 4.jpeg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/A7318 2.jpeg\",\"alt_text\":\"A7318 2.jpeg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/A7318 1.jpeg\",\"alt_text\":\"A7318 1.jpeg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/A7318 9.jpeg\",\"alt_text\":\"A7318 9.jpeg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/A7318 10.jpeg\",\"alt_text\":\"A7318 10.jpeg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/A7318 8.jpeg\",\"alt_text\":\"A7318 8.jpeg\"},\"gallery14\":{\"photo\":\"images\\/gallery\\/A7318 11.jpeg\",\"alt_text\":\"A7318 11.jpeg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/A7318 7.jpeg\",\"alt_text\":\"A7318 7.jpeg\"},\"gallery16\":{\"photo\":\"images\\/gallery\\/A7318 4.jpg\",\"alt_text\":\"A7318 4.jpg\"},\"gallery19\":{\"photo\":\"images\\/gallery\\/A7318 12.jpeg\",\"alt_text\":\"A7318 12.jpeg\"},\"gallery18\":{\"photo\":\"images\\/gallery\\/A7318 6