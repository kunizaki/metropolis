('2307', 'M0029', 'Vila Adyana - Prédio coml- Antigo Restaurante Edo Zushi, área útil de 250 m2', 'xm0029', '3', '1', '', '<p>O prédio comercial na Vila Adyana tem 250 m2:<br />- Local do antigo restaurante Edo Zushi<br />- Prédio ideal para restaurantes e atividades afins devido a sua localização privilegiada, com múltiplas opções de gastronomia como padarias, bares, sorveterias, pizzarias, etc.<br />- próximo ao Parque Santos Dumont e Vicentina Aranha. </p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/M0029 3.jpg\",\"alt_text\":\"M0029 3.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/M0029 1.jpg\",\"alt_text\":\"M0029 1.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/M0029 2.jpg\",\"alt_text\":\"M0029 2.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/M0029 4.jpg\",\"alt_text\":\"M0029 4.jpg\"}}', 'rent', '', '12000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Vila Adyana', '0,0', '12243-690', '250', '0', '2', '0', '', '0', NULL, '', '', '', '{}', '1', '*', '1', '0', '783', '2025-12-06 00:00:00', '783', '2026-03-17 12:30:09', '0', NULL),
