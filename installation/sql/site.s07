('2306', 'C3795', 'Jd Colinas- Casa aluguel, 250 m2, 4 quartos(1 st), 4 vgs gargm, área gourmt, sala est+jant, coz+armr', 'xc3795', '7', '1', '', '<p>Detalhes do imóvel:<br />-4 dormitórios, sendo 1 suíte<br />-Sala de estar e jantar<br />-Cozinha com despensa<br />-Lavanderia<br />-Área gourmet com churrasqueira, quarto e banheiro<br />-Garagem para 4 carros<br /><br />Condomínio com lazer completo:<br />-Quadras de futebol, salão e tênis<br />-Pista de skate e pista de caminhada<br />-Parquinho infantil e pomar<br />-Jardim com peixes<br />-Feira livre e lojinha<br />-Academia e salão de festas</p>\r\n<p>IPTU 2025: R$200,00 mensal</p>\r\n<p>Condomínio: R$545,00</p>\r\n<p>Valores de condomínio sujeitos a alteração sem aviso prévio</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/C3795 1.jpeg\",\"alt_text\":\"C3795 1.jpeg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/C3795 2.jpeg\",\"alt_text\":\"C3795 2.jpeg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/C3795 3.jpeg\",\"alt_text\":\"C3795 3.jpeg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/C3795 4.jpeg\",\"alt_text\":\"C3795 4.jpeg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/C3795 9.jpeg\",\"alt_text\":\"C3795 9.jpeg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/C3795 6.jpeg\",\"alt_text\":\"C3795 6.jpeg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/C3795 8.jpeg\",\"alt_text\":\"C3795 8.jpeg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/C3795 5.jpeg\",\"alt_text\":\"C3795 5.jpeg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/C3795 7.jpeg\",\"alt_text\":\"C3795 7.jpeg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/C3795 30.jpeg\",\"alt_text\":\"C3795 30.jpeg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/C3795 10.jpeg\",\"alt_text\":\"C3795 10.jpeg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/C3795 11.jpeg\",\"alt_text\":\"C3795 11.jpeg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/C3795 12.jpeg\",\"alt_text\":\"C3795 12.jpeg\"},\"gallery20\":{\"photo\":\"images\\/gal