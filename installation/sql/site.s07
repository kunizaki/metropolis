('2277', 'C3785', 'Jd das Indústrias- Apto venda, 156 m2, 3 quartos(1st), 3 banh, 2 vgs grg cob, sala, coz+arm, quintal', 'xc3785', '7', '1', '', '<p>A casa no bairro Jardim das Indústrias possui:<br />- 156 m2 de área construída<br />- 125 m2 de terreno<br />- 3 quartos sendo 1 suíte<br />- 3 banheiros<br />- ampla sala<br />- copa<br />- cozinha com armários e área de serviço<br />- churrasqueira<br />- quintal<br />- garagem para 2 carros e portão automático<br />O imóvel está próximo a vários comércios como: padarias, feira livre,<br />farmácias, pet shop, mercados, escolas, lojas, salão de beleza, academia e fácil acesso a Dutra e as principais vias da cidade.</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/C3785 6.jpeg\",\"alt_text\":\"C3785 6.jpeg\"},\"gallery2\":{\"photo\":\"images/gallery/C3785 7.jpeg\",\"alt_text\":\"C3785 7.jpeg\"},\"gallery5\":{\"photo\":\"images/gallery/C3785 3.jpeg\",\"alt_text\":\"C3785 3.jpeg\"},\"gallery4\":{\"photo\":\"images/gallery/C3785 2.jpeg\",\"alt_text\":\"C3785 2.jpeg\"},\"gallery3\":{\"photo\":\"images/gallery/C3785 1.jpeg\",\"alt_text\":\"C3785 1.jpeg\"},\"gallery6\":{\"photo\":\"images/gallery/C3785 5.jpeg\",\"alt_text\":\"C3785 5.jpeg\"},\"gallery7\":{\"photo\":\"images/gallery/C3785 8.jpeg\",\"alt_text\":\"C3785 8.jpeg\"},\"gallery8\":{\"photo\":\"images/gallery/C3785 9.jpeg\",\"alt_text\":\"C3785 9.jpeg\"},\"gallery12\":{\"photo\":\"images/gallery/C3785 11.jpeg\",\"alt_text\":\"C3785 11.jpeg\"},\"gallery11\":{\"photo\":\"images/gallery/C3785 10.jpeg\",\"alt_text\":\"C3785 10.jpeg\"},\"gallery9\":{\"photo\":\"images/gallery/C3785 19.jpeg\",\"alt_text\":\"C3785 19.jpeg\"},\"gallery13\":{\"photo\":\"images/gallery/C3785 12.jpeg\",\"alt_text\":\"C3785 12.jpeg\"},\"gallery10\":{\"photo\":\"images/gallery/C3785 20.jpeg\",\"alt_text\":\"C3785 20.jpeg\"},\"gallery14\":{\"photo\":\"images/gallery/C3785 13.jpeg\",\"alt_text\":\"C3785 13.jpeg\"},\"gallery15\":{\"photo\":\"images/gallery/C3785 14.jpeg\",\"alt_tex