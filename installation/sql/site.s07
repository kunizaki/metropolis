('2363', 'A6383', 'Jd. São Dimas- Apto 75 m2 com 2 quartos(suite), coz.plan, 2 vgs, frente à Unesp', 'xa6383', '1', '1', '', '<p>O apto no Jardim São Dimas tem:<br />- 75 metros quadrados<br />- 2 quartos sendo uma suite<br />- sala com sacada<br />- piso em laminado de madeira<br />- banheiros com box<br />- espaço gourmet<br />- área de recreação infantil<br />- salão para festas<br />- piscina<br />- churrasqueira<br />- elevador<br />- em frente a Unesp e bem próximo ao Pq Santos Dumont<br /><br /><br />Obs.:<br />- taxa de água individualizado, cobrado no boleto de condominio: R$ 365,00/MÊS</p>\r\n<p>- taxa de condomínio sujeito à alteração sem aviso prévio</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A6383 1.JPG\",\"alt_text\":\"A6383 1.JPG\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/A6383 5.JPG\",\"alt_text\":\"A6383 5.JPG\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/A6383 4.JPG\",\"alt_text\":\"A6383 4.JPG\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/A6383 3.JPG\",\"alt_text\":\"A6383 3.JPG\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/A6383 2.JPG\",\"alt_text\":\"A6383 2.JPG\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/A6383 12.JPG\",\"alt_text\":\"A6383 12.JPG\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/A6383 8.JPG\",\"alt_text\":\"A6383 8.JPG\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/A6383 11.JPG\",\"alt_text\":\"A6383 11.JPG\"},\"gallery14\":{\"photo\":\"images\\/gallery\\/A6383 15.JPG\",\"alt_text\":\"A6383 15.JPG\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/A6383 13.JPG\",\"alt_text\":\"A6383 13.JPG\"},\"gallery15\":{\"photo\":\"images\\/gallery\\/A6383 16.JPG\",\"alt_text\":\"A6383 16.JPG\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/A6383 14.JPG\",\"alt_text\":\"A6383 14.JPG\"},\"gallery18\":{\"photo\":\"images\\/gallery\\/A6383 19.JPG\",\"alt_text\":\"A6383 19.JPG\"},\"gallery19\":{\"photo\":\"images\\/gallery\\/A6383 20.JPG\",\"alt_text\":\"A6383 20.JPG\"},\"gallery16\":{\"photo\":\"images\\