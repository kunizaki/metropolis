('2166', 'A8280', 'Parque Residencial Flamboyant- Apto à venda,52 m2, 2 quartos, 1 banhr, 1 vg grg cob, coz, sacd', 'xa8280', '1', '1', '', '<p><span style=\"font-size: 12.16px;\">O apartamento está localizado no bairro Parque Residencial Flamboyant tem 52 m2 com 2 quartos e 1 banheiro</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 02 dormitórios</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Sala</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Cozinha</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Área de Serviço</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Varanda</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 01 banheiro</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- 01 vaga de garagem coberta</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Com 52m²</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">Condomínio com lazer completo:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Piscina adulto e infantil</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Área gourmet com churrasqueira</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Pet place</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Playground</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- MiniGol</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Redário</span></p>\r\n<p><span style=\"font-size: 12.16px;\"> </span></p>\r\n<p><span style=\"font-size: 12.16px;\">Serviços:</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Três elevadores</span></p>\r\n<p><span style=\"font-size: 12.16px;\">- Controle de acesso e portaria 24 Horas</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Próximo à EMBRAER, Aeroporto, INPE, DCTA e Center Vale Shopping</span></p>\r\n<p><span style=\"font-size: 12.16px;\">Condomínio: R$380,00</span></p>\r\n<p><span style=\"font-size: 12.16px;\">IPTU: R$400,00</span></p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gall