('2382', 'C3815', 'Jd. Sta Rosa- casa térrea nova de 80 m2 com 3 quartos(suite), 2 vgs gar coberta, portão automático', 'xc3815', '7', '1', '', '<p>A casa térrea no Jardim Santa Rosa tem:<br />- Área do terreno:160m² (8x20)<br />- Área construída: 80m²<br />- 03 dormitórios, sendo 01 suíte<br />- 01 banheiro social<br />- 02 vagas de garagem (com sobra de espaço)<br />- Sala e cozinha integradas (3x12m)<br />- Cozinha com balcão americano (2,0 x 0,65m)– ideal para uso como mesa<br />- Piso interno em porcelanato<br />- Acabamento em gesso<br />- área de serviço sendo metade coberta<br />- Garagem totalmente coberta<br />- Portão automático (3,0 x 2,4m de altura)<br />- Piso externo todo em cerâmica<br />- Imóvel totalmente murado<br />- Sol da manhã e da tarde<br />- excelente ventilação interna e externa<br />- documentação 100% regularizada<br />- aceita permuta</p>\r\n<p>- IPTU R$ 379,00</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/C3815 1.jpeg\",\"alt_text\":\"C3815 1.jpeg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/C3815 3.jpeg\",\"alt_text\":\"C3815 3.jpeg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/C3815 4.jpeg\",\"alt_text\":\"C3815 4.jpeg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/C3815 2.jpeg\",\"alt_text\":\"C3815 2.jpeg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/C3815 7.jpeg\",\"alt_text\":\"C3815 7.jpeg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/C3815 8.jpeg\",\"alt_text\":\"C3815 8.jpeg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/C3815 5.jpeg\",\"alt_text\":\"C3815 5.jpeg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/C3815 6.jpeg\",\"alt_text\":\"C3815 6.jpeg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/C3815 10.jpeg\",\"alt_text\":\"C3815 10.jpeg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/C3815 9.jpeg\",\"alt_text\":\"C3815 9.jpeg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/C3815 13.jpeg\",\"alt_text\":\"C3815 13.jpeg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/C3815 14.jpeg\",\"a