('2359', 'C3810', 'Pq Industrial- casa de 220 m2 com 4 quartos(suite), 2 salas comerciais na frente, 5 vgs gar', 'xc3810', '7', '1', '', '<p>A casa no Parque Industrial com 220 metros quadrados tem:<br /><br />- 4 quartos sendo 1 suite<br />- cozinha americana<br />- 2 salas<br />- 1 banheiro social<br />- terreno 300m2<br />- Garagem para 5 carros,<br />- 2 salas comerciais na frente com entrada independente com sala de espera e banheiro .</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/C3810 1.jpeg\",\"alt_text\":\"C3810 1.jpeg\"},\"gallery3\":{\"photo\":\"images/gallery/C3810 2.jpeg\",\"alt_text\":\"C3810 2.jpeg\"},\"gallery4\":{\"photo\":\"images/gallery/C3810 3.jpeg\",\"alt_text\":\"C3810 3.jpeg\"},\"gallery2\":{\"photo\":\"images/gallery/C3810 6.jpeg\",\"alt_text\":\"C3810 6.jpeg\"},\"gallery5\":{\"photo\":\"images/gallery/C3810 4.jpeg\",\"alt_text\":\"C3810 4.jpeg\"},\"gallery6\":{\"photo\":\"images/gallery/C3810 5.jpeg\",\"alt_text\":\"C3810 5.jpeg\"}}', 'rent', '', '790000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'SJCampos', 'Pq Industrail', '0,0', '12235-580', '300', '4', '3', '5', '', '0', NULL, '', '', '', '{}', '1', '*', '1', '0', '783', '2026-03-16 00:00:00', '783', '2026-03-16 23:19:21', '0', NULL),
('2360', 'C3812', 'Caraguá- casa térrea de 57 m2 com 1 quarto, sala/cozinha, banheiro e 1 vaga garagem', 'xc3812', '7', '1', '', '<p>A casa térrea no Balneário dos Golfinhos possui:<br />- 57 metros quadrados de área construída<br />- sala/cozinha<br />- banheiro<br />- churrasqueira<br />- 2 vagas de garagem<br />- aceita permuta e financiamento</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/C3812 1.jpeg\",\"alt_text\":\"C3812 1.jpeg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/C3812 15.jpeg\",\"alt_text\":\"C3812 15.jpeg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/C3812 13.jpeg\",\"alt_text\":\"C3812 13.jpeg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/C3812 10.jpeg\",\"alt_text\":\"C3812 10.jpeg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/C3812 11.jpeg\",\"alt_text\":\"C3812 11.jpeg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/C3812 7.jpeg\",\"alt_text\":\"C3812 7.jpeg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/C3812 4.jpeg\",\"alt_text\":\"C3812 4.jpeg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/C3812 9.jpeg\",\"alt_text\":\"C3812 9.jpeg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/C3812 8.jpeg\",\"alt_text\":\"C3812 8.jpeg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/C3812 6.jpeg\",\"alt_text\":\"C3812 6.jpeg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/C3812 5.jpeg\",\"alt_text\":\"C3812 5.jpeg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/C3812 14.jpeg\",\"alt_text\":\"C3812 14.jpeg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/C3812 3.jpeg\",\"alt_text\":\"C3812 3.jpeg\"}}', 'sell', '', '270000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'SJCAMPOS', '', '0,0', '11666-790', '57', '1', '1', '2', '', '0', '[\"8\",\"12\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2026-03-16 00:00:00', '783', '2026-03-16 23:24:13', '0', NULL),
('2361', 'R0062', 'Sapucaí-Mirim- Haras de 57.300m2 com casa sede de 2 suites180m2,  estrutura p/ cavalos, casa caseiro', 'sapucai-mirim-haras-de-57-300m2-com-casa-sede-de-2-suites180m2-estrutura-p-cavalos-casa-caseiro', '4', '1', '', '<p>Uma oportunidade única para quem busca qualidade de vida, estrutura para criação de cavalos e contato com a natureza, em um dos cenários mais belos da Serra da Mantiqueira, no município de Sapucaí-Mirim.<br />-Localizado entre montanhas, com clima agradável, paisagens deslumbrantes e excelente potencial para haras, criação, lazer ou turismo rural.<br />-Apenas 60 km de São José dos Campos – SP.</p>\r\n<p><br />* Área total: 57.270 m²<br />* Duas nascentes dentro da propriedade<br />* Apenas 1% de área de APA<br />* 9 piquetes formados em Tifton<br />* Pastagens formadas em Tanzânia e Angolão<br /><br />Estrutura para Cavalos<br />* Pavilhão de baias completo<br /> • 4 baias fechadas (4x4 m) com porta e janela<br /> • 4 baias abertas (4x4 m) com porta de 1,6 m<br /> • Todas com bebedouro e cocho em alvenaria<br /><br />* No pavilhão:<br /> • Escritório<br /> • Selaria<br /> • Farmácia veterinária<br /> • Banheiro<br /><br />* Estruturas adicionais:<br /> • Baia de banho<br /> • Quarto de ração e ferramentas (4 m²)<br /> • Picadeira bovina 3800W trifásica<br /> • Redondel de 7 m de diâmetro<br /> • Baia 5x4 m com acesso a piquete privativo<br /><br />* Lanchonete com 5 baias semi abertas<br /><br />Casas<br /><br />Casa Sede – 180 m² (térrea)<br />* Varanda ampla de 60 m² com churrasqueira<br />* 2 suítes + 1 quarto<br />* Banheiro social<br />* Sala com 2 ambientes e lareira<br /><br />Casa de Caseiro – 49 m²<br />* 1 quarto<br />* Sala e cozinha integradas<br />* Varanda<br />* Garagem com quartinho<br /><br />Outras Estruturas<br /><br />* Canil<br />* Caixa d’água de 10.000 litros abastecendo toda a propriedade<br />* Caixa d’água de 5.000 litros exclusiva para a casa sede<br /><br />- Propriedade perfeita para quem deseja haras, criação de cavalos, descanso ou investimento rural, em uma região muito valorizada da Mantiqueira.<br /><br />- Área total to sitio 57.270 m2 duas nascentes 1% somente de área de APA 9 piquetes formados em tifton  , pasto para cima Tanzânia, angolao e braquiaria que invadiu do vizinho. Uma casa caseiro 49 m2 1 quarto sala e cozinha juntos varanda e garagem com quartinho. Canil de 3 m2.<br /><br />- Pavilhão de baias com 4 baias fechadas porta e janela com 4 x4 m bebedouro e cocho em alvenaria + 4 baias abertas porta de 1,6 m também 4x4 m com bebedouro e coho em alvenaria. No pavilhão escritório com banheiro e selaria + farmácia<br /><br />- Quarto de ração e ferramenta 4 m2 picadeiro bovina 3800w trifásica  baia de banho<br />- Lanchonete com 5 baias semi abertas em morro e réguas e portas independentes<br /><br />- Baia para baixo da estrada de 5x4 m com acesso a piquete privativo  redondel de 7 m de diâmetro<br /><br />- Casa sede 180 m2 térrea com churrasqueira e varanda de 60 m2. 2 suítes + 1 quarto + banheiro. Sala 2 ambientes com lareira e porta de varanda cozinha com dispensa de 1m2 e área de serviço com pia de mármore e tanque<br /><br />- Agua de poço artesiano testada 100% potável ph 7.4<br /><br />- Caixa dagua 10 mil litros que serve todas as benfeitorias + casa caseiro e uma caixa d\'água 5 mil litros somente para sede</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/R0062 1.jpeg\",\"alt_text\":\"R0062 1.jpeg\"},\"gallery14\":{\"photo\":\"images\\/gallery\\/R0062 14.jpeg\",\"alt_text\":\"R0062 14.jpeg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/R0062 12.jpeg\",\"alt_text\":\"R0062 12.jpeg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/R0062 11.jpeg\",\"alt_text\":\"R0062 11.jpeg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/R0062 13.jpeg\",\"alt_text\":\"R0062 13.jpeg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/R0062 7.jpeg\",\"alt_text\":\"R0062 7.jpeg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/R0062 6.jpeg\",\"alt_text\":\"R0062 6.jpeg\"},\"gallery15\":{\"photo\":\"images\\/gallery\\/R0062 15.jpeg\",\"alt_text\":\"R0062 15.jpeg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/R0062 10.jpeg\",\"alt_text\":\"R0062 10.jpeg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/R0062 4.jpeg\",\"alt_text\":\"R0062 4.jpeg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/R0062 9.jpeg\",\"alt_text\":\"R0062 9.jpeg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/R0062 5.jpeg\",\"alt_text\":\"R0062 5.jpeg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/R0062 2.jpeg\",\"alt_text\":\"R0062 2.jpeg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/R0062 8.jpeg\",\"alt_text\":\"R0062 8.jpeg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/R0062 3.jpeg\",\"alt_text\":\"R0062 3.jpeg\"}}', 'sell', '', '1600000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'Sapucaí-Mirim', '', '-22.798933,-45.853089', '37690000', '57270', '2', '2', '10', '', '0', '[\"8\",\"12\",\"27\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2026-03-13 00:00:00', '783', '2026-03-17 12:24:24', '0', NULL),
('2362', 'R0061', 'São Fco Xavier- Chácara de 20.000 m2 com casa de 3quartos(suite), varanda, piscina e plantação', 'xr0061', '4', '1', '', '<p>Chácara de 20.000,00 na Estrada Guirra, próximo a São Francisco Xavier:<br />- Ideal para morar, investir ou produzir no campo<br />- Uma excelente oportunidade para quem busca qualidade de vida, natureza e renda no campo<br />- Propriedade completa, produtiva e com escritura definitiva.<br />-Localização estratégica  <br />- A 30 km de São José dos Campos  <br />- A 35 km antes de São Francisco Xavier  <br />- Estrada do Guirra (sem saída) – região segura, tranquila e com muita natureza.<br />- Área Total: 20.000 m² (2 hectares)  <br />- Água de mina  <br />- Energia elétrica  <br />- Aquecimento solar  <br />- Água quente na casa toda<br />- Casa Sede – 140 m²  <br />- 3 dormitórios (1 suíte)  <br />- Sala e cozinha integradas  <br />- Banheiro social  <br />- 2 varandas com vista para o verde  <br />- Piscina aquecida  <br />- Tanque externo  <br />- Área Produtiva – pronta para gerar renda  <br />- 10.000 m² de pasto  <br />- 10.000 m² de plantação com:  <br />- 1.200 pés de pitaya  <br />- 1.300 pés de café arábica  <br />- 25 pés de laranja e limão Taiti  <br />- 450 pés de eucalipto (vermelho e rosa)  <br />- Plantação de mandioca</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/R0061 1.jpeg\",\"alt_text\":\"R0061 1.jpeg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/R0061 5.jpeg\",\"alt_text\":\"R0061 5.jpeg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/R0061 6.jpeg\",\"alt_text\":\"R0061 6.jpeg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/R0061 3.jpeg\",\"alt_text\":\"R0061 3.jpeg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/R0061 4.jpeg\",\"alt_text\":\"R0061 4.jpeg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/R0061 2.jpeg\",\"alt_text\":\"R0061 2.jpeg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/R0061 7.jpeg\",\"alt_text\":\"R0061 7.jpeg\"},\"gallery10\":{\"photo\":\"images\\/gal