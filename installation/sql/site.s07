('2356', 'A8379', 'Pq Industrial- Ap 78 m2 com 3 quartos+armários, coz.plan, 2 vgs gar', 'xa8379', '1', '1', '', '<p>O apto no Parque Industrial tem:<br />- 78 metros quadrados com 3 quartos<br />- sala com sacada<br />- cozinha planejada<br />- banheiros com box/gabinete<br />-- possui parquinho<br />- festas e eventos<br />- piscina<br />- churrasqueira<br />- elevador</p>\r\n<p>- condominio de R$ 450,00</p>\r\n<p>- iptu 2026 de R$ 1.300,00/ano</p>', '', NULL, NULL, '{\"gallery3\":{\"photo\":\"images\\/gallery\\/A8379 3.jpeg\",\"alt_text\":\"A8379 3.jpeg\"},\"gallery1\":{\"photo\":\"images\\/gallery\\/A8379 1.jpeg\",\"alt_text\":\"A8379 1.jpeg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/A8379 2.jpeg\",\"alt_text\":\"A8379 2.jpeg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/A8379 7.jpeg\",\"alt_text\":\"A8379 7.jpeg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/A8379 3.jpeg\",\"alt_text\":\"A8379 3.jpeg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/A8379 5.jpeg\",\"alt_text\":\"A8379 5.jpeg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/A8379 4.jpeg\",\"alt_text\":\"A8379 4.jpeg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/A8379 6.jpeg\",\"alt_text\":\"A8379 6.jpeg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/A8379 8.jpeg\",\"alt_text\":\"A8379 8.jpeg\"}}', 'sell', '', '745000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'SJCampos', '', '0,0', '12235-649', '78', '3', '2', '2', '', '0', '[\"8\",\"9\",\"12\",\"16\",\"17\",\"21\",\"22\",\"27\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2026-03-13 00:00:00', '783', '2026-03-23 11:44:41', '0', NULL),
('2357', 'A8378', 'Pq Industrial- Apto 75 m2 com 3 quartos(ste), sac gournet, coz.plan, 2 vgs gar', 'xa8378', '1', '1', '', '<p>O apto no Pq Industrial tem 75 m2 com:<br />- 3 quartos sendo 1 suite + armários<br />- sala com varanda gourmet<br />- cozinha planejada<br />- banheiros com box/gabinete<br />- 2 vgs garagem<br />- área de fitness<br />- área de recreação infantil<br />- salão para festas<br />- piscina<br />- quadra poliesportiva<br />- churrasqueira<br />- elevador<br />- sem permuta</p>\r\n<p>- condominio de R$ 460,00</p>\r\n<p>- iptu 2026 de R$ 1.500,00</p>', '', NULL, NULL, '{\"gallery3\":{\"photo\":\"images\\/gallery\\/A8378 3.jpeg\",\"alt_text\":\"A8378 3.jpeg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/A8378 2.jpeg\",\"alt_text\":\"A8378 2.jpeg\"},\"gallery1\":{\"photo\":\"images\\/gallery\\/A8378 1.jpeg\",\"alt_text\":\"A8378 1.jpeg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/A8378 6.jpeg\",\"alt_text\":\"A8378 6.jpeg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/A8378 4.jpeg\",\"alt_text\":\"A8378 4.jpeg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/A8378 7.jpeg\",\"alt_text\":\"A8378 7.jpeg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/A8378 5.jpeg\",\"alt_text\":\"A8378 5.jpeg\"},\"gallery16\":{\"photo\":\"images\\/gallery\\/A8378 16.jpeg\",\"alt_text\":\"A8378 16.jpeg\"},\"gallery17\":{\"photo\":\"images\\/gallery\\/A8378 17.jpeg\",\"alt_text\":\"A8378 17.jpeg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/A8378 13.jpeg\",\"alt_text\":\"A8378 13.jpeg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/A8378 12.jpeg\",\"alt_text\":\"A8378 12.jpeg\"},\"gallery14\":{\"photo\":\"images\\/gallery\\/A8378 14.jpeg\",\"alt_text\":\"A8378 14.jpeg\"},\"gallery19\":{\"photo\":\"images\\/gallery\\/A8378 19.jpeg\",\"alt_text\":\"A8378 19.jpeg\"},\"gallery15\":{\"photo\":\"images\\/gallery\\/A8378 15.jpeg\",\"alt_text\":\"A8378 15.jpeg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/A8378 11.jpeg\",\"alt_text\":\"A8378 11.jpeg\"},\"gallery9\"