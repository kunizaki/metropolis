('2287', 'C3790', 'Colinas do Paratehy-Casa venda, 276 m2, 3 quartos (3 st), 4 banh, 2 vgs grg cob, área gourmt, coz am', 'xc3790', '7', '1', '', '<p>A casa está localizada no bairro Condomínio Residencial Colinas do Paratehy com:<br />- 276 m2 de área construída<br />- 601 m2 de área de terreno<br />Está em construção com previsão de entrega: Agosto de 2026<br />- 3 suítes completas, todas com closet, sendo a suíte master com banheira;<br />- Todas as suítes possuem porta balcão com acesso ao jardim;<br />- Quarto adicional, podendo ser utilizado como home office, home theater, opção reversível para mais uma suíte;<br />- Banheiro social com chuveiro;<br />- Sala de estar, sala de jantar e cozinha americana, integrados, com pé direito duplo;<br />- Despensa;<br />- Lavanderia;<br />- Área gourmet com churrasqueira,<br />- Banheiro completo para uso da área gourmet<br />- Piscina de alvenaria;<br />- Garagem coberta para 2 carros e descoberta para 2 carros;<br />- 2 Hobby box<br />- Fachada ampla, com arquitetura moderna.<br /><br />Condomínio conta com playground, quadra, academia, salão de festas e sauna;<br />- Segurança total 24h.</p>\r\n<p>Condomínio: R$460,00</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images/gallery/C3790 1.jpg\",\"alt_text\":\"C3790 1.jpg\"},\"gallery2\":{\"photo\":\"images/gallery/C3790 2.jpg\",\"alt_text\":\"C3790 2.jpg\"},\"gallery4\":{\"photo\":\"images/gallery/C3790 5.jpg\",\"alt_text\":\"C3790 5.jpg\"},\"gallery3\":{\"photo\":\"images/gallery/C3790 4.jpg\",\"alt_text\":\"C3790 4.jpg\"},\"gallery5\":{\"photo\":\"images/gallery/C3790 3.jpg\",\"alt_text\":\"C3790 3.jpg\"}}', 'sell', '', '3139000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Residencial Colinas do Paratehy', '0,0', '12244-192', '276', '3', '5', '2', '', '0', '[\"8\",\"9\",\"12\",\"16\",\"21\",\"23\",\"25\",\"27\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2025-11-03 00:00:00', '783', '2025-11-04 13:11:03', '0', NULL),
('2289', 'A8344', 'Jd Indústrias- Apto venda, 50 m2, 2 quartos, 1 banh+box, 1 vga garagem, sala', 'xa8344', '1', '1', '', '<p>O apartamento no bairro Jardim das Indústrias com 50 metros quadrados com:<br />- 2 quartos<br />- 1 banheiro<br />- 1 vaga de garagem<br />- sala<br />- área de serviço<br />Condomínio possui salão de festas e portaria 24h.</p>\r\n<p>Condomínio: R$190,00</p>', '', NULL, NULL, '{\"gallery7\":{\"photo\":\"images\\/gallery\\/A8344 1.jpg\",\"alt_text\":\"A8344 1.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/A8344 2.jpg\",\"alt_text\":\"A8344 2.jpg\"},\"gallery13\":{\"photo\":\"images\\/gallery\\/A8344 5.jpeg\",\"alt_text\":\"A8344 5.jpeg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/A8344 6.jpeg\",\"alt_text\":\"A8344 6.jpeg\"},\"gallery11\":{\"photo\":\"images\\/gallery\\/A8344 3.jpeg\",\"alt_text\":\"A8344 3.jpeg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/A8344 4.jpeg\",\"alt_text\":\"A8344 4.jpeg\"},\"gallery10\":{\"photo\":\"images\\/gallery\\/A8344 2a.jpeg\",\"alt_text\":\"A8344 2a.jpeg\"},\"gallery14\":{\"photo\":\"images\\/gallery\\/A8344 9.jpeg\",\"alt_text\":\"A8344 9.jpeg\"},\"gallery15\":{\"photo\":\"images\\/gallery\\/A8344 8.jpeg\",\"alt_text\":\"A8344 8.jpeg\"}}', 'sell', '', '215000.00', '', '', 'BRL:R$', '1', 'show', '12', 'BR', 'São José dos Campos', 'Jardim das Indústrias', '0,0', '12241-040', '50', '2', '1', '1', '', '0', '[\"8\",\"16\"]', '', '', '', '{}', '1', '*', '1', '0', '783', '2025-11-02 00:00:00', '783', '2025-11-05 17:15:18', '0', NULL),
('2290', 'A8345', 'Jd Indústrias- Apto venda, 122 m2, 3 quartos (1 st), 2 banh, sala+área gourmt, coz planj, 2 vgs grg', 'xa8345', '1', '1', '', '<p>O apartamento no bairro Jardim das Indústrias tem 122 metros quadrados com:<br />- 3 quartos sendo 1 suíte<br />- 2 banheiros<br />- Sala integrada com área gourmet<br />- Piso em porcelanato em todos os ambientes<br />- Cozinha com despensa e armários planejados<br />- Armários planejados em toda a casa<br />- Lavabo moderno<br />- Área de serviço prática e funcional<br />- 2 vagas de garagem<br />- Ar-condicionado instalado<br />- Vista privilegiada para o interior do condomínio<br />Um imóvel completo, confortável e com acabamento de alto padrão!<br />Localização excelente, condomínio tranquilo e bem estruturado.<br />Condomínio possui:<br />- espaço para festas<br />- playground<br />- espaço gourmet<br />- academia<br />- piscina<br />- quadra poliesportiva<br />- churrasqueira<br />- elevador</p>\r\n<p>Condomínio: R$900,00</p>', '', NULL, NULL, '{\"gallery1\":{\"photo\":\"images\\/gallery\\/A8345 1.jpg\",\"alt_text\":\"A8345 1.jpg\"},\"gallery2\":{\"photo\":\"images\\/gallery\\/A8345 2.jpg\",\"alt_text\":\"A8345 2.jpg\"},\"gallery3\":{\"photo\":\"images\\/gallery\\/A8345 3.jpg\",\"alt_text\":\"A8345 3.jpg\"},\"gallery6\":{\"photo\":\"images\\/gallery\\/A8345 7.jpg\",\"alt_text\":\"A8345 7.jpg\"},\"gallery4\":{\"photo\":\"images\\/gallery\\/A8345 6.jpg\",\"alt_text\":\"A8345 6.jpg\"},\"gallery5\":{\"photo\":\"images\\/gallery\\/A8345 8.jpg\",\"alt_text\":\"A8345 8.jpg\"},\"gallery9\":{\"photo\":\"images\\/gallery\\/A8345 10.jpg\",\"alt_text\":\"A8345 10.jpg\"},\"gallery8\":{\"photo\":\"images\\/gallery\\/A8345 9.jpg\",\"alt_text\":\"A8345 9.jpg\"},\"gallery7\":{\"photo\":\"images\\/gallery\\/A8345 11.jpg\",\"alt_text\":\"A8345 11.jpg\"},\"gallery12\":{\"photo\":\"images\\/gallery\\/A8345 13.jpg\",\"alt_text\":\"A8345 13.jpg\"},\"gallery14\":{\"photo\":\"images\\/gallery\\/A8345 15.jpg\",\"alt_text\":\"A8345 15.jpg\